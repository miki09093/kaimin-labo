const faqs = [
  { q: '敷布団とマットレスの違いは何ですか？', a: '敷布団は床（畳・フローリング）に直接敷くことを前提とした、薄く軽量で上げ下ろし・収納がしやすい寝具です。マットレスは厚みがありベッドフレーム上で使うのが基本。和室派・収納派は敷布団、ベッド派はマットレスが基本の選び方です。' },
  { q: '敷布団に最適な厚みは何cmですか？', a: 'フローリング直敷きなら底つき感を防ぐため10cm以上、できれば15cm前後がおすすめです。畳の上ならクッション性があるため8cm前後でも問題ありません。雲のやすらぎの17cmは底つき感ゼロ・腰痛対策には十分な厚みです。' },
  { q: '高反発と低反発、どちらを選ぶべき？', a: '腰痛持ち・体重60kg以上の方は高反発（150N以上）を推奨します。沈み込みすぎず寝返りが打ちやすいため腰への負担を減らせます。低反発は包まれる寝心地が好きな方向きですが、腰が沈み込みやすく腰痛持ちには不向きです。' },
  { q: '敷布団のお手入れ頻度は？', a: '週1回は陰干しまたは天日干し、月1回はカバー洗濯が目安です。ウレタン素材は天日に長時間当てるとへたるため陰干し中心が基本。エアファイバー・TPE系は本体を水洗いできる商品もあります。' },
  { q: '敷布団の寿命はどれくらいですか？', a: '素材によりますが、ウレタン系で5〜10年、わた系で3〜5年が目安です。明らかなヘタリ・カビ・ニオイが出てきたら買い替えのサイン。雲のやすらぎは「上下入れ替え」で長持ちさせる設計です。' },
  { q: '返金保証付きの敷布団はどれですか？', a: '雲のやすらぎプレミアム（100日）、モットン（90日）、エアウィーヴ（30日）が代表的です。「合わなかったら返金できる」という保証は、ネット通販で買う際の最大の安心材料となります。' },
];
---
<Layout
  title="敷布団おすすめランキング2026｜腰痛・底つき感対策で徹底比較"
  description="腰痛・底つき感に効く敷布団5商品を徹底比較。雲のやすらぎ・エアウィーヴ・西川ムアツなど人気敷布団を、寝心地・体圧分散・厚み・通気性・お手入れ・価格の6軸で30点満点採点しました。"
>
  <Header />
  <main>

    <!-- ===== パンくず ===== -->
    <div class="page-header">
      <div class="container">
        <Breadcrumb items={[{ label: '敷布団' }]} />
      </div>
    </div>

    <!-- ===== HERO ===== -->
    <section class="hero-section">
      <a href="#top3">
        <img src="/images/futon-hero.png" alt="腰痛・底つき感に効く敷布団を徹底比較" class="hero-img" loading="eager" fetchpriority="high" />
      </a>
    </section>

    <!-- ===== TOP3 ===== -->
    <section class="section" id="top3">
      <div class="container">
        <h2 class="section-title">腰痛・底つき感対策に効く 敷布団TOP3</h2>
        <p style="margin-bottom: 1.5rem;">「朝起きると腰が痛い」「フローリングで底つき感がある」――そんな悩みに応える3枚を、編集部が厳選しました。</p>
        <div class="top3-list">
          {products.slice(0, 3).map(p => (
            <div class="top3-card">
              <div class="top3-header">
                <span class={`rank-circle rank-circle-${p.rank}`}>{p.rank}</span>
                <p class="top3-name">{p.name}</p>
              </div>
              <img src={`/images/${p.rank === 1 ? 'kumo-futon' : p.rank === 2 ? 'airweave-futon' : 'nishikawa-futon'}-card.png`} alt={p.name} class="top3-img" loading="lazy" />
              <div class="top3-score-row">
                <span class="top3-score">{p.score.toFixed(1)}</span>
                <span class="top3-score-max">/ 30点</span>
              </div>
              <p class="top3-price">{p.price}</p>
              <ul class="top3-tags">
                {p.tags.map(tag => <li>#{tag}</li>)}
              </ul>
              <p class="top3-summary">{p.summary}</p>
              <div class="top3-cta-row">
                <a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="top3-cta-btn">
                  公式サイトを見る →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== 敷布団選びで失敗しない6つのポイント ===== -->
    <section class="section pillow-guide-section">
      <div class="container">
        <h2 class="section-title">敷布団選びで失敗しない6つのポイント</h2>
        <p class="pillow-guide-lead">敷布団選びで失敗しないために押さえるべき6つのポイント。当サイトはこの6項目を5点満点・合計30点で採点しています。</p>

        <div class="pillow-guide-grid">
          <!-- ① 寝心地（硬さ・反発力） -->
          <div class="pillow-guide-card">
            <div class="pillow-guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="pillow-guide-svg">
                <rect x="6" y="28" width="44" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M10 32 Q14 26 18 32 Q22 26 26 32 Q30 26 34 32 Q38 26 42 32 Q46 26 50 32" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" fill="none"/>
                <path d="M28 8 L28 24 M22 18 L28 24 L34 18" stroke="#C9A84C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
            <p class="pillow-guide-num">①</p>
            <h3 class="pillow-guide-title">寝心地（硬さ・反発力）</h3>
            <p class="pillow-guide-text">敷布団の硬さは「N値（ニュートン）」で表現されます。腰痛持ち・体重が重い方は150N以上の高反発を選ぶと、沈み込みすぎず寝返りが楽です。</p>
            <div class="pillow-guide-check">
              <p class="pillow-guide-check-title">見極め方</p>
              <ul>
                <li>110N以下＝やわらかめ／110〜150N＝ふつう／150N以上＝硬め</li>
                <li>腰痛持ち・大柄な方は高反発（150N以上）</li>
                <li>体格や寝姿勢に合った硬さを選ぶ</li>
              </ul>
            </div>
          </div>

          <!-- ② 体圧分散性 -->
          <div class="pillow-guide-card">
            <div class="pillow-guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="pillow-guide-svg">
                <rect x="6" y="30" width="44" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <circle cx="12" cy="37" r="2" fill="#C9A84C"/>
                <circle cx="20" cy="37" r="2" fill="#C9A84C"/>
                <circle cx="28" cy="37" r="2" fill="#C9A84C"/>
                <circle cx="36" cy="37" r="2" fill="#C9A84C"/>
                <circle cx="44" cy="37" r="2" fill="#C9A84C"/>
                <path d="M16 24 Q22 18 28 22 Q34 18 40 24" stroke="#1B3A5C" stroke-width="2" stroke-linecap="round" fill="none"/>
                <circle cx="28" cy="14" r="4" fill="#1B3A5C" opacity="0.3"/>
              </svg>
            </div>
            <p class="pillow-guide-num">②</p>
            <h3 class="pillow-guide-title">体圧分散性</h3>
            <p class="pillow-guide-text">体の凹凸に沿って圧を分散する能力。腰やお尻に圧が集中すると痛みや血行不良の原因に。凹凸構造（点で支える）やゾーニング設計が効果的です。</p>
            <div class="pillow-guide-check">
              <p class="pillow-guide-check-title">見極め方</p>
              <ul>
                <li>凹凸プロファイル構造になっている</li>
                <li>ゾーン別（肩・腰など）に硬さを変えている</li>
                <li>仰向け・横向きで均一に支えられる</li>
              </ul>
            </div>
          </div>

          <!-- ③ 厚み -->
          <div class="pillow-guide-card">
            <div class="pillow-guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="pillow-guide-svg">
                <rect x="10" y="24" width="36" height="20" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M4 24 L4 44 M2 26 L4 24 L6 26 M2 42 L4 44 L6 42" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <text x="48" y="36" font-size="10" font-weight="700" fill="#1B3A5C">cm</text>
              </svg>
            </div>
            <p class="pillow-guide-num">③</p>
            <h3 class="pillow-guide-title">厚み（底つき感）</h3>
            <p class="pillow-guide-text">フローリングに直接敷くなら10cm以上、できれば15cm前後が理想。畳の上なら8cm前後でも問題ありません。薄すぎると底つき感で腰を痛める原因に。</p>
            <div class="pillow-guide-check">
              <p class="pillow-guide-check-title">見極め方</p>
              <ul>
                <li>フローリング＝10cm以上推奨</li>
                <li>畳＝8cm前後でもOK</li>
                <li>底つき感を感じたら買い替えサイン</li>
              </ul>
            </div>
          </div>

          <!-- ④ 通気性・吸湿性 -->
          <div class="pillow-guide-card">
            <div class="pillow-guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="pillow-guide-svg">
                <rect x="8" y="30" width="40" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M10 14 Q18 10 26 14 T46 14" stroke="#C9A84C" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                <path d="M12 22 Q20 18 28 22 T48 22" stroke="#C9A84C" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.6"/>
              </svg>
            </div>
            <p class="pillow-guide-num">④</p>
            <h3 class="pillow-guide-title">通気性・吸湿性</h3>
            <p class="pillow-guide-text">寝ている間にコップ1杯分の汗をかきます。湿気がこもるとカビ・ダニ発生の原因に。空気を通す構造や吸湿性の高い素材を選びましょう。</p>
            <div class="pillow-guide-check">
              <p class="pillow-guide-check-title">見極め方</p>
              <ul>
                <li>エアファイバー・3次元ファイバー＝通気性◎</li>
                <li>ウレタンは開放構造かをチェック</li>
                <li>羊毛・綿の混合は吸湿性が高い</li>
              </ul>
            </div>
          </div>

          <!-- ⑤ お手入れ -->
          <div class="pillow-guide-card">
            <div class="pillow-guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="pillow-guide-svg">
                <rect x="14" y="32" width="28" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M18 12 Q14 18 14 22 Q14 26 18 26 Q22 26 22 22 Q22 18 18 12Z" fill="#C9A84C" opacity="0.85"/>
                <circle cx="38" cy="18" r="6" stroke="#1B3A5C" stroke-width="1.5" fill="none"/>
                <path d="M34 18 L37 21 L42 16" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
            <p class="pillow-guide-num">⑤</p>
            <h3 class="pillow-guide-title">お手入れ（洗える・干しやすさ）</h3>
            <p class="pillow-guide-text">敷布団は毎日肌に触れます。本体まで洗える商品や、軽量で干しやすい商品を選ぶと衛生的に長く使えます。</p>
            <div class="pillow-guide-check">
              <p class="pillow-guide-check-title">見極め方</p>
