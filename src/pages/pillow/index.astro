---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const products = [
  {
    rank: 1,
    name: 'ブレインスリープ ピロー',
    score: 26.0,
    price: '11,000円〜33,000円',
    priceS: '11,000円', priceM: '13,000円', priceL: '33,000円',
    material: '3次元ファイバー',
    firmness: 'やや硬め',
    height: '高さ5段階＋形状カスタム',
    care: 'シャワー水洗いOK',
    warranty: '原則保証なし',
    recommend: '通気性・衛生面・首こり対策を重視する人',
    worry: '首こり・蒸れ・衛生',
    summary: '「脳が眠る枕」をコンセプトに開発された科学設計枕。90%空気層の3次元ファイバー素材で通気性に優れ、シャワーで水洗い可能。5段階高さ調整＋形状カスタムで首にぴったりフィット。',
    goodPoints: ['90%空気層で抜群の通気性', '5段階高さ調整＋形状カスタム可能', 'シャワー水洗いOKの衛生設計'],
    badPoints: ['価格はやや高め（1万円超〜）', '原則として返金保証なし'],
    tags: ['医師推奨', '通気性抜群', '高さ調整可'],
    href: '/review/brain-sleep-pillow/',
    affiliateHref: '#',
  },
  {
    rank: 2,
    name: '王様の夢枕',
    score: 22.0,
    price: '7,000円〜10,000円',
    priceS: '7,000円〜', priceM: '8,000円〜', priceL: '10,000円〜',
    material: '極小ビーズ',
    firmness: 'やわらかめ',
    height: '付属シートで簡易調整',
    care: 'カバーのみ洗濯可',
    warranty: '販売店により異なる',
    recommend: '初めての高機能枕を試したい人',
    worry: '初購入・コスパ重視',
    summary: '累計販売100万個超のロングセラー枕。極小ビーズ素材で頭の形にフィットし、ふわっとした寝心地。「初めての高機能枕」としても入りやすい価格設定。',
    goodPoints: ['累計100万個販売の信頼性', '7,000円〜の手の届く価格', '日本製の安心感'],
    badPoints: ['本体は洗濯不可（カバーのみ）', '高さ調整は簡易的'],
    tags: ['累計100万個突破', '日本製', 'コスパ◎'],
    href: '/review/yume-makura/',
    affiliateHref: '#',
  },
  {
    rank: 3,
    name: 'ヒツジのいらない枕',
    score: 20.0,
    price: '13,000円〜20,000円',
    priceS: '13,000円〜', priceM: '15,000円〜', priceL: '20,000円〜',
    material: '独自TPE素材',
    firmness: 'やわらかめ',
    height: '高さ違い種類あり',
    care: '本体洗濯不可',
    warranty: '返金保証あり',
    recommend: 'SNSで話題の枕を試したい人',
    worry: '話題性・3Dフィット',
    summary: 'SNS・YouTubeで急成長した新進ブランド。「Air Fit構造」と呼ばれる独自TPE素材で、頭部のフィット感に特化した3D形状。返金保証付きで試しやすい。',
    goodPoints: ['SNSで話題の独自TPE素材', '3D形状で頭にしっかりフィット', '返金保証付きで試しやすい'],
    badPoints: ['素材の好みが分かれる', '通気性は高機能枕の中では平均的'],
    tags: ['SNS人気', '独自3D形状', '返金保証あり'],
    href: '/review/hitsuji-no-iranai-pillow/',
    affiliateHref: 'https://hitsuji-zzz.com/products/ht-001',
  },
  {
    rank: 4,
    name: 'テンピュール オリジナルピロー',
    score: 18.5,
    price: '14,000円〜25,000円',
    priceS: '14,000円〜', priceM: '18,000円〜', priceL: '25,000円〜',
    material: '低反発ウレタン',
    firmness: 'やわらかめ',
    height: 'サイズ別固定',
    care: '本体洗濯不可',
    warranty: '3年品質保証',
    recommend: '低反発派・海外ブランド志向',
    worry: '世界的ブランドを使いたい',
    summary: 'NASAが開発した素材を採用する世界的な低反発枕の定番。頭部の形にゆっくり沈み込む独特の寝心地。海外でも認知度が高い王道ブランド。',
    goodPoints: ['世界的に認知された老舗ブランド', 'NASA素材の確かな品質', '3年品質保証付き'],
    badPoints: ['低反発で蒸れやすい', '高さ調整不可', '価格が高め'],
    tags: ['世界的ブランド', '低反発', 'NASA素材'],
    href: '#',
    affiliateHref: 'https://jp.tempur.com/',
  },
  {
    rank: 5,
    name: 'ニトリ Nホテルピロー',
    score: 17.0,
    price: '1,500円〜3,000円',
    priceS: '1,500円〜', priceM: '2,500円〜', priceL: '3,000円〜',
    material: 'ポリエステル綿',
    firmness: 'やわらかめ',
    height: '調整不可',
    care: '本体洗濯不可',
    warranty: 'なし',
    recommend: 'お試し・予算重視・来客用',
    worry: '予算重視・気軽に試したい',
    summary: 'ホテルの枕のような柔らかい寝心地を再現した、ニトリの定番ベーシック枕。低価格で買い替えやすく、専門枕にこだわらない方の入門用として選ばれる1台。',
    goodPoints: ['1,500円〜の圧倒的な低価格', 'ニトリの安心感・全国の店舗で実店試し可', '気軽に買い替えできる'],
    badPoints: ['機能性は専門枕に劣る', '高さ調整不可', '本体は洗濯不可'],
    tags: ['ホテル仕様', '低価格', 'お試し用'],
    href: '#',
    affiliateHref: 'https://www.nitori-net.jp/',
  },
];

const typeRankings = {
  soft: [
    { rank: 1, name: '王様の夢枕', point: '極小ビーズで包み込まれる柔らか感', href: '/review/yume-makura/' },
    { rank: 2, name: 'テンピュール オリジナル', point: '低反発でゆっくり沈み込む寝心地', href: '#' },
    { rank: 3, name: 'ヒツジのいらない枕', point: '独自TPE素材で頭にフィット', href: '/review/hitsuji-no-iranai-pillow/' },
  ],
  firm: [
    { rank: 1, name: 'ブレインスリープ ピロー', point: '3次元ファイバーで適度な硬さ＋反発', href: '/review/brain-sleep-pillow/' },
    { rank: 2, name: '王様の夢枕', point: 'ビーズの量で硬さ調整可能', href: '/review/yume-makura/' },
  ],
  cool: [
    { rank: 1, name: 'ブレインスリープ ピロー', point: '90%空気層で抜群の通気性', href: '/review/brain-sleep-pillow/' },
    { rank: 2, name: '王様の夢枕', point: 'ビーズ素材で蒸れにくい', href: '/review/yume-makura/' },
    { rank: 3, name: 'ニトリ Nホテルピロー', point: '化繊綿で通気性は標準的', href: '#' },
  ],
  cospa: [
    { rank: 1, name: 'ニトリ Nホテルピロー', point: '1,500円〜の圧倒的コスパ', href: '#' },
    { rank: 2, name: '王様の夢枕', point: '7,000円〜で本格機能枕', href: '/review/yume-makura/' },
    { rank: 3, name: 'ヒツジのいらない枕', point: '返金保証付きでリスクゼロ', href: '/review/hitsuji-no-iranai-pillow/' },
  ],
};

const faqs = [
  { q: '枕の選び方で一番重要なポイントは何ですか？', a: '「高さ」と「素材」の2点です。高さは仰向け・横向き寝で首の自然なカーブを支えられる高さを選び、素材は通気性・お手入れ性・寝心地の好みで決めましょう。' },
  { q: '高機能枕（1万円超）と普通の枕、何が違いますか？', a: '高機能枕は「素材」「高さ調整」「お手入れ性」「耐久性」が大きく異なります。1日30分以上頭を乗せる時間が長いほど投資効果が大きく、長期的にはコスパが良い場合も。' },
  { q: '枕の寿命は何年くらいですか？', a: '一般的に2〜3年が目安です。ヘタリ・カビ・嫌な臭いが出てきたら買い替えのサイン。ブレインスリープのような高機能枕でも、寿命の目安は3年程度です。' },
  { q: '横向き寝でも使える枕はどれですか？', a: '高さ調整＋頭にフィットする素材の枕がおすすめ。ブレインスリープ（5段階調整）、王様の夢枕（ビーズが流動的にフィット）が横向き寝でも使いやすい設計です。' },
  { q: '本体を丸洗いできる枕はありますか？', a: 'ブレインスリープ ピローはシャワーで水洗いが可能です。他の枕は基本的にカバーのみ洗濯可能で、本体は陰干しでケアします。' },
  { q: '低反発と高反発、どちらが首こりに効きますか？', a: '個人差がありますが、首こりには「適度な硬さがあり、頭の重さで沈み込みすぎない」設計がおすすめ。テンピュール（低反発）よりブレインスリープ（やや硬め）の方が首コリ対策には向くケースが多いです。' },
];
---
<Layout
  title="枕おすすめランキング2026｜首こり・肩こり対策で徹底比較"
  description="首こり・肩こりに効く枕5商品を徹底比較。ブレインスリープ・王様の夢枕など人気枕を、フィット感・高さ調整・通気性・お手入れ・価格の6軸で30点満点採点しました。"
>
  <Header />
  <main>

    <!-- ===== パンくず ===== -->
    <div class="page-header">
      <div class="container">
        <Breadcrumb items={[{ label: '枕' }]} />
      </div>
    </div>

    <!-- ===== HERO ===== -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-content">
          <p class="hero-badge">PILLOW RANKING 2026</p>
          <h1 class="hero-title">首こり・肩こりに効く<br><span class="hero-title-em">枕</span>を徹底比較</h1>
          <p class="hero-sub">人気5商品を6つの基準で30点満点採点。<br class="hide-sp">あなたに合う1台が見つかります。</p>
          <a href="#top3" class="hero-cta">ランキングを見る ↓</a>
        </div>
      </div>
    </section>

    <!-- ===== 悩み別ナビ ===== -->
    <section class="worry-nav-section">
      <div class="container">
        <p class="worry-nav-heading">あなたの悩みはどれですか？</p>
        <div class="worry-nav-grid">
          <a href="#brain-sleep-review" class="worry-nav-card">
            <div class="worry-nav-icon">💤</div>
            <p class="worry-nav-title">朝の首こり・肩こり</p>
            <p class="worry-nav-desc">科学設計＋通気性で首をサポート</p>
            <span class="worry-nav-btn">この悩みを改善する →</span>
          </a>
          <a href="#yume-review" class="worry-nav-card">
            <div class="worry-nav-icon">💰</div>
            <p class="worry-nav-title">予算1万円以下で良い枕</p>
            <p class="worry-nav-desc">累計100万個のロングセラー</p>
            <span class="worry-nav-btn">この悩みを改善する →</span>
          </a>
          <a href="#brain-sleep-review" class="worry-nav-card">
            <div class="worry-nav-icon">🌬️</div>
            <p class="worry-nav-title">枕の蒸れ・暑さが気になる</p>
            <p class="worry-nav-desc">90%空気層の通気性抜群素材</p>
            <span class="worry-nav-btn">おすすめを見る →</span>
          </a>
          <a href="#compare" class="worry-nav-card worry-nav-card--neutral">
            <div class="worry-nav-icon">📊</div>
            <p class="worry-nav-title">スペックで比べたい</p>
            <p class="worry-nav-desc">5商品を一覧で徹底比較</p>
            <span class="worry-nav-btn">比較表を見る →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ===== TOP3 ===== -->
    <section class="section" id="top3">
      <div class="container">
        <h2 class="section-title">首こり・肩こり対策に効く 枕TOP3</h2>
        <p style="margin-bottom: 1.5rem;">「朝起きると首がだるい」「枕が合っているか分からない」――そんな悩みに応える3台を、編集部が厳選しました。</p>
        <div class="top3-list">
          {products.slice(0, 3).map(p => (
            <div class="top3-card">
              <div class="top3-rank">
                <span class={`rank-circle rank-circle-${p.rank}`}>{p.rank}</span>
                <span class="rank-emoji">{p.rank === 1 ? '🥇' : p.rank === 2 ? '🥈' : '🥉'}</span>
              </div>
              <p class="top3-name">{p.name}</p>
              <div class="top3-score-row">
                <span class="top3-score">{p.score.toFixed(1)}</span>
                <span class="top3-score-max">/ 30点</span>
              </div>
              <p class="top3-price">{p.price}</p>
              <ul class="top3-tags">
                {p.tags.map(tag => <li>#{tag}</li>)}
              </ul>
              <p class="top3-summary">{p.summary}</p>
              <div class="top3-cta-row">
                {p.href !== '#' && (
                  <a href={p.href} class="top3-review-btn">レビュー記事 →</a>
                )}
                <a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="top3-cta-btn">
                  公式サイトを見る →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== タブ別ランキング ===== -->
    <section class="section section-bg">
      <div class="container">
        <h2 class="section-title">タイプ別おすすめ枕</h2>
        <p style="margin-bottom: 1.5rem;">寝心地の好みや重視ポイントで、おすすめの枕は変わります。あなたに合うタイプから選んでみてください。</p>

        <div class="tab-wrap">
          <div class="tab-btns" role="tablist">
            <button class="tab-btn active" data-tab="soft">やわらか系</button>
            <button class="tab-btn" data-tab="firm">しっかり系</button>
            <button class="tab-btn" data-tab="cool">通気性重視</button>
            <button class="tab-btn" data-tab="cospa">コスパ重視</button>
          </div>

          {Object.entries(typeRankings).map(([key, list]) => (
            <div class={`tab-content ${key === 'soft' ? 'active' : ''}`} data-content={key}>
              <div class="type-ranking-list">
                {list.map(item => (
                  <a href={item.href} class="type-ranking-item">
                    <span class={`type-ranking-rank rank-${item.rank}`}>{item.rank}</span>
                    <div>
                      <p class="type-ranking-name">{item.name}</p>
                      <p class="type-ranking-point">{item.point}</p>
                    </div>
                    {item.href !== '#' && <span class="type-ranking-arrow">›</span>}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== 比較表 ===== -->
    <section class="section" id="compare">
      <div class="container">
        <h2 class="section-title">人気枕 5商品 徹底比較表</h2>
        <p style="margin-bottom: 1.5rem;">価格・素材・高さ・お手入れ・保証など、購入判断に必要な情報を一覧化しました。</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th class="row-label">項目</th>
                {products.map(p => <th>{p.name}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="row-label">総合スコア</td>
                {products.map(p => <td><strong>{p.score.toFixed(1)}</strong>/30点</td>)}
              </tr>
              <tr>
                <td class="row-label">価格</td>
                {products.map(p => <td>{p.price}</td>)}
              </tr>
              <tr>
                <td class="row-label">素材</td>
                {products.map(p => <td>{p.material}</td>)}
              </tr>
              <tr>
                <td class="row-label">硬さ</td>
                {products.map(p => <td>{p.firmness}</td>)}
              </tr>
              <tr>
                <td class="row-label">高さ調整</td>
                {products.map(p => <td>{p.height}</td>)}
              </tr>
              <tr>
                <td class="row-label">お手入れ</td>
                {products.map(p => <td>{p.care}</td>)}
              </tr>
              <tr>
                <td class="row-label">保証</td>
                {products.map(p => <td>{p.warranty}</td>)}
              </tr>
              <tr>
                <td class="row-label">公式サイト</td>
                {products.map(p => (
                  <td><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="compare-btn">公式へ →</a></td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===== 各商品 詳細レビュー ===== -->
    <section class="section section-bg" id="reviews-detail">
      <div class="container">
        <h2 class="section-title">TOP3 各商品の詳細レビュー</h2>

        {products.slice(0, 3).map(p => (
          <div class="review-detail-card" id={p.rank === 1 ? 'brain-sleep-review' : p.rank === 2 ? 'yume-review' : 'hitsuji-review'}>
            <div class="rd-header">
              <span class={`rd-rank rd-rank-${p.rank}`}>第{p.rank}位</span>
              <h3 class="rd-name">{p.name}</h3>
              <div class="rd-score-block">
                <span class="rd-score-num">{p.score.toFixed(1)}</span>
                <span class="rd-score-max">/ 30点</span>
              </div>
            </div>

            <p class="rd-summary">{p.summary}</p>

            <div class="rd-tags">
              {p.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>

            <div class="rd-spec-grid">
              <div class="rd-spec-row"><span class="rd-spec-label">価格</span><span class="rd-spec-val">{p.price}</span></div>
              <div class="rd-spec-row"><span class="rd-spec-label">素材</span><span class="rd-spec-val">{p.material}</span></div>
              <div class="rd-spec-row"><span class="rd-spec-label">高さ調整</span><span class="rd-spec-val">{p.height}</span></div>
              <div class="rd-spec-row"><span class="rd-spec-label">お手入れ</span><span class="rd-spec-val">{p.care}</span></div>
            </div>

            <div class="rd-points">
              <div class="rd-point-good">
                <p class="rd-point-title">✓ 良い点</p>
                <ul>
                  {p.goodPoints.map(pt => <li>{pt}</li>)}
                </ul>
              </div>
              <div class="rd-point-bad">
                <p class="rd-point-title">✗ 気になる点</p>
                <ul>
                  {p.badPoints.map(pt => <li>{pt}</li>)}
                </ul>
              </div>
            </div>

            <div class="rd-cta-row">
              {p.href !== '#' && (
                <a href={p.href} class="rd-review-btn">徹底レビューを読む →</a>
              )}
              <a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="rd-cta">
                {p.name}公式サイトを見る →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== 悩みから選ぶ ===== -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">悩みから選ぶ</h2>
        <p style="margin-bottom: 1.25rem;">あなたの状況に合う枕がすぐ見つかります。</p>
        <div class="trouble-grid">
          {[
            { tag: '首こり', label: '朝起きると首が痛い・だるい', sub: '3次元ファイバー＋5段階高さ調整のブレインスリープ', href: '/review/brain-sleep-pillow/' },
            { tag: '蒸れ', label: '枕が蒸れる・暑い', sub: '90%空気層のブレインスリープが圧倒的に通気性◎', href: '/review/brain-sleep-pillow/' },
            { tag: '初心者', label: '初めての高機能枕を試したい', sub: '累計100万個・7,000円〜の王様の夢枕', href: '/review/yume-makura/' },
            { tag: '横向き寝', label: '横向き寝で肩が痛い', sub: '高さ調整＋頭フィット感のブレインスリープ', href: '/review/brain-sleep-pillow/' },
            { tag: '予算', label: 'なるべく安く試したい', sub: '1,500円〜のニトリ Nホテルピローから検討', href: '#compare' },
