---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const products = [
  {
    rank: 1,
    name: '雲のやすらぎプレミアム モデル3R',
    score: 25.5, maxScore: 30,
    price: '79,800円〜',
    material: '高反発ウレタン', firmness: 'かため',
    priceRange: 'high',
    tags: ['腰痛特化', '腰部260N', '100日返金保証'],
    summary: '腰部に超高反発ウレタン（260N）を使用した5層構造の日本製マットレス。極厚23cmで底つき感がなく、朝の腰の痛み・重だるさが気になる方に特におすすめ。',
    href: '/review/kumo-yasuragi/',
    affiliateHref: 'https://px.a8.net/svt/ejp?a8mat=4B3N6X+EOOXYQ+2DDC+B8V6SI',
  },
  {
    rank: 2,
    name: 'REVERIA（リヴェリア）',
    score: 24.0, maxScore: 30,
    price: '59,800円',
    material: '高反発ウレタン', firmness: 'かため',
    priceRange: 'middle',
    tags: ['医療機器認証', 'リカバリー', 'トッパー対応'],
    summary: '日本初・唯一の医療機器認証マットレス。ネオジム磁石48個を内蔵し、腰回りの血行ケアをサポート。今の寝具に重ねて使えるトッパー10cmタイプ。',
    href: '/review/reveria/',
    affiliateHref: 'https://px.a8.net/svt/ejp?a8mat=4B3N6X+EIQLWY+4TX4+ZQ80I',
  },
  {
    rank: 3,
    name: 'NELLマットレス',
    score: 23.0, maxScore: 30,
    price: '79,900円〜',
    material: 'ポケットコイル', firmness: 'かため',
    priceRange: 'high',
    tags: ['1,173個コイル', 'センターハード', '120日返金＋10年保証'],
    summary: '業界最高水準のポケットコイル1,173個＋センターハード構造で寝返りを快適にサポート。120日トライアル＋10年品質保証で「失敗しないマットレス選び」を実現。',
    href: '/review/nell/',
    affiliateHref: 'https://px.a8.net/svt/ejp?a8mat=4B3N6X+EPVT6A+4KD8+5ZMCI',
  },
  {
    rank: 4,
    name: 'LIMNE（リムネ）',
    score: 20.0, maxScore: 30,
    price: '79,900円〜',
    material: '低反発ウレタン', firmness: 'やわらかめ',
    priceRange: 'high',
    tags: ['肩こり対応', '120日返金', '独自設計'],
    summary: '高反発・低反発の中間設計で、肩への圧迫感ゼロを実現する独自ウレタンマットレス。横向き寝が多い方や肩こりに悩む方に好相性。',
    href: '#',
    affiliateHref: 'https://limne.jp/products/limne-the-mattress',
  },
  {
    rank: 5,
    name: 'エマ・スリープ ハイブリッドV3',
    score: 21.5, maxScore: 30,
    price: '49,630円〜',
    material: 'ハイブリッド', firmness: 'やわらかめ',
    priceRange: 'middle',
    tags: ['7ゾーン設計', '2人利用OK', '100日返金＋10年保証'],
    summary: 'ドイツ発のスリープテックブランド。7ゾーンポケットコイル＋3層ウレタンで体圧を均等に分散。振動が伝わりにくく、夫婦・カップル使用にも向いています。',
    href: '/review/emma/',
    affiliateHref: 'https://www.emma-sleep-japan.com/products/mattress-luxury?view_product=mattress-luxury-v2',
  },
  {
    rank: 6,
    name: 'GOKUMIN プレミアムスプリング',
    score: 17.5, maxScore: 30,
    price: '21,698円〜',
    material: 'ハイブリッド', firmness: 'かため',
    priceRange: 'low',
    tags: ['1万円台〜', '6サイズ展開', '8年保証'],
    summary: '1万円台〜で買える高反発スプリング＋ウレタンのハイブリッドマットレス。8年保証付きで「マットレスデビュー」や来客用としてコスパ最強。',
    href: '/review/gokumin/',
    affiliateHref: 'https://px.a8.net/svt/ejp?a8mat=4B3N6X+EJXH4I+539S+5YZ77',
  },
];
---
<Layout
  title="マットレスおすすめランキング｜腰痛・リカバリー対応で徹底比較"
  description="腰痛・コリ・寝返り問題などに対応した人気マットレスを徹底比較。当サイト独自の30点満点スコアで、雲のやすらぎ・REVERIA・NELLなど6商品をランキング形式で紹介します。"
>
  <Header />
  <main>
    <div class="page-header">
      <div class="container">
        <Breadcrumb items={[{ label: 'マットレス' }]} />
        <h1>マットレス おすすめ比較・ランキング</h1>
        <p>腰痛・コリ・寝返り問題などに対応する人気マットレスを、当サイト独自の30点満点スコアで徹底比較。あなたの悩みに合う1台が見つかります。</p>
      </div>
    </div>

    <div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
      <div class="content-wrap">
        <div class="main-content">

          <!-- フィルター -->
          <div class="filter-bar" id="filterBar">
            <div class="filter-group">
              <label for="filterPrice">価格帯</label>
              <select id="filterPrice">
                <option value="">すべて</option>
                <option value="low">〜3万円</option>
                <option value="middle">3〜6万円</option>
                <option value="high">6万円〜</option>
              </select>
            </div>
            <div class="filter-group">
              <label for="filterMaterial">素材</label>
              <select id="filterMaterial">
                <option value="">すべて</option>
                <option value="高反発ウレタン">高反発ウレタン</option>
                <option value="低反発ウレタン">低反発ウレタン</option>
                <option value="ポケットコイル">ポケットコイル</option>
                <option value="ハイブリッド">ハイブリッド（コイル＋ウレタン）</option>
              </select>
            </div>
            <div class="filter-group">
              <label for="filterFirmness">硬さ</label>
              <select id="filterFirmness">
                <option value="">すべて</option>
                <option value="やわらかめ">やわらかめ</option>
                <option value="ふつう">ふつう</option>
                <option value="かため">かため</option>
              </select>
            </div>
            <button class="filter-reset" id="filterReset">リセット</button>
          </div>

          <!-- 結果件数 -->
          <p class="filter-count" id="filterCount">{products.length}件表示中</p>

          <!-- ランキングリスト -->
          <div class="product-list" id="productList">
            {products.map(p => (
              <div
                class="product-card"
                data-price={p.priceRange}
                data-material={p.material}
                data-firmness={p.firmness}
              >
                <div class="product-card-rank-row">
                  <span class={`product-card-rank ${p.rank <= 3 ? `rank-${p.rank}` : 'rank-other'}`}>{p.rank}</span>
                  <span class={`rank-badge rank-badge-${p.rank <= 3 ? p.rank : 'other'}`}>
                    {p.rank === 1 ? '🥇 第1位' : p.rank === 2 ? '🥈 第2位' : p.rank === 3 ? '🥉 第3位' : `第${p.rank}位`}
                  </span>
                </div>
                {p.href !== '#' ? (
                  <a href={p.href} class="product-card-name">{p.name}</a>
                ) : (
                  <span class="product-card-name">{p.name}</span>
                )}
                <div class="product-card-score">総合スコア {p.score} / {p.maxScore}点</div>
                <div class="product-card-tags">
                  {p.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
                <p style="font-size:1rem; color: var(--color-primary); font-weight:700; margin-bottom:0.5rem;">{p.price}</p>
                <p style="font-size:0.88rem; color: var(--color-text-muted); margin-bottom: 1rem;">{p.summary}</p>
                <div class="cta-row">
                  {p.href !== '#' && (
                    <a href={p.href} class="review-btn">レビュー記事を読む →</a>
                  )}
                  <div class="cta-btn-wrap">
                    <span class="pr-badge">PR</span>
                    <a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="cta-btn" style="font-size:0.9rem; padding: 0.7rem 1.25rem;">
                      公式サイトで確認する →
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <p class="no-results hidden" id="noResults">条件に一致する商品が見つかりませんでした。</p>

          <!-- 比較表 -->
          <h2 style="margin-top: 3rem;">マットレス比較表（TOP5）</h2>
          <div class="compare-wrap">
            <table class="compare-table">
              <thead>
                <tr>
                  <th class="row-label">項目</th>
                  {products.slice(0, 5).map(p => <th>{p.name}</th>)}
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="row-label">総合スコア</td>
                  {products.slice(0, 5).map(p => <td><strong>{p.score}</strong>/30点</td>)}
                </tr>
                <tr>
                  <td class="row-label">価格</td>
                  {products.slice(0, 5).map(p => <td>{p.price}</td>)}
                </tr>
                <tr>
                  <td class="row-label">素材</td>
                  {products.slice(0, 5).map(p => <td>{p.material}</td>)}
                </tr>
                <tr>
                  <td class="row-label">硬さ</td>
                  {products.slice(0, 5).map(p => <td>{p.firmness}</td>)}
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- サイドバー -->
        <aside class="sidebar">
          <div class="sidebar-box">
            <h3>カテゴリー</h3>
            <ul class="sidebar-list">
              <li><a href="/mattress/">マットレス</a></li>
              <li><a href="/pillow/">枕</a></li>
              <li><a href="/futon/">布団</a></li>
              <li><a href="/cover/">カバー・シーツ</a></li>
              <li><a href="/column/">コラム</a></li>
            </ul>
          </div>
          <div class="sidebar-box">
            <h3>レビュー記事</h3>
            <ul class="sidebar-list">
              <li><a href="/review/kumo-yasuragi/">雲のやすらぎプレミアム モデル3R</a></li>
              <li><a href="/review/reveria/">REVERIA（リヴェリア）</a></li>
              <li><a href="/review/nell/">NELLマットレス</a></li>
              <li><a href="/review/gokumin/">GOKUMIN プレミアムスプリング</a></li>
            </ul>
          </div>
          <div class="sidebar-box">
            <h3>悩みから探す</h3>
            <ul class="sidebar-list">
              <li><a href="/column/back-pain-tips/">腰痛持ちが選ぶポイント</a></li>
              <li><a href="/column/topper-vs-main/">トッパー vs メイン</a></li>
              <li><a href="/column/mattress-lifespan/">マットレスの寿命</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const priceSelect = document.getElementById('filterPrice') as HTMLSelectElement;
  const materialSelect = document.getElementById('filterMaterial') as HTMLSelectElement;
  const firmnessSelect = document.getElementById('filterFirmness') as HTMLSelectElement;
  const resetBtn = document.getElementById('filterReset');
  const productList = document.getElementById('productList');
  const countEl = document.getElementById('filterCount');
  const noResults = document.getElementById('noResults');

  function applyFilters() {
    const price = priceSelect.value;
    const material = materialSelect.value;
    const firmness = firmnessSelect.value;
    const cards = productList?.querySelectorAll('.product-card') ?? [];
    let visible = 0;
    cards.forEach(card => {
      const el = card as HTMLElement;
      const matchPrice = !price || el.dataset.price === price;
      const matchMaterial = !material || el.dataset.material === material;
      const matchFirmness = !firmness || el.dataset.firmness === firmness;
      const show = matchPrice && matchMaterial && matchFirmness;
      el.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    if (countEl) countEl.textContent = `${visible}件表示中`;
    noResults?.classList.toggle('hidden', visible > 0);
  }

  priceSelect?.addEventListener('change', applyFilters);
  materialSelect?.addEventListener('change', applyFilters);
  firmnessSelect?.addEventListener('change', applyFilters);
  resetBtn?.addEventListener('click', () => {
    priceSelect.value = '';
    materialSelect.value = '';
    firmnessSelect.value = '';
    applyFilters();
  });
</script>

<style>
  .product-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .filter-count { font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 1rem; }
  .no-results { text-align: center; padding: 2rem; color: var(--color-text-muted); }
  .product-card-rank-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
  .rank-badge-other { background: #F3F4F6; color: #374151; }
  .cta-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .review-btn { display: inline-block; padding: 0.6rem 1rem; background: #fff; color: #1B3A5C; border: 2px solid #1B3A5C; border-radius: 8px; font-size: 0.88rem; font-weight: 700; text-decoration: none; transition: background 0.2s; }
  .review-btn:hover { background: #1B3A5C; color: #fff; }
</style>
