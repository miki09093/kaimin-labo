---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const products = [
  {
    rank: 1,
    name: 'ニトリ ちょうど良い温度調整掛け布団（K2424）',
    shortName: 'ニトリ 温度調整掛け布団',
    score: 27.0,
    itemScores: { warm: 4.0, light: 4.5, breath: 4.5, care: 5.0, season: 5.0, cost: 4.0 },
    itemTexts: {
      warm: '温度調整わたで布団内28〜32℃',
      light: '軽量で扱いやすい',
      breath: '吸放湿でムレを防ぐ',
      care: '洗濯機で丸洗いOK',
      season: 'これ1枚でオールシーズン',
      cost: '6,990円〜の高コスパ',
    },
    price: '6,990円〜（公式・シングル）',
    material: '温度調整わた（ドイツ発明賞・世界特許技術）',
    sizes: 'S / SD / D / Q',
    care: '洗濯機で丸洗いOK／防ダニ・抗菌防臭',
    season: 'オールシーズン',
    made: '—',
    tags: ['オールシーズン', '洗える', 'コスパ◎'],
    summary: 'ドイツ発明賞を受賞した世界特許の「温度調整わた」を使用。室温と体温に応じて布団内を28〜32℃にキープし、これ1枚で1年中快適。洗濯機で丸洗いOK＋防ダニ・抗菌防臭で衛生的。6,990円〜という圧倒的コスパが魅力のNo.1モデル。',
    href: '#nitori-review',
    affiliateHref: 'https://www.nitori-net.jp/ec/product/7544531s/',
  },
  {
    rank: 2,
    name: '西川 2枚合わせ羽毛布団（フランス産ダウン90%）',
    shortName: '西川 2枚合わせ羽毛布団',
    score: 24.5,
    itemScores: { warm: 5.0, light: 4.5, breath: 4.0, care: 2.5, season: 4.5, cost: 4.0 },
    itemTexts: {
      warm: 'フランス産ダウン90%・DP400',
      light: '羽毛ならではの軽さ',
      breath: '綿100%側生地で吸湿性◎',
      care: '基本はカバー使用・羽毛は洗いにくい',
      season: '2枚合わせで1年中対応',
      cost: '本格羽毛では手頃な価格帯',
    },
    price: 'オープン価格（販売店により異なる）',
    material: 'フランス産ホワイトダウン90%＋フェザー10%（DP400／側生地 綿100%）',
    sizes: 'シングル 150×210cm ほか',
    care: '基本はカバーを使用／羽毛は専門クリーニング推奨',
    season: '2枚合わせ（合掛け＋肌掛け）でオールシーズン',
    made: '日本製',
    tags: ['フランス産ダウン90%', '日本製', '2枚合わせ'],
    summary: '創業1566年の老舗・西川による2枚合わせ羽毛布団。フランス産ホワイトダウン90%・ダウンパワー400の上質な羽毛と綿100%側生地で、真冬の暖かさは別格。合掛け＋肌掛けの2枚合わせで春夏秋冬すべてに対応。本格羽毛布団を求める方の決定版。',
    href: '#nishikawa-review',
    affiliateHref: 'https://www.nishikawa-store.com/collections/umoufuton',
  },
  {
    rank: 3,
    name: '無印良品 防ダニ 羽毛掛ふとん・一層式',
    shortName: '無印 羽毛掛ふとん',
    score: 22.0,
    itemScores: { warm: 4.5, light: 4.0, breath: 4.0, care: 2.5, season: 3.0, cost: 4.0 },
    itemTexts: {
      warm: 'ダウン80〜85%で十分な暖かさ',
      light: '一層式で軽量',
      breath: '羽毛の吸放湿性',
      care: '基本はカバー使用',
      season: '主に秋冬向け（薄掛けも別途あり）',
      cost: '29,900円〜（公式）',
    },
    price: '29,900円〜（公式・シングル）',
    material: 'ダウン80〜85%＋フェザー15〜20%（側生地 ポリエステル100%）',
    sizes: 'S / SD / D ほか',
    care: '基本はカバーを使用／防ダニ仕様',
    season: '主に秋冬向け',
    made: '—',
    tags: ['防ダニ仕様', '全国の店舗で買える', '無印品質'],
    summary: '無印良品の定番羽毛掛ふとん。ダウン80〜85%の一層式で軽く暖かく、防ダニ仕様で衛生面にも配慮。全国の無印良品店舗で実物を確認して買える安心感も魅力。シンプルなデザインでどんな寝室にもなじみます。',
    href: '#muji-review',
    affiliateHref: 'https://www.muji.com/jp/ja/store/cmdty/section/T20009',
  },
];

const faqs = [
  { q: '掛け布団は羽毛と化繊（ポリエステル）どちらがいい？', a: '真冬の暖かさ・軽さ・吸湿性を重視するなら羽毛、価格・洗いやすさ・オールシーズン性を重視するなら化繊（温度調整わた等）がおすすめです。羽毛は高価で洗いにくい一方、保温力と軽さは別格。化繊は手頃で家庭で洗える商品が多いのが特徴です。' },
  { q: '「2枚合わせ」の羽毛布団とは何ですか？', a: '厚手の「合掛け布団」と薄手の「肌掛け布団」をボタンなどで連結できるタイプです。冬は2枚を合わせて、春秋は合掛けのみ、夏は肌掛けのみ……と季節に応じて使い分けられるため、1セットで1年中使えます。' },
  { q: 'ダウンパワー（DP）とは？数値が高いほど良い？', a: 'ダウンパワーは羽毛のふくらみ（かさ高）を示す数値で、数値が高いほど少ない羽毛で暖かく軽い布団になります。一般的に300以上が良品、350以上で高品質、400以上はプレミアム級の目安です。' },
  { q: '掛け布団は洗えますか？', a: '化繊わた・温度調整わたタイプは洗濯機で丸洗いできる商品が多いです。羽毛布団は基本的にカバーを使い、本体は専門クリーニングに出すのが安心。日常的には風通しの良い場所での陰干しでケアします。' },
  { q: '掛け布団の寿命はどれくらい？', a: '羽毛布団は10年前後、化繊わたの布団は3〜5年が買い替えの目安です。ふくらみが戻らない・暖かさが減った・ニオイが取れない場合は買い替えのサインです。' },
];
---
<Layout
  title="掛け布団おすすめランキング2026｜羽毛・温度調整わたを徹底比較"
  description="掛け布団の人気3商品を徹底比較。ニトリ・西川・無印良品の掛け布団を、暖かさ・軽さ・通気性・お手入れ・オールシーズン対応・価格の6軸で30点満点採点しました。"
>
  <Header />
  <main>

    <!-- ===== パンくず ===== -->
    <div class="page-header">
      <div class="container">
        <Breadcrumb items={[{ label: '睡眠グッズ', href: '/goods/' }, { label: '掛け布団' }]} />
      </div>
    </div>

    <!-- ===== HERO ===== -->
    <section class="hero-section">
      <a href="#top3">
        <img src="/images/kakebuton-hero.png" alt="羽毛・温度調整わたの掛け布団を徹底比較" class="hero-img" loading="eager" fetchpriority="high" />
      </a>
    </section>

    <!-- ===== TOP3 ===== -->
    <section class="section" id="top3">
      <div class="container">
        <h2 class="section-title">快適な睡眠を支える 掛け布団TOP3</h2>
        <p style="margin-bottom: 1.5rem;">「冬は暖かく、夏は蒸れずに眠りたい」「洗える布団がいい」――そんな悩みに応える3枚を、編集部が厳選しました。</p>
        <div class="top3-list">
          {products.map(p => (
            <div class="top3-card">
              <div class="top3-header">
                <span class={`rank-circle rank-circle-${p.rank}`}>{p.rank}</span>
                <p class="top3-name">{p.name}</p>
              </div>
              <img src={`/images/${p.rank === 1 ? 'nitori-kakebuton' : p.rank === 2 ? 'nishikawa-kakebuton' : 'muji-kakebuton'}-card.png`} alt={p.name} class="top3-img" loading="lazy" />
              <div class="top3-score-row">
                <span class="top3-score">{p.score.toFixed(1)}</span>
                <span class="top3-score-max">/ 30点</span>
              </div>
              <p class="top3-price">{p.price}</p>
              <ul class="top3-tags">
                {p.tags.map(tag => <li>#{tag}</li>)}
              </ul>
              <p class="top3-summary">{p.summary}</p>
              <div class="top3-cta-row">
                <a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="top3-cta-btn">
                  公式サイトを見る →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== 掛け布団選びで失敗しない6つのポイント ===== -->
    <section class="section guide-section">
      <div class="container">
        <h2 class="section-title">掛け布団選びで失敗しない6つのポイント</h2>
        <p class="guide-lead">掛け布団選びで失敗しないために押さえるべき6つのポイント。当サイトはこの6項目を5点満点・合計30点で採点しています。</p>

        <div class="guide-grid">
          <!-- ① 暖かさ -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <rect x="8" y="30" width="40" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M20 22 Q18 16 22 12 Q24 16 22 22 M28 22 Q26 16 30 12 Q32 16 30 22 M36 22 Q34 16 38 12 Q40 16 38 22" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" fill="none"/>
              </svg>
            </div>
            <p class="guide-num">①</p>
            <h3 class="guide-title">暖かさ（保温性）</h3>
            <p class="guide-text">掛け布団の最重要ポイント。羽毛はダウン率・ダウンパワーが高いほど暖かく軽い。化繊は中わたの量と発熱・保温加工で決まります。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>羽毛＝ダウン率90%以上／DP350以上が高品質</li>
                <li>化繊＝吸湿発熱・温度調整わたをチェック</li>
                <li>真冬重視なら羽毛が有利</li>
              </ul>
            </div>
          </div>

          <!-- ② 軽さ -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <path d="M28 10 Q24 14 28 18 Q32 14 28 10Z" fill="#C9A84C" opacity="0.85"/>
                <rect x="10" y="32" width="36" height="12" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M28 18 Q22 24 28 30 Q34 24 28 18Z" fill="#C9A84C" opacity="0.4"/>
              </svg>
            </div>
            <p class="guide-num">②</p>
            <h3 class="guide-title">軽さ・体へのフィット</h3>
            <p class="guide-text">重い布団は寝返りの妨げや肩こりの原因に。軽くて体に沿う布団ほど快眠につながります。羽毛は特に軽量です。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>羽毛は同じ暖かさでも軽量</li>
                <li>立体キルトは体にフィットしてズレにくい</li>
                <li>重量表記もチェック</li>
              </ul>
            </div>
          </div>

          <!-- ③ 通気性 -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <rect x="8" y="30" width="40" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M10 14 Q18 10 26 14 T46 14" stroke="#C9A84C" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                <path d="M12 22 Q20 18 28 22 T48 22" stroke="#C9A84C" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.6"/>
              </svg>
            </div>
            <p class="guide-num">③</p>
            <h3 class="guide-title">通気性・吸湿性</h3>
            <p class="guide-text">寝ている間の汗を逃がす力。湿気がこもると蒸れ・カビの原因に。羽毛や綿は吸放湿性に優れます。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>羽毛・綿は吸放湿性が高い</li>
                <li>側生地が綿100%だとムレにくい</li>
                <li>吸放湿加工のある化繊もチェック</li>
              </ul>
            </div>
          </div>

          <!-- ④ お手入れ -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <rect x="14" y="32" width="28" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M18 12 Q14 18 14 22 Q14 26 18 26 Q22 26 22 22 Q22 18 18 12Z" fill="#C9A84C" opacity="0.85"/>
                <circle cx="38" cy="18" r="6" stroke="#1B3A5C" stroke-width="1.5" fill="none"/>
                <path d="M34 18 L37 21 L42 16" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
            <p class="guide-num">④</p>
            <h3 class="guide-title">お手入れ（洗える）</h3>
            <p class="guide-text">毎日肌に近い掛け布団は衛生面も大切。家庭で洗える商品なら清潔に保ちやすく長く使えます。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>化繊わたは洗濯機OKが多い</li>
                <li>羽毛は基本カバー使用＋陰干し</li>
                <li>防ダニ・抗菌加工があると安心</li>
              </ul>
            </div>
          </div>

          <!-- ⑤ オールシーズン -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <circle cx="28" cy="28" r="18" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M28 12 L28 44 M12 28 L44 28" stroke="#C9A84C" stroke-width="1.5" opacity="0.5"/>
                <circle cx="28" cy="28" r="5" fill="#C9A84C" opacity="0.7"/>
              </svg>
            </div>
            <p class="guide-num">⑤</p>
            <h3 class="guide-title">オールシーズン対応</h3>
            <p class="guide-text">1枚で1年中使えると収納も買い替えもラク。温度調整わたや2枚合わせタイプが季節を問わず活躍します。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>2枚合わせ＝季節で組み替え可能</li>
                <li>温度調整わた＝1枚で通年OK</li>
                <li>収納スペースの節約にも</li>
              </ul>
            </div>
          </div>

          <!-- ⑥ 価格 -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <rect x="6" y="30" width="30" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <circle cx="42" cy="20" r="10" fill="#C9A84C" opacity="0.18"/>
                <circle cx="42" cy="20" r="9" stroke="#C9A84C" stroke-width="2" fill="none"/>
                <path d="M38 15 L42 21 L46 15 M37 21 L47 21 M37 25 L47 25 M42 21 L42 27" stroke="#1B3A5C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
            <p class="guide-num">⑥</p>
            <h3 class="guide-title">価格・コスパ</h3>
            <p class="guide-text">掛け布団は数千円〜10万円超まで幅広い価格帯。使用年数で割った「1年あたりのコスト」で考えると選びやすくなります。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>化繊わたは数千円〜の高コスパ</li>
                <li>羽毛は高価だが10年使える</li>
                <li>使用年数で割って判断</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 比較表 ===== -->
    <section class="section" id="compare">
      <div class="container">
        <h2 class="section-title">人気掛け布団 3商品 徹底比較表</h2>
        <p style="margin-bottom: 1.5rem;">当サイトの採点6項目を軸に、人気掛け布団3商品を一覧で比較できます。スコアが高いほどおすすめです。</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <colgroup>
              <col class="col-label" />
              {products.map(() => <col class="col-product" />)}
            </colgroup>
            <thead>
              <tr>
                <th class="row-label">項目</th>
                {products.map(p => <th>{p.shortName}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="row-label">総合スコア</td>
                {products.map(p => <td><strong class="score-total">{p.score.toFixed(1)}</strong><span class="score-max">/30点</span></td>)}
              </tr>
              <tr>
                <td class="row-label">①暖かさ</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.warm)}`}>{p.itemTexts.warm}</td>)}
              </tr>
              <tr>
                <td class="row-label">②軽さ・フィット</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.light)}`}>{p.itemTexts.light}</td>)}
              </tr>
              <tr>
                <td class="row-label">③通気性</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.breath)}`}>{p.itemTexts.breath}</td>)}
              </tr>
              <tr>
                <td class="row-label">④お手入れ</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.care)}`}>{p.itemTexts.care}</td>)}
              </tr>
              <tr>
                <td class="row-label">⑤オールシーズン</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.season)}`}>{p.itemTexts.season}</td>)}
              </tr>
              <tr>
                <td class="row-label">⑥価格・コスパ</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.cost)}`}>{p.itemTexts.cost}</td>)}
              </tr>
              <tr>
                <td class="row-label">価格</td>
                {products.map(p => <td class="compare-info">{p.price}</td>)}
              </tr>
              <tr>
                <td class="row-label">主な素材</td>
                {products.map(p => <td class="compare-info">{p.material}</td>)}
              </tr>
              <tr>
                <td class="row-label">公式サイト</td>
                {products.map(p => (
                  <td><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="compare-btn">公式へ →</a></td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===== 各商品 詳細レビュー ===== -->
    <section class="section section-bg" id="reviews-detail">
      <div class="container">
        <h2 class="section-title">TOP3 各商品の詳細レビュー</h2>

        {products.map(p => (
          <div class="review-detail-card" id={p.rank === 1 ? 'nitori-review' : p.rank === 2 ? 'nishikawa-review' : 'muji-review'}>
            <div class="rd-header">
              <span class={`rd-rank rd-rank-${p.rank}`}>第{p.rank}位</span>
              <h3 class="rd-name">{p.name}</h3>
