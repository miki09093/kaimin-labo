---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const products = [
  {
    rank: 1,
    name: 'TENTIAL BAKUNE（バクネ）',
    shortName: 'TENTIAL BAKUNE',
    score: 27.0,
    itemScores: { recovery: 5.0, comfort: 5.0, medical: 5.0, wash: 4.5, design: 4.5, cost: 3.0 },
    itemTexts: {
      recovery: '特殊繊維SELFLAME®で遠赤外線輻射',
      comfort: 'パジャマとしての着心地に定評',
      medical: '一般医療機器 届出済み',
      wash: '洗濯後も機能が持続',
      design: 'BAKUNE Motion Design®で寝返り◎',
      cost: '22,880円〜（上下セット）',
    },
    price: '22,880円〜（公式・上下セット）',
    material: '特殊機能繊維「SELFLAME®」（極小セラミック粉末練り込み）',
    medical: '一般医療機器「家庭用遠赤外線血行促進用衣」届出済み',
    care: '家庭で洗濯可（機能は洗濯後も持続）',
    lineup: 'BAKUNE / BAKUNE Dry / スウェット など',
    tags: ['一般医療機器', 'パジャマ着心地◎', '最初の1着に'],
    summary: '今リカバリーウェア市場で最も話題のTENTIAL「BAKUNE」。極小セラミック粉末を練り込んだ特殊繊維「SELFLAME®」が体から発する遠赤外線を輻射し血行を促進。可動域を考えたMotion Design®で寝返りも快適。パジャマとしての着心地にも定評があり、初めての1着に最適なNo.1モデル。',
    href: '#bakune-review',
    affiliateHref: 'https://tential.jp/night-conditioning/recovery-wear',
  },
  {
    rank: 2,
    name: 'VENEX スタンダードドライ＋',
    shortName: 'VENEX スタンダードドライ＋',
    score: 25.5,
    itemScores: { recovery: 4.5, comfort: 4.5, medical: 5.0, wash: 5.0, design: 4.0, cost: 2.5 },
    itemTexts: {
      recovery: '独自PHT繊維（DPV576）',
      comfort: 'やわらかい質感でリラックス',
      medical: '一般医療機器 届出済み',
      wash: '洗濯しても機能が減少しない',
      design: 'シンボルカラーのデザイン',
      cost: '29,700円〜（上下セット）',
    },
    price: '29,700円〜（公式・上下セット）',
    material: '独自素材「DPV576」を練り込んだPHT繊維（ナノプラチナ等の鉱物含有）',
    medical: '一般医療機器（届出番号：14B3X10040000003）',
    care: '洗濯しても素材の機能が減少しない',
    lineup: 'スタンダードドライ＋ ほか多数',
    tags: ['一般医療機器', '老舗ブランド', '洗濯耐久◎'],
    summary: 'リカバリーウェアのパイオニア・VENEX（ベネクス）。独自のPHT繊維にナノプラチナなどの鉱物を含む「DPV576」を練り込み、洗濯しても機能が減少しないのが強み。エコテックス®スタンダード100の最高ランクを取得した安全性も魅力。長年の実績を重視する方におすすめ。',
    href: '#venex-review',
    affiliateHref: 'https://www.venex-j.co.jp/recoverywear/product/',
  },
  {
    rank: 3,
    name: 'リフランス（Liflance）',
    shortName: 'リフランス',
    score: 25.0,
    itemScores: { recovery: 4.5, comfort: 4.5, medical: 5.0, wash: 4.0, design: 4.0, cost: 3.0 },
    itemTexts: {
      recovery: '天然鉱石混合体「プラウシオン®」',
      comfort: '綿麻・コットンモダールなど自然素材',
      medical: '一般医療機器 届出済み',
      wash: '繰り返し着用に対応',
      design: '上質なパジャマらしいデザイン',
      cost: '24,200円〜（パジャマ）',
    },
    price: '24,200円〜（公式・パジャマ）',
    material: 'シリカ・トルマリン等の天然鉱石混合体「プラウシオン®」をコーティング',
    medical: '一般医療機器のリカバリーウェア',
    care: '繰り返しの着用・洗濯に対応',
    lineup: '綿麻ワッフルガーゼ／コットンモダール など',
    tags: ['一般医療機器', '一般医療機器パジャマの先駆け', '自然素材'],
    summary: '一般医療機器パジャマをいち早く世に送り出したパイオニア・リフランス。シリカやトルマリンなど天然鉱石の混合体「プラウシオン®」をコーティングした生地が、体温の輻射による微弱な遠赤外線で副交感神経に作用し疲労回復・安眠をサポート。綿麻・コットンモダールなど自然素材のパジャマらしい着心地が特徴です。',
    href: '#liflance-review',
    affiliateHref: 'https://liflance.jp/',
  },
];

const faqs = [
  { q: 'リカバリーウェアとは何ですか？普通のパジャマと違う？', a: '体から発せられる遠赤外線を輻射する特殊素材を使い、着用して休むことで血行促進・疲労回復・コリの緩和をサポートする衣類です。「一般医療機器（家庭用遠赤外線血行促進用衣）」として届出されている製品は、効果が一定の基準で認められています。普通のパジャマは素材の着心地が主目的で、リカバリー機能はありません。' },
  { q: '「一般医療機器」の表示はどういう意味ですか？', a: '「家庭用遠赤外線血行促進用衣」として国に届出された製品であることを示します。血行促進・筋肉の疲労回復・コリの緩和などの効果が認められています。本ページのBAKUNE・VENEX・リフランスはいずれも一般医療機器の届出済みです。' },
  { q: 'リカバリーウェアはいつ着るのが効果的ですか？', a: '主に就寝時やおうちでのリラックスタイムなど「休養している時間」に着用するのが基本です。運動後やお風呂上がりに着るのもおすすめ。日中の活動時に着るタイプもありますが、睡眠の質を高めたいなら就寝用として選ぶのが王道です。' },
  { q: '洗濯しても効果は落ちませんか？', a: '多くのリカバリーウェアは素材に機能成分を練り込んでいるため、洗濯による機能低下が起きにくい設計です。特にVENEXのPHT繊維は「洗濯しても機能が減少しない」と公式に明記されています。洗濯表示に従ってお手入れしてください。' },
  { q: 'どのブランドを選べばいいですか？', a: '初めての1着・パジャマとしての着心地重視なら「BAKUNE」、長年の実績・洗濯耐久性を重視するなら「VENEX」、自然素材のパジャマらしさを求めるなら「リフランス」がおすすめです。3ブランドとも一般医療機器の届出済みで、機能面の信頼性は高いです。' },
];
---
<Layout
  title="リカバリーウェアおすすめランキング2026｜BAKUNE・VENEXを徹底比較"
  description="一般医療機器のリカバリーウェア人気3ブランドを徹底比較。TENTIAL BAKUNE・VENEX・リフランスを、リカバリー機能・着心地・医療機器認証・洗濯耐久・デザイン・価格の6軸で30点満点採点しました。"
>
  <Header />
  <main>

    <!-- ===== パンくず ===== -->
    <div class="page-header">
      <div class="container">
        <Breadcrumb items={[{ label: '睡眠グッズ', href: '/goods/' }, { label: 'パジャマ・寝間着' }]} />
      </div>
    </div>

    <!-- ===== HERO ===== -->
    <section class="hero-section">
      <a href="#top3">
        <img src="/images/recovery-wear-hero.png" alt="一般医療機器のリカバリーウェアを徹底比較" class="hero-img" loading="eager" fetchpriority="high" />
      </a>
    </section>

    <!-- ===== TOP3 ===== -->
    <section class="section" id="top3">
      <div class="container">
        <h2 class="section-title">疲労回復をサポートする リカバリーウェアTOP3</h2>
        <p style="margin-bottom: 1.5rem;">「寝ても疲れが取れない」「着るだけで疲労ケアしたい」――そんな悩みに応える、一般医療機器のリカバリーウェア3ブランドを編集部が厳選しました。</p>
        <div class="top3-list">
          {products.map(p => (
            <div class="top3-card">
              <div class="top3-header">
                <span class={`rank-circle rank-circle-${p.rank}`}>{p.rank}</span>
                <p class="top3-name">{p.name}</p>
              </div>
              <img src={`/images/${p.rank === 1 ? 'bakune' : p.rank === 2 ? 'venex' : 'liflance'}-card.png`} alt={p.name} class="top3-img" loading="lazy" />
              <div class="top3-score-row">
                <span class="top3-score">{p.score.toFixed(1)}</span>
                <span class="top3-score-max">/ 30点</span>
              </div>
              <p class="top3-price">{p.price}</p>
              <ul class="top3-tags">
                {p.tags.map(tag => <li>#{tag}</li>)}
              </ul>
              <p class="top3-summary">{p.summary}</p>
              <div class="top3-cta-row">
                <a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="top3-cta-btn">
                  公式サイトを見る →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== リカバリーウェア選びで失敗しない6つのポイント ===== -->
    <section class="section guide-section">
      <div class="container">
        <h2 class="section-title">リカバリーウェア選びで失敗しない6つのポイント</h2>
        <p class="guide-lead">リカバリーウェア選びで押さえるべき6つのポイント。当サイトはこの6項目を5点満点・合計30点で採点しています。</p>

        <div class="guide-grid">
          <!-- ① リカバリー機能 -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <path d="M28 44 C28 44 10 32 10 20 C10 14 14 10 20 10 C24 10 27 13 28 16 C29 13 32 10 36 10 C42 10 46 14 46 20 C46 32 28 44 28 44Z" fill="#C9A84C" opacity="0.18" stroke="#C9A84C" stroke-width="2"/>
                <path d="M16 27 L23 27 L26 20 L30 34 L33 27 L40 27" stroke="#1B3A5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
            <p class="guide-num">①</p>
            <h3 class="guide-title">リカバリー機能（素材）</h3>
            <p class="guide-text">体から出る遠赤外線を輻射して血行を促す特殊素材が核心。各社が独自の機能繊維（SELFLAME®・PHT繊維・プラウシオン®等）を開発しています。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>独自の機能繊維・鉱物配合があるか</li>
                <li>遠赤外線輻射のメカニズムが明示されているか</li>
                <li>第三者認証・試験データの有無</li>
              </ul>
            </div>
          </div>

          <!-- ② 着心地 -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <path d="M20 12 L24 16 L32 16 L36 12 L44 18 L40 26 L36 24 L36 44 L20 44 L20 24 L16 26 L12 18 Z" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M24 16 Q28 22 32 16" stroke="#C9A84C" stroke-width="2" fill="none" stroke-linecap="round"/>
              </svg>
            </div>
            <p class="guide-num">②</p>
            <h3 class="guide-title">着心地・パジャマ性</h3>
            <p class="guide-text">就寝中ずっと着るものなので、肌ざわり・伸縮性・寝返りのしやすさが重要。パジャマとして快適でないと続きません。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>生地のなめらかさ・伸縮性</li>
                <li>寝返りを妨げない設計か</li>
                <li>季節に合った素材（ドライ／スウェット等）</li>
              </ul>
            </div>
          </div>

          <!-- ③ 一般医療機器 -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <circle cx="28" cy="28" r="18" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M28 19 L28 37 M19 28 L37 28" stroke="#C9A84C" stroke-width="3" stroke-linecap="round"/>
              </svg>
            </div>
            <p class="guide-num">③</p>
            <h3 class="guide-title">一般医療機器の届出</h3>
            <p class="guide-text">「家庭用遠赤外線血行促進用衣」として届出された製品は、血行促進・疲労回復などの効果が一定基準で認められています。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>「一般医療機器」の表示があるか</li>
                <li>医療機器届出番号が公開されているか</li>
                <li>効果の範囲が明示されているか</li>
              </ul>
            </div>
          </div>

          <!-- ④ 洗濯耐久 -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <rect x="12" y="10" width="32" height="36" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <circle cx="28" cy="30" r="9" fill="#fff" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M21 30 Q24 26 28 30 Q32 34 35 30" stroke="#C9A84C" stroke-width="2" fill="none" stroke-linecap="round"/>
                <circle cx="18" cy="16" r="1.5" fill="#C9A84C"/>
                <circle cx="23" cy="16" r="1.5" fill="#C9A84C"/>
              </svg>
            </div>
            <p class="guide-num">④</p>
            <h3 class="guide-title">洗濯耐久性</h3>
            <p class="guide-text">毎日着て洗うものなので、洗濯を繰り返しても機能が落ちないことが大切。素材に機能を練り込んだタイプは耐久性に優れます。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>機能成分が「練り込み」か「コーティング」か</li>
                <li>洗濯後の機能持続が明記されているか</li>
                <li>家庭洗濯が可能か</li>
              </ul>
            </div>
          </div>

          <!-- ⑤ デザイン -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <rect x="14" y="12" width="28" height="34" rx="3" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <path d="M22 18 L34 18 M22 24 L34 24 M22 30 L30 30" stroke="#C9A84C" stroke-width="2" stroke-linecap="round"/>
                <circle cx="36" cy="38" r="4" fill="#C9A84C" opacity="0.6"/>
              </svg>
            </div>
            <p class="guide-num">⑤</p>
            <h3 class="guide-title">デザイン・展開</h3>
            <p class="guide-text">外出時の部屋着兼用や、サイズ・カラー展開の豊富さも選ぶポイント。続けて着たくなるデザインかをチェック。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>サイズ・カラー展開の豊富さ</li>
                <li>部屋着としても使えるデザインか</li>
                <li>季節別・タイプ別の選択肢</li>
              </ul>
            </div>
          </div>

          <!-- ⑥ 価格 -->
          <div class="guide-card">
            <div class="guide-icon-wrap">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="guide-svg">
                <rect x="6" y="30" width="30" height="14" rx="4" fill="#EBF2FA" stroke="#1B3A5C" stroke-width="1.5"/>
                <circle cx="42" cy="20" r="10" fill="#C9A84C" opacity="0.18"/>
                <circle cx="42" cy="20" r="9" stroke="#C9A84C" stroke-width="2" fill="none"/>
                <path d="M38 15 L42 21 L46 15 M37 21 L47 21 M37 25 L47 25 M42 21 L42 27" stroke="#1B3A5C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
            <p class="guide-num">⑥</p>
            <h3 class="guide-title">価格・コスパ</h3>
            <p class="guide-text">リカバリーウェアは上下セットで2〜3万円前後が中心。毎日使う消耗品と考え、洗い替え用に複数枚揃えるケースも多いです。</p>
            <div class="guide-check">
              <p class="guide-check-title">見極め方</p>
              <ul>
                <li>上下セットか単品かを確認</li>
                <li>洗い替え用に複数枚必要か</li>
                <li>機能・耐久とのバランスで判断</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 比較表 ===== -->
    <section class="section" id="compare">
      <div class="container">
        <h2 class="section-title">人気リカバリーウェア 3ブランド 徹底比較表</h2>
        <p style="margin-bottom: 1.5rem;">当サイトの採点6項目を軸に、一般医療機器のリカバリーウェア3ブランドを一覧で比較できます。</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <colgroup>
              <col class="col-label" />
              {products.map(() => <col class="col-product" />)}
            </colgroup>
            <thead>
              <tr>
                <th class="row-label">項目</th>
                {products.map(p => <th>{p.shortName}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="row-label">総合スコア</td>
                {products.map(p => <td><strong class="score-total">{p.score.toFixed(1)}</strong><span class="score-max">/30点</span></td>)}
              </tr>
              <tr>
                <td class="row-label">①リカバリー機能</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.recovery)}`}>{p.itemTexts.recovery}</td>)}
              </tr>
              <tr>
                <td class="row-label">②着心地</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.comfort)}`}>{p.itemTexts.comfort}</td>)}
              </tr>
              <tr>
                <td class="row-label">③一般医療機器</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.medical)}`}>{p.itemTexts.medical}</td>)}
              </tr>
              <tr>
                <td class="row-label">④洗濯耐久性</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.wash)}`}>{p.itemTexts.wash}</td>)}
              </tr>
              <tr>
                <td class="row-label">⑤デザイン・展開</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.design)}`}>{p.itemTexts.design}</td>)}
              </tr>
              <tr>
                <td class="row-label">⑥価格・コスパ</td>
                {products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.cost)}`}>{p.itemTexts.cost}</td>)}
              </tr>
              <tr>
                <td class="row-label">価格（上下）</td>
                {products.map(p => <td class="compare-info">{p.price}</td>)}
              </tr>
              <tr>
                <td class="row-label">機能素材</td>
                {products.map(p => <td class="compare-info">{p.material}</td>)}
              </tr>
              <tr>
                <td class="row-label">医療機器届出</td>
                {products.map(p => <td class="compare-info">{p.medical}</td>)}
              </tr>
              <tr>
                <td class="row-label">公式サイト</td>
                {products.map(p => (
                  <td><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="compare-btn">公式へ →</a></td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===== 各商品 詳細レビュー ===== -->
    <section class="section section-bg" id="reviews-detail">
      <div class="container">
        <h2 class="section-title">TOP3 各ブランドの詳細レビュー</h2>

