---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import '../../../styles/goods-detail.css';

const products = [
  {
    rank: 1, name: 'めぐりズム 蒸気でホットアイマスク', shortName: 'めぐりズム ホットアイマスク', score: 26.0,
    img: 'eyemask-megrhythm-card.png', anchor: 'megrhythm-review',
    itemScores: { func: 5.0, relax: 5.0, fit: 4.5, repeat: 2.0, variation: 5.0, cost: 4.5 },
    itemTexts: { func: '約40℃の蒸気で約20分温め', relax: '心地よい蒸気でリラックス', fit: '耳掛けでフィット', repeat: '使い切りタイプ', variation: '香りが豊富', cost: '621円〜（5枚）' },
    price: '621円〜（5枚入・税込）', type: '使い捨て（ホットタイプ）', duration: '約40℃・約20分', care: '使い切り', made: '花王',
    tags: ['約40℃20分', '香り豊富', '手軽'],
    summary: '花王の定番ホットアイマスク。約40℃の心地よい蒸気が約20分間持続し、目元をじんわり温めてリラックスタイムを演出。無香料からラベンナー・メントール・キンモクセイなど香りのバリエーションが豊富。1枚あたり手頃で手軽に試せる人気No.1です。',
    affiliateHref: 'https://www.kao.co.jp/megrhythm/',
    features: [
      ['約40℃の蒸気で約20分じんわり温め', '袋を開けると自然に発熱し、約40℃の心地よい蒸気が約20分間持続。目元をじんわり温めてくつろぎのひとときを演出します。'],
      ['豊富な香りのバリエーション', '無香料をはじめ、ラベンダー・カモミール・メントール・ロイヤルバニラ・キンモクセイなど多彩な香り展開。その日の気分で選べます。'],
      ['使い切りで手軽・衛生的', '使い捨てタイプなので衛生的で、洗濯やお手入れの手間が不要。就寝前や移動中、デスクワークの合間など、手軽にリラックスできます。'],
    ],
    good: ['手軽に目元を温めたい方', '香りでリラックスしたい方', 'お手入れ不要の使い切りが好きな方', '就寝前のリラックス習慣を作りたい方'],
    bad: ['繰り返し使えるタイプが欲しい方', 'ランニングコストを抑えたい方'],
    miniFaq: [['何分くらい温かいですか？', '約40℃の蒸気が約20分間持続します。'], ['香りはありますか？', '無香料のほか、ラベンダー・メントールなど豊富な香りから選べます。'], ['繰り返し使えますか？', '使い切りタイプのため1回使い切りです。']],
  },
  {
    rank: 2, name: 'MYTREX Eye Air（アイマスク）', shortName: 'MYTREX Eye Air', score: 24.0,
    img: 'eyemask-mytrex-card.png', anchor: 'mytrex-review',
    itemScores: { func: 4.5, relax: 4.0, fit: 5.0, repeat: 5.0, variation: 3.5, cost: 3.5 },
    itemTexts: { func: '3D立体構造で高い遮光性', relax: '圧迫感のない装着感', fit: 'ノーズワイヤーで光漏れ防止', repeat: '繰り返し使えて洗濯OK', variation: 'カラー展開あり', cost: '1,980円で繰り返し使える' },
    price: '1,980円（公式・税込）', type: '繰り返し使用（遮光タイプ）', duration: '—（遮光・睡眠用）', care: '洗濯OK', made: 'MYTREX',
    tags: ['高遮光', '洗える', '1,980円'],
    summary: '独自の3D立体構造で高い遮光性を実現したMYTREXのアイマスク。鼻の隙間から入る光を遮るノーズワイヤー＋厚さ18mmのクッション材でしっかり遮光。目と生地が触れない立体構造で圧迫感が少なく、1,980円で洗濯でき繰り返し使えるのが魅力です。',
    affiliateHref: 'https://mytrex.jp/eye-air/',
    features: [
      ['3D立体構造で高い遮光性', '独自の3D立体構造と厚さ18mmのクッション材で、しっかりと光を遮断。ノーズワイヤーが鼻の隙間から入り込む光も防ぎます。'],
      ['圧迫感の少ない快適な装着感', '内側は目と生地が触れないよう立体構造で滑らかな窪みを設計。まばたきもしやすく、目元への圧迫感を感じにくい仕様です。'],
      ['洗濯できて繰り返し使える', '洗濯できるため衛生的で、繰り返し使えてランニングコストもかかりません。旅行・移動時の睡眠にも便利です。'],
    ],
    good: ['しっかり遮光して眠りたい方', '圧迫感のないアイマスクが欲しい方', '繰り返し使えるタイプが欲しい方', '旅行・移動中に使いたい方'],
    bad: ['目元を温める機能が欲しい方', '使い切りの手軽さを求める方'],
    miniFaq: [['温め機能はありますか？', '温め機能はなく、遮光・睡眠用のアイマスクです。'], ['洗えますか？', '洗濯できるため繰り返し衛生的に使えます。'], ['光漏れしませんか？', '3D立体構造＋ノーズワイヤーで鼻周りの光漏れを抑えます。']],
  },
  {
    rank: 3, name: 'ナイトミン 耳ほぐタイム（耳栓・温め）', shortName: 'ナイトミン 耳ほぐタイム', score: 21.0,
    img: 'eyemask-nightmin-card.png', anchor: 'nightmin-review',
    itemScores: { func: 4.0, relax: 4.5, fit: 4.0, repeat: 2.5, variation: 3.0, cost: 4.0 },
    itemTexts: { func: '約40℃で約20分温め＋遮音', relax: '耳を温めてリラックス', fit: '耳栓＋発熱体', repeat: '本体繰り返し＋発熱体使い切り', variation: '—', cost: '767円〜' },
    price: '767円〜（税込）', type: '耳栓＋温め（発熱体は使い切り）', duration: '約40℃・約20分', care: '本体は繰り返し／発熱体は使い切り', made: '小林製薬',
    tags: ['耳を温める', '遮音', 'リラックス'],
    summary: '小林製薬のユニークな「耳を温める」アイテム。発熱体により約40℃の温め効果が約20分持続し、耳栓で周囲の音をやわらげながら、耳元をじんわり温めてリラックス。アイマスクとは違うアプローチで、音が気になって眠れない方におすすめです。',
    affiliateHref: 'https://www.kobayashi.co.jp/brand/nightmin/',
    features: [
      ['耳を約40℃で約20分温める', '発熱体により耳元を約40℃で約20分間じんわり温めます。目元ではなく「耳」を温める、リラックスに着目したユニークな製品です。'],
      ['耳栓で周囲の音をやわらげる', '耳栓構造で周囲の音をやわらげ、静かな環境づくりをサポート。音が気になって眠れない方のリラックスタイムに適しています。'],
      ['本体は繰り返し使える', '本体（耳栓部分）は繰り返し使え、発熱体のみ使い切り。アイマスクと併用すれば、光・音・温めの複合的なリラックスが可能です。'],
    ],
    good: ['音が気になって眠れない方', '耳元を温めてリラックスしたい方', 'アイマスクとは違うアプローチを試したい方', '就寝前のリラックス習慣に'],
    bad: ['目元を遮光・温めたい方（アイマスク併用がおすすめ）', '耳栓の装着感が苦手な方'],
    miniFaq: [['目元用ですか？', 'いいえ、耳を温める＋遮音するアイテムです。アイマスクと併用すると効果的です。'], ['繰り返し使えますか？', '本体は繰り返し使え、発熱体のみ使い切りです。'], ['温め時間は？', '約40℃で約20分間持続します。']],
  },
];

const guide = [
  ['①', '遮光性／温め機能', 'アイマスクは「遮光タイプ」と「温めタイプ」が主流。目的（光を遮る／目元を温める）に合わせて選びます。', ['遮光重視＝立体構造＋ノーズワイヤー', '温め重視＝ホットタイプ', '両立したいなら使い分け']],
  ['②', 'リラックス効果', '目元・耳元を温める、香りでくつろぐなど、リラックスにつながる工夫があるかをチェック。', ['温めでじんわりリラックス', '香り付きはくつろぎ効果', '就寝前の習慣づくりに']],
  ['③', '装着感（フィット・圧迫感）', '長時間つけても痛くない、まばたきしやすい立体構造かが快適さを左右します。', ['目に生地が触れない立体構造', '締め付けすぎないバンド', '横向き寝でもズレにくいか']],
  ['④', '繰り返し使えるか', '使い切りは手軽で衛生的、繰り返しタイプはコスパ◎。使い方に合わせて選びます。', ['使い切り＝手軽・衛生的', '繰り返し＝コスパ◎', '洗濯できるか確認']],
  ['⑤', '香り・バリエーション', '香り付きは気分でリラックスを高められます。無香料の選択肢があるかも大切です。', ['ラベンダー等の香り展開', '無香料の有無', '気分で選べる豊富さ']],
  ['⑥', '価格・コスパ', '使い切りは1枚あたりのコスト、繰り返しは本体価格で比較。使う頻度に合わせて選びます。', ['使い切りは1枚あたりで計算', '繰り返しは本体価格', '使う頻度で選ぶ']],
];

const faqs = [
  { q: 'ホットアイマスクと遮光アイマスクはどう違う？', a: 'ホットアイマスクは目元を温めてリラックスを促すタイプ（使い切りが主流）、遮光アイマスクは光を遮って眠りやすくするタイプ（繰り返し使えるものが多い）です。リラックス目的ならホット、明るい場所で眠るなら遮光がおすすめです。' },
  { q: 'ホットアイマスクは毎日使っても大丈夫？', a: '基本的に毎日使えますが、低温やけどを避けるため使用方法・使用時間を守りましょう。肌に異常を感じた場合は使用を中止してください。コンタクトレンズは外して使うのが安心です。' },
  { q: '光と音、両方を遮りたい場合は？', a: '遮光アイマスク＋耳栓（または耳を温めるアイテム）の併用がおすすめです。本ページのMYTREX Eye Air（遮光）とナイトミン耳ほぐタイム（耳）を組み合わせると、光・音・温めを同時にケアできます。' },
  { q: '繰り返し使えるアイマスクのお手入れは？', a: '洗濯できるタイプは洗濯表示に従って洗い、清潔に保ちましょう。汗や皮脂が付着するため、定期的な洗濯が衛生的です。' },
  { q: '横向き寝でも使えますか？', a: '立体構造で目元への圧迫が少ないタイプは横向き寝でも比較的快適です。耳掛けタイプは横向きで耳が痛くなる場合があるため、バンドタイプも検討するとよいでしょう。' },
];
---
<Layout
  title="アイマスク・耳栓おすすめランキング2026｜めぐりズム・MYTREXを比較"
  description="睡眠用アイマスク・耳栓の人気3商品を徹底比較。めぐりズム・MYTREX Eye Air・ナイトミンを、機能・リラックス・装着感・繰り返し利用・香り・価格の6軸で30点満点採点しました。"
>
  <Header />
  <main>
    <div class="page-header"><div class="container"><Breadcrumb items={[{ label: '睡眠グッズ', href: '/goods/' }, { label: 'アイマスク・耳栓' }]} /></div></div>

    <section class="hero-section"><a href="#top3"><img src="/images/eyemask-hero.png" alt="睡眠用アイマスク・耳栓を徹底比較" class="hero-img" loading="eager" fetchpriority="high" /></a></section>

    <section class="section" id="top3">
      <div class="container">
        <h2 class="section-title">光・音を遮って快眠 アイマスク・耳栓TOP3</h2>
        <p style="margin-bottom: 1.5rem;">「明るくて眠れない」「音が気になる」「目元を温めてリラックスしたい」――そんな悩みに応える3つを編集部が厳選しました。</p>
        <div class="top3-list">
          {products.map(p => (
            <div class="top3-card">
              <div class="top3-header"><span class={`rank-circle rank-circle-${p.rank}`}>{p.rank}</span><p class="top3-name">{p.name}</p></div>
              <img src={`/images/${p.img}`} alt={p.name} class="top3-img" loading="lazy" />
              <div class="top3-score-row"><span class="top3-score">{p.score.toFixed(1)}</span><span class="top3-score-max">/ 30点</span></div>
              <p class="top3-price">{p.price}</p>
              <ul class="top3-tags">{p.tags.map(t => <li>#{t}</li>)}</ul>
              <p class="top3-summary">{p.summary}</p>
              <div class="top3-cta-row"><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="top3-cta-btn">公式サイトを見る →</a></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section guide-section">
      <div class="container">
        <h2 class="section-title">アイマスク・耳栓選びで失敗しない6つのポイント</h2>
        <p class="guide-lead">当サイトはこの6項目を5点満点・合計30点で採点しています。</p>
        <div class="guide-grid">
          {guide.map(g => (
            <div class="guide-card">
              <p class="guide-num">{g[0]}</p>
              <h3 class="guide-title">{g[1]}</h3>
              <p class="guide-text">{g[2]}</p>
              <div class="guide-check"><p class="guide-check-title">見極め方</p><ul>{(g[3] as string[]).map(c => <li>{c}</li>)}</ul></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="compare">
      <div class="container">
        <h2 class="section-title">人気アイマスク・耳栓 3商品 徹底比較表</h2>
        <p style="margin-bottom: 1.5rem;">当サイトの採点6項目を軸に、人気3商品を一覧で比較できます。</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <colgroup><col class="col-label" />{products.map(() => <col class="col-product" />)}</colgroup>
            <thead><tr><th class="row-label">項目</th>{products.map(p => <th>{p.shortName}</th>)}</tr></thead>
            <tbody>
              <tr><td class="row-label">総合スコア</td>{products.map(p => <td><strong class="score-total">{p.score.toFixed(1)}</strong><span class="score-max">/30点</span></td>)}</tr>
              <tr><td class="row-label">①機能</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.func)}`}>{p.itemTexts.func}</td>)}</tr>
              <tr><td class="row-label">②リラックス効果</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.relax)}`}>{p.itemTexts.relax}</td>)}</tr>
              <tr><td class="row-label">③装着感</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.fit)}`}>{p.itemTexts.fit}</td>)}</tr>
              <tr><td class="row-label">④繰り返し利用</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.repeat)}`}>{p.itemTexts.repeat}</td>)}</tr>
              <tr><td class="row-label">⑤香り・展開</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.variation)}`}>{p.itemTexts.variation}</td>)}</tr>
              <tr><td class="row-label">⑥価格・コスパ</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.cost)}`}>{p.itemTexts.cost}</td>)}</tr>
              <tr><td class="row-label">価格</td>{products.map(p => <td class="compare-info">{p.price}</td>)}</tr>
              <tr><td class="row-label">タイプ</td>{products.map(p => <td class="compare-info">{p.type}</td>)}</tr>
              <tr><td class="row-label">公式サイト</td>{products.map(p => <td><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="compare-btn">公式へ →</a></td>)}</tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section section-bg" id="reviews-detail">
      <div class="container">
        <h2 class="section-title">TOP3 各商品の詳細レビュー</h2>
        {products.map(p => (
          <div class="review-detail-card" id={p.anchor}>
            <div class="rd-header"><span class={`rd-rank rd-rank-${p.rank}`}>第{p.rank}位</span><h3 class="rd-name">{p.name}</h3><div class="rd-score-block"><span class="rd-score-num">{p.score.toFixed(1)}</span><span class="rd-score-max">/ 30点</span></div></div>
            <img src={`/images/${p.img}`} alt={p.name} class="rd-hero-img" loading="lazy" />
            <div class="rd-extra-block rd-extra-block-first">
              <h4 class="rd-extra-title">こんな人におすすめ／向かない人</h4>
              <div class="rd-fit-grid">
                <div class="rd-fit-good"><p class="rd-fit-title">✓ おすすめの人</p><ul>{p.good.map(x => <li>{x}</li>)}</ul></div>
                <div class="rd-fit-bad"><p class="rd-fit-title">✗ 向かない人</p><ul>{p.bad.map(x => <li>{x}</li>)}</ul></div>
              </div>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">{p.shortName}の3つの特徴</h4>
              <div class="rd-feature-list">
                {p.features.map((f, i) => (
                  <div class="rd-feature-item"><span class="rd-feature-num">{i + 1}</span><div><p class="rd-feature-name">{f[0]}</p><p class="rd-feature-desc">{f[1]}</p></div></div>
                ))}
              </div>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">価格・購入について</h4>
              <p class="rd-warranty-text">価格は<strong>{p.price}</strong>。タイプ：{p.type}{p.duration !== '—' && p.duration !== '—（遮光・睡眠用）' ? `／${p.duration}` : ''}。</p>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">よくある質問</h4>
              <dl class="rd-mini-faq">{p.miniFaq.map(q => (<><dt>Q. {q[0]}</dt><dd>{q[1]}</dd></>))}</dl>
            </div>
            <div class="rd-cta-row"><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="rd-cta">{p.shortName}公式サイトを見る →</a></div>
          </div>
        ))}
      </div>
    </section>

    <section class="section section-bg">
      <div class="container" style="max-width: 780px;">
        <h2 class="section-title">よくある質問</h2>
        <div class="faq-list">
          {faqs.map((faq, i) => (
            <div class="faq-item" id={`faq-${i}`}>
              <button class="faq-question" aria-expanded="false" data-faq={i}><span class="faq-q-icon">Q</span><span>{faq.q}</span><span class="faq-toggle" aria-hidden="true"></span></button>
              <div class="faq-answer" hidden><span class="faq-a-icon">A</span><p>{faq.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section"><div class="container" style="max-width: var(--content-width);"><a href="/goods/" class="back-link">← 睡眠グッズ記事一覧に戻る</a></div></section>
  </main>
  <Footer />
</Layout>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answer = btn.nextElementSibling as HTMLElement;
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.classList.toggle('open', !expanded);
      answer.hidden = expanded;
    });
  });
</script>
