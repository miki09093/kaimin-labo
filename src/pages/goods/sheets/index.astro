---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import '../../../styles/goods-detail.css';

const products = [
  {
    rank: 1, name: '無印良品 オーガニックコットン ボックスシーツ', shortName: '無印 オーガニックコットン', score: 26.0,
    img: 'sheets-muji-card.png', anchor: 'muji-review',
    itemScores: { touch: 5.0, material: 5.0, fit: 4.0, care: 4.0, variation: 4.5, cost: 3.5 },
    itemTexts: { touch: '洗いざらしのやわらか肌ざわり', material: 'オーガニックコットン100%', fit: 'ゴム入りでフィット', care: '洗濯対応', variation: 'サイズ・色が豊富', cost: '2,990円〜（シングル）' },
    price: '2,990円〜（公式・シングル）', material: 'オーガニックコットン100%（洗いざらし仕上げ）', care: '洗濯対応', made: '—',
    tags: ['オーガニックコットン', '洗いざらし', '全国の店舗で買える'],
    summary: 'オーガニックコットン100%を綿本来の風合いを生かして洗いざらしで仕上げた、無印良品の定番ボックスシーツ。やわらかな肌ざわりと吸湿性で一年中快適。シンプルなデザインでどんな寝室にもなじみ、全国の店舗で買える安心感も魅力です。',
    affiliateHref: 'https://www.muji.com/jp/ja/store/cmdty/section/T20009',
    features: [
      ['オーガニックコットン100%の自然な風合い', '農薬・化学肥料の使用を抑えて栽培されたオーガニックコットンを100%使用。綿本来のやわらかさと吸湿性で、肌にやさしい仕上がりです。'],
      ['洗いざらし仕上げのやわらか肌ざわり', '綿本来の風合いを生かすために洗いざらしで仕上げ。使い始めからやわらかく、洗うほどに肌になじみます。'],
      ['一年中使える＋豊富なサイズ・カラー', '季節を問わず一年を通して快適に使用可能。サイズ・カラー展開が豊富で、シンプルなデザインはどんな寝室にもなじみます。'],
    ],
    good: ['肌ざわりのよい綿シーツが欲しい方', 'オーガニック・天然素材にこだわる方', 'シンプルなデザインが好みの方', '全国の店舗で買いたい方'],
    bad: ['速乾性の化繊シーツが欲しい方', 'とにかく最安を求める方'],
    miniFaq: [['オーガニックコットンとは？', '農薬・化学肥料の使用を抑えて栽培された綿花です。肌へのやさしさと環境配慮が特徴です。'], ['一年中使えますか？', 'はい。吸湿性に優れ、季節を問わず快適に使えます。'], ['店舗で買えますか？', '全国の無印良品店舗・公式ネットストアで購入できます。']],
  },
  {
    rank: 2, name: 'ニトリ ボックスシーツ（綿100%／Nグリップ等）', shortName: 'ニトリ ボックスシーツ', score: 24.0,
    img: 'sheets-nitori-card.png', anchor: 'nitori-review',
    itemScores: { touch: 4.0, material: 4.0, fit: 4.5, care: 4.5, variation: 5.0, cost: 5.0 },
    itemTexts: { touch: 'オーソドックスな綿の肌ざわり', material: '綿素材・接触冷感など豊富', fit: 'Nグリップでズレにくい', care: '洗濯機OK', variation: 'サイズ・色・機能が豊富', cost: '1,000円台〜の最安クラス' },
    price: '公式参照（1,000円台〜）', material: '綿素材／接触冷感（Nクール）／吸湿発熱（Nウォーム）など', care: '洗濯機OK', made: '—',
    tags: ['1,000円台〜', 'Nグリップ', 'タイプ豊富'],
    summary: '1,000円台から買えるニトリのボックスシーツ。オーソドックスな綿素材に加え、ズレにくいNグリップ、接触冷感のNクール、吸湿発熱のNウォームなど機能性タイプも豊富。掛布団カバーとのセット商品もあり、コスパ重視の方に最適です。',
    affiliateHref: 'https://www.nitori-net.jp/',
    features: [
      ['1,000円台〜の圧倒的コスパ', 'オーソドックスな綿素材のボックスシーツが1,000円台から。掛布団カバーとのセット商品も豊富で、まとめて揃えやすい価格です。'],
      ['ズレにくい「Nグリップ」など機能性', '裏面の滑り止めでマットレスからズレにくいNグリップ、接触冷感のNクール、吸湿発熱のNウォームなど、季節・用途に応じた機能性タイプが選べます。'],
      ['サイズ・カラー・機能が豊富', 'サイズ・カラー・機能の選択肢が非常に豊富。全国の店舗で実物を確認しながら選べるのも安心です。'],
    ],
    good: ['とにかくコスパを重視する方', 'ズレ防止など機能性が欲しい方', '接触冷感・吸湿発熱を季節で選びたい方', 'カバーとセットで揃えたい方'],
    bad: ['オーガニック・高級素材にこだわる方', '上質な肌ざわりを最優先する方'],
    miniFaq: [['Nグリップとは？', '裏面に滑り止めが付いており、マットレスからシーツがズレにくい仕様です。'], ['洗えますか？', '洗濯機で洗えます。'], ['価格は？', '綿素材で1,000円台〜。サイズ・機能により異なります。']],
  },
  {
    rank: 3, name: '西川 綿100% ボックスシーツ', shortName: '西川 綿100%シーツ', score: 22.0,
    img: 'sheets-nishikawa-card.png', anchor: 'nishikawa-review',
    itemScores: { touch: 4.0, material: 4.5, fit: 4.0, care: 4.0, variation: 3.5, cost: 3.5 },
    itemTexts: { touch: 'パリッとした清潔感', material: '丈夫なツイル綿100%', fit: 'ゴム入りでフィット', care: '洗濯対応', variation: '定番カラー中心', cost: '老舗ブランドの安心価格' },
    price: '公式参照（販売店により異なる）', material: '綿100%（ツイル素材など）', care: '洗濯対応', made: '—',
    tags: ['綿100%', '老舗・西川', 'パリッと清潔感'],
    summary: '創業1566年の老舗・西川による綿100%ボックスシーツ。丈夫なツイル素材でパリッとした清潔感のある風合いが特徴。ホテルのようなきちんと感を求める方や、老舗ブランドの品質・安心感を重視する方におすすめです。',
    affiliateHref: 'https://www.nishikawa-store.com/',
    features: [
      ['丈夫なツイル素材の綿100%', 'しっかりと織られたツイル素材の綿100%を採用。耐久性に優れ、洗濯を繰り返しても丈夫に使えます。'],
      ['パリッとした清潔感のある風合い', 'ホテルのシーツのようなパリッとした風合いで、きちんと感のある寝室を演出。清潔感を重視する方に好相性です。'],
      ['創業1566年・西川ブランドの安心感', '老舗・西川による品質管理。寝具専門ブランドならではの信頼感があり、長く使える定番シーツです。'],
    ],
    good: ['パリッとした清潔感が好きな方', '丈夫で長持ちするシーツが欲しい方', '老舗ブランドの品質を求める方', 'ホテルライクな寝室にしたい方'],
    bad: ['とろみのあるやわらか素材が好みの方', '最安価格を求める方'],
    miniFaq: [['ツイル素材とは？', '斜めの織り目が特徴の丈夫な織り方です。パリッとした風合いと耐久性が魅力です。'], ['洗えますか？', '家庭の洗濯機で洗えます。洗濯表示に従ってください。'], ['どこで買えますか？', '西川ストア公式・百貨店・寝具専門店・大手通販で購入できます。']],
  },
];

const guide = [
  ['①', '肌触り', '毎晩肌に触れるシーツは肌ざわりが最重要。綿の洗いざらしはやわらか、ツイルはパリッと、化繊はサラッとした感触です。', ['綿＝やわらか・吸湿性◎', 'ツイル＝パリッと清潔感', '化繊＝サラッと速乾']],
  ['②', '素材・通気性', '綿・麻などの天然素材は吸湿性に優れ、ポリエステルは速乾性が高い。季節や好みで選びます。', ['天然素材＝吸湿性が高い', '化繊＝速乾性が高い', 'オーガニックは肌にやさしい']],
  ['③', 'フィット性（ズレにくさ）', 'マットレスにぴったり合うサイズ・ゴムの強さが大切。滑り止め付きはズレにくく快適です。', ['マットレスの厚みに合うサイズ', '全周ゴム入りがフィット', '滑り止め付きはズレにくい']],
  ['④', 'お手入れ（洗える）', '直接肌に触れるシーツは週1回の洗濯が理想。洗濯機で洗えて乾きやすいものが便利です。', ['洗濯機で洗えるか', '乾きやすさ（速乾性）', 'シワになりにくいか']],
  ['⑤', 'サイズ・カラー展開', 'マットレス・敷布団のサイズに合うか、寝室に合う色があるかを確認。展開が豊富だと選びやすいです。', ['シングル〜各サイズの有無', '寝室に合うカラー', 'カバーとのセットの有無']],
  ['⑥', '価格・コスパ', '1,000円台〜と幅広い価格帯。複数枚を洗い替えで使うため、価格と品質のバランスが重要です。', ['洗い替え用に複数枚必要', '1,000円台〜の手頃な選択肢', '素材・耐久とのバランス']],
];

const faqs = [
  { q: 'ボックスシーツとフラットシーツの違いは？', a: 'ボックスシーツはマットレスにかぶせるだけの箱型でズレにくく装着が簡単。フラットシーツは1枚の平らな布で、敷き込んで使うタイプです。マットレス利用ならボックスシーツが手軽でおすすめです。' },
  { q: '綿と化繊（ポリエステル）どちらがいい？', a: '吸湿性・肌ざわりを重視するなら綿、速乾性・シワになりにくさ・低価格を重視するなら化繊（ポリエステル混）がおすすめです。汗っかきの方や肌が敏感な方は綿100%が快適です。' },
  { q: 'シーツのサイズはどう選ぶ？', a: 'マットレス（または敷布団）の「幅×長さ×厚み（マチ）」に合うサイズを選びます。特にマットレスの厚みに対してマチが浅いと装着できないため、厚みの確認が重要です。' },
  { q: 'シーツはどのくらいの頻度で洗う？', a: '週1回の洗濯が理想です。汗や皮脂が蓄積するとダニ・においの原因になります。洗い替え用に2枚以上揃えておくとローテーションできて便利です。' },
  { q: 'ズレにくいシーツはどれ？', a: '全周にゴムが入ったボックスシーツや、裏面に滑り止めが付いたタイプ（ニトリのNグリップ等）がズレにくくおすすめです。' },
];
---
<Layout
  title="ボックスシーツおすすめランキング2026｜無印・ニトリ・西川を徹底比較"
  description="ボックスシーツの人気3商品を徹底比較。無印良品・ニトリ・西川を、肌触り・素材・フィット性・お手入れ・サイズ展開・価格の6軸で30点満点採点しました。"
>
  <Header />
  <main>
    <div class="page-header"><div class="container"><Breadcrumb items={[{ label: '睡眠グッズ', href: '/goods/' }, { label: 'シーツ・カバー類' }]} /></div></div>

    <section class="hero-section"><a href="#top3"><img src="/images/sheets-hero.png" alt="ボックスシーツを徹底比較" class="hero-img" loading="eager" fetchpriority="high" /></a></section>

    <section class="section" id="top3">
      <div class="container">
        <h2 class="section-title">毎日の肌ざわりを変える シーツTOP3</h2>
        <p style="margin-bottom: 1.5rem;">「肌ざわりのよいシーツが欲しい」「ズレないシーツがいい」――そんな悩みに応える3枚を、編集部が厳選しました。</p>
        <div class="top3-list">
          {products.map(p => (
            <div class="top3-card">
              <div class="top3-header"><span class={`rank-circle rank-circle-${p.rank}`}>{p.rank}</span><p class="top3-name">{p.name}</p></div>
              <img src={`/images/${p.img}`} alt={p.name} class="top3-img" loading="lazy" />
              <div class="top3-score-row"><span class="top3-score">{p.score.toFixed(1)}</span><span class="top3-score-max">/ 30点</span></div>
              <p class="top3-price">{p.price}</p>
              <ul class="top3-tags">{p.tags.map(t => <li>#{t}</li>)}</ul>
              <p class="top3-summary">{p.summary}</p>
              <div class="top3-cta-row"><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="top3-cta-btn">公式サイトを見る →</a></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section guide-section">
      <div class="container">
        <h2 class="section-title">シーツ選びで失敗しない6つのポイント</h2>
        <p class="guide-lead">当サイトはこの6項目を5点満点・合計30点で採点しています。</p>
        <div class="guide-grid">
          {guide.map(g => (
            <div class="guide-card">
              <p class="guide-num">{g[0]}</p>
              <h3 class="guide-title">{g[1]}</h3>
              <p class="guide-text">{g[2]}</p>
              <div class="guide-check"><p class="guide-check-title">見極め方</p><ul>{(g[3] as string[]).map(c => <li>{c}</li>)}</ul></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="compare">
      <div class="container">
        <h2 class="section-title">人気シーツ 3商品 徹底比較表</h2>
        <p style="margin-bottom: 1.5rem;">当サイトの採点6項目を軸に、人気ボックスシーツ3商品を一覧で比較できます。</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <colgroup><col class="col-label" />{products.map(() => <col class="col-product" />)}</colgroup>
            <thead><tr><th class="row-label">項目</th>{products.map(p => <th>{p.shortName}</th>)}</tr></thead>
            <tbody>
              <tr><td class="row-label">総合スコア</td>{products.map(p => <td><strong class="score-total">{p.score.toFixed(1)}</strong><span class="score-max">/30点</span></td>)}</tr>
              <tr><td class="row-label">①肌触り</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.touch)}`}>{p.itemTexts.touch}</td>)}</tr>
              <tr><td class="row-label">②素材・通気性</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.material)}`}>{p.itemTexts.material}</td>)}</tr>
              <tr><td class="row-label">③フィット性</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.fit)}`}>{p.itemTexts.fit}</td>)}</tr>
              <tr><td class="row-label">④お手入れ</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.care)}`}>{p.itemTexts.care}</td>)}</tr>
              <tr><td class="row-label">⑤サイズ・色展開</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.variation)}`}>{p.itemTexts.variation}</td>)}</tr>
              <tr><td class="row-label">⑥価格・コスパ</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.cost)}`}>{p.itemTexts.cost}</td>)}</tr>
              <tr><td class="row-label">価格</td>{products.map(p => <td class="compare-info">{p.price}</td>)}</tr>
              <tr><td class="row-label">素材</td>{products.map(p => <td class="compare-info">{p.material}</td>)}</tr>
              <tr><td class="row-label">公式サイト</td>{products.map(p => <td><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="compare-btn">公式へ →</a></td>)}</tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section section-bg" id="reviews-detail">
      <div class="container">
        <h2 class="section-title">TOP3 各商品の詳細レビュー</h2>
        {products.map(p => (
          <div class="review-detail-card" id={p.anchor}>
            <div class="rd-header"><span class={`rd-rank rd-rank-${p.rank}`}>第{p.rank}位</span><h3 class="rd-name">{p.name}</h3><div class="rd-score-block"><span class="rd-score-num">{p.score.toFixed(1)}</span><span class="rd-score-max">/ 30点</span></div></div>
            <img src={`/images/${p.img}`} alt={p.name} class="rd-hero-img" loading="lazy" />
            <div class="rd-extra-block rd-extra-block-first">
              <h4 class="rd-extra-title">こんな人におすすめ／向かない人</h4>
              <div class="rd-fit-grid">
                <div class="rd-fit-good"><p class="rd-fit-title">✓ おすすめの人</p><ul>{p.good.map(x => <li>{x}</li>)}</ul></div>
                <div class="rd-fit-bad"><p class="rd-fit-title">✗ 向かない人</p><ul>{p.bad.map(x => <li>{x}</li>)}</ul></div>
              </div>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">{p.shortName}の3つの特徴</h4>
              <div class="rd-feature-list">
                {p.features.map((f, i) => (
                  <div class="rd-feature-item"><span class="rd-feature-num">{i + 1}</span><div><p class="rd-feature-name">{f[0]}</p><p class="rd-feature-desc">{f[1]}</p></div></div>
                ))}
              </div>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">価格・購入について</h4>
              <p class="rd-warranty-text">価格は<strong>{p.price}</strong>。素材：{p.material}。{p.care}。</p>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">よくある質問</h4>
              <dl class="rd-mini-faq">{p.miniFaq.map(q => (<><dt>Q. {q[0]}</dt><dd>{q[1]}</dd></>))}</dl>
            </div>
            <div class="rd-cta-row"><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="rd-cta">{p.shortName}公式サイトを見る →</a></div>
          </div>
        ))}
      </div>
    </section>

    <section class="section section-bg">
      <div class="container" style="max-width: 780px;">
        <h2 class="section-title">よくある質問</h2>
        <div class="faq-list">
          {faqs.map((faq, i) => (
            <div class="faq-item" id={`faq-${i}`}>
              <button class="faq-question" aria-expanded="false" data-faq={i}><span class="faq-q-icon">Q</span><span>{faq.q}</span><span class="faq-toggle" aria-hidden="true"></span></button>
              <div class="faq-answer" hidden><span class="faq-a-icon">A</span><p>{faq.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section"><div class="container" style="max-width: var(--content-width);"><a href="/goods/" class="back-link">← 睡眠グッズ記事一覧に戻る</a></div></section>
  </main>
  <Footer />
</Layout>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answer = btn.nextElementSibling as HTMLElement;
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.classList.toggle('open', !expanded);
      answer.hidden = expanded;
    });
  });
</script>
