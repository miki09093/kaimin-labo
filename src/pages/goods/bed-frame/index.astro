---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import '../../../styles/goods-detail.css';

const products = [
  {
    rank: 1, name: 'ニトリ すのこベッドフレーム', shortName: 'ニトリ すのこベッド', score: 26.0,
    img: 'bedframe-nitori-card.png', anchor: 'nitori-review',
    itemScores: { breath: 4.5, storage: 5.0, design: 4.0, build: 4.0, durability: 4.0, cost: 5.0 },
    itemTexts: { breath: 'すのこ仕様で通気性◎', storage: '収納付き・高さ調節タイプ豊富', design: 'ベーシックで合わせやすい', build: '組み立て式', durability: '天然木・価格相応', cost: 'コスパ最強クラス' },
    price: '公式参照（手頃な価格帯）', material: '天然木すのこ（収納・コンセント付きタイプあり）', type: 'すのこ／収納付き／高さ調節', made: '—',
    tags: ['コスパ◎', '収納付き', '全国の店舗で買える'],
    summary: '種類が豊富でコスパに優れたニトリのすのこベッド。ベッド下収納の高さが3段階調節できるタイプや、2口コンセント・棚付きのモデルなど実用性が高いラインナップ。通気性の高いすのこ仕様でカビ対策にも有効な人気No.1です。',
    affiliateHref: 'https://www.nitori-net.jp/',
    features: [
      ['すのこ仕様で通気性◎・カビ対策に', '床板がすのこ仕様で通気性が高く、湿気がこもりにくい設計。日本の高温多湿な気候でのカビ・湿気対策に有効です。'],
      ['収納・コンセント・棚など実用性が高い', 'ベッド下の収納スペースが3段階で高さ調節できるタイプや、スマホ充電に便利な2口コンセント・小物が置ける棚付きモデルなど、実用的な機能が充実しています。'],
      ['豊富なラインナップ＋コスパ最強', 'すのこ・収納付き・高さ調節など種類が非常に豊富で、価格も手頃。全国の店舗で実物を確認しながら選べる安心感もあります。'],
    ],
    good: ['コスパ重視でベッドを選びたい方', 'ベッド下収納が欲しい方', 'コンセント・棚付きの実用性を求める方', '全国の店舗で実物を見て買いたい方'],
    bad: ['高級無垢材の質感を求める方', 'デザイン性を最優先する方'],
    miniFaq: [['すのこベッドのメリットは？', '通気性が高く湿気がこもりにくいため、カビ対策に有効です。マットレスを清潔に保ちやすくなります。'], ['組み立ては必要ですか？', '基本的に組み立て式です。商品により難易度が異なります。'], ['収納付きはありますか？', '引き出し収納付き・高さ調節タイプなど豊富にあります。']],
  },
  {
    rank: 2, name: '無印良品 ベッドフレーム（すのこ）', shortName: '無印 ベッドフレーム', score: 24.0,
    img: 'bedframe-muji-card.png', anchor: 'muji-review',
    itemScores: { breath: 4.5, storage: 3.0, design: 5.0, build: 4.0, durability: 4.5, cost: 3.0 },
    itemTexts: { breath: 'すのこ仕様で通気性◎', storage: '別売り収納で拡張', design: 'ミニマルで上質', build: '組み立て式', durability: 'オーク・ウォルナット天然材', cost: '無印品質の価格帯' },
    price: '公式参照（中価格帯）', material: 'オーク材／ウォルナット材（すのこ）', type: 'すのこ（脚・収納は別売りで組み合わせ）', made: '—',
    tags: ['ミニマルデザイン', '天然木', '無印品質'],
    summary: 'ミニマルなデザインと天然素材へのこだわりが光る無印良品のベッドフレーム。素材はオークとウォルナットの2種類、スモール〜ダブルの4サイズ。シンプルで上質な佇まいはインテリアを選びません。脚の高さや収納を組み合わせてカスタマイズできます。',
    affiliateHref: 'https://www.muji.com/jp/ja/store/cmdty/section/T2030003',
    features: [
      ['ミニマルで上質な天然木デザイン', 'オーク材・ウォルナット材の2種類から選べる、シンプルで上質なデザイン。主張しすぎず、どんなインテリアにもなじみます。'],
      ['すのこ仕様で通気性に配慮', '床板はすのこ仕様で通気性に配慮。マットレスの湿気がこもりにくく、清潔に使えます。'],
      ['脚・収納を組み合わせてカスタマイズ', '脚の高さ（複数から選択）やベッド下収納（別売り）を組み合わせて、自分の暮らしに合わせてカスタマイズできるのが無印ならではの魅力です。'],
    ],
    good: ['シンプルで上質なデザインが好みの方', '天然木の質感を重視する方', 'インテリアにこだわりたい方', '脚・収納をカスタマイズしたい方'],
    bad: ['とにかく低価格を求める方', '最初から大容量収納が欲しい方'],
    miniFaq: [['素材は何ですか？', 'オーク材とウォルナット材の2種類です。'], ['サイズ展開は？', 'スモール・シングル・セミダブル・ダブルの4種類です。'], ['収納は付いていますか？', 'フレーム自体はシンプルで、収納は別売りを組み合わせて拡張できます。']],
  },
  {
    rank: 3, name: 'LOWYA（ロウヤ）ベッドフレーム', shortName: 'LOWYA ベッドフレーム', score: 21.5,
    img: 'bedframe-lowya-card.png', anchor: 'lowya-review',
    itemScores: { breath: 4.0, storage: 4.0, design: 5.0, build: 3.5, durability: 3.5, cost: 4.0 },
    itemTexts: { breath: 'すのこタイプあり', storage: '収納・コンセント付きあり', design: 'トレンド感のあるデザイン', build: '組み立て式', durability: '価格相応', cost: '通販価格でデザイン性◎' },
    price: '公式参照（通販・モデルにより異なる）', material: '木製／ファブリックなど（モデルにより異なる）', type: 'すのこ／収納付き／ローベッド など', made: '—',
    tags: ['デザイン豊富', '通販で人気', '収納付きあり'],
    summary: 'オンライン家具で人気のLOWYA（ロウヤ）のベッドフレーム。トレンド感のあるおしゃれなデザインが豊富で、すのこ・収納付き・ローベッド・宮棚付きなど選択肢が多彩。デザイン性とコスパを両立したい、通販でこだわりの一台を探す方に向いています。',
    affiliateHref: 'https://www.low-ya.com/',
    features: [
      ['トレンド感のある豊富なデザイン', 'おしゃれでトレンド感のあるデザインが豊富。ローベッド・宮棚付き・ヴィンテージ調など、好みのインテリアに合わせて選べます。'],
      ['収納・コンセント付きなど機能も充実', '引き出し収納付き・コンセント付き・宮棚付きなど、実用的な機能を備えたモデルが多数。デザインと実用性を両立できます。'],
      ['通販価格でコスパとデザインを両立', 'オンライン家具ブランドならではの価格設定で、デザイン性の高いベッドを手頃に購入可能。通販でこだわりの一台を探す方に好相性です。'],
    ],
    good: ['おしゃれなデザインを重視する方', 'ローベッド・宮棚付きが欲しい方', '通販で家具を揃えたい方', 'デザインとコスパを両立したい方'],
    bad: ['実物を店舗で確認してから買いたい方', '無垢材の高級感を求める方'],
    miniFaq: [['店舗で見られますか？', '基本はオンライン販売中心です。実物確認を重視する方は注意が必要です。'], ['組み立ては必要ですか？', '組み立て式です。モデルにより難易度が異なります。'], ['収納付きはありますか？', '引き出し収納付き・宮棚付きなど豊富にあります。']],
  },
];

const guide = [
  ['①', '通気性（すのこ）', 'マットレスの湿気を逃がす通気性は重要。すのこ仕様はカビ・湿気対策に有効で、日本の気候に適しています。', ['すのこ床板は通気性◎', '湿気・カビ対策に有効', 'マットレスを長持ちさせる']],
  ['②', '収納力', 'ベッド下のスペースを活用できると部屋が片付きます。引き出し収納や跳ね上げ式など種類があります。', ['引き出し収納で省スペース', '跳ね上げ式は大容量', '高さ調節できると便利']],
  ['③', 'デザイン', '寝室の印象を左右する重要要素。ローベッド・宮棚付き・天然木など好みのスタイルを選びます。', ['部屋に合うスタイルか', 'ロー／宮棚付きなど形状', '天然木・ファブリックなど素材感']],
  ['④', '組み立てやすさ', '多くは組み立て式。パーツ数や説明書のわかりやすさで難易度が変わります。', ['組み立て式が一般的', 'パーツ数・所要時間を確認', '組立サービスの有無']],
  ['⑤', '耐久性・素材', '長く使う家具なので耐久性も重要。無垢材は高級感と耐久性、合板はコスパに優れます。', ['天然木・無垢材は高耐久', '耐荷重もチェック', 'きしみにくい構造か']],
  ['⑥', '価格・コスパ', 'フレームのみなら数千円〜、収納・デザイン重視で数万円。マットレスと合わせた予算配分が大切です。', ['フレームのみは初期費用を抑制', '機能・デザインで価格が変動', 'マットレスとの予算バランス']],
];

const faqs = [
  { q: 'すのこベッドのメリットは？', a: '床板がすのこ状になっているため通気性が高く、マットレスや敷布団の湿気を逃がしてカビ・ダニの発生を抑えられます。日本の高温多湿な気候では特に有効で、寝具を清潔に長持ちさせられます。' },
  { q: 'ベッドフレームだけ買ってマットレスは別でもいい？', a: 'はい。フレームのみを購入してマットレスを自由に選ぶのは一般的です。初期費用を抑えられ、マットレスを自分の好みで選べるメリットがあります。当サイトのマットレスランキングもあわせてご覧ください。' },
  { q: '収納付きと収納なし、どちらがいい？', a: '部屋の収納を増やしたいなら収納付き（引き出し・跳ね上げ式）、通気性を最優先するならすのこの収納なしがおすすめです。収納付きは通気性がやや下がるため、除湿対策を併用すると安心です。' },
  { q: 'ベッドフレームの寿命は？', a: '素材や使い方によりますが、木製で7〜10年程度が目安です。きしみがひどくなった・接合部がぐらつくようになったら買い替えのサインです。' },
  { q: '組み立ては自分でできますか？', a: '多くのベッドフレームは組み立て式で、付属の説明書に沿って組み立てます。大型商品は2人での作業が安全です。組み立てサービスを提供しているショップもあります。' },
];
---
<Layout
  title="ベッドフレームおすすめランキング2026｜ニトリ・無印・LOWYAを徹底比較"
  description="ベッドフレームの人気3ブランドを徹底比較。ニトリ・無印良品・LOWYAを、通気性・収納力・デザイン・組み立て・耐久性・価格の6軸で30点満点採点しました。"
>
  <Header />
  <main>
    <div class="page-header"><div class="container"><Breadcrumb items={[{ label: '睡眠グッズ', href: '/goods/' }, { label: 'ベッドフレーム' }]} /></div></div>

    <section class="hero-section"><a href="#top3"><img src="/images/bedframe-hero.png" alt="ベッドフレームを徹底比較" class="hero-img" loading="eager" fetchpriority="high" /></a></section>

    <section class="section" id="top3">
      <div class="container">
        <h2 class="section-title">寝室の土台を選ぶ ベッドフレームTOP3</h2>
        <p style="margin-bottom: 1.5rem;">「通気性のよいベッドが欲しい」「収納も欲しい」「おしゃれなデザインがいい」――そんな悩みに応える3ブランドを編集部が厳選しました。</p>
        <div class="top3-list">
          {products.map(p => (
            <div class="top3-card">
              <div class="top3-header"><span class={`rank-circle rank-circle-${p.rank}`}>{p.rank}</span><p class="top3-name">{p.name}</p></div>
              <img src={`/images/${p.img}`} alt={p.name} class="top3-img" loading="lazy" />
              <div class="top3-score-row"><span class="top3-score">{p.score.toFixed(1)}</span><span class="top3-score-max">/ 30点</span></div>
              <p class="top3-price">{p.price}</p>
              <ul class="top3-tags">{p.tags.map(t => <li>#{t}</li>)}</ul>
              <p class="top3-summary">{p.summary}</p>
              <div class="top3-cta-row"><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="top3-cta-btn">公式サイトを見る →</a></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section guide-section">
      <div class="container">
        <h2 class="section-title">ベッドフレーム選びで失敗しない6つのポイント</h2>
        <p class="guide-lead">当サイトはこの6項目を5点満点・合計30点で採点しています。</p>
        <div class="guide-grid">
          {guide.map(g => (
            <div class="guide-card">
              <p class="guide-num">{g[0]}</p>
              <h3 class="guide-title">{g[1]}</h3>
              <p class="guide-text">{g[2]}</p>
              <div class="guide-check"><p class="guide-check-title">見極め方</p><ul>{(g[3] as string[]).map(c => <li>{c}</li>)}</ul></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="compare">
      <div class="container">
        <h2 class="section-title">人気ベッドフレーム 3ブランド 徹底比較表</h2>
        <p style="margin-bottom: 1.5rem;">当サイトの採点6項目を軸に、人気ベッドフレーム3ブランドを一覧で比較できます。</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <colgroup><col class="col-label" />{products.map(() => <col class="col-product" />)}</colgroup>
            <thead><tr><th class="row-label">項目</th>{products.map(p => <th>{p.shortName}</th>)}</tr></thead>
            <tbody>
              <tr><td class="row-label">総合スコア</td>{products.map(p => <td><strong class="score-total">{p.score.toFixed(1)}</strong><span class="score-max">/30点</span></td>)}</tr>
              <tr><td class="row-label">①通気性</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.breath)}`}>{p.itemTexts.breath}</td>)}</tr>
              <tr><td class="row-label">②収納力</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.storage)}`}>{p.itemTexts.storage}</td>)}</tr>
              <tr><td class="row-label">③デザイン</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.design)}`}>{p.itemTexts.design}</td>)}</tr>
              <tr><td class="row-label">④組み立て</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.build)}`}>{p.itemTexts.build}</td>)}</tr>
              <tr><td class="row-label">⑤耐久性・素材</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.durability)}`}>{p.itemTexts.durability}</td>)}</tr>
              <tr><td class="row-label">⑥価格・コスパ</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.cost)}`}>{p.itemTexts.cost}</td>)}</tr>
              <tr><td class="row-label">価格</td>{products.map(p => <td class="compare-info">{p.price}</td>)}</tr>
              <tr><td class="row-label">タイプ</td>{products.map(p => <td class="compare-info">{p.type}</td>)}</tr>
              <tr><td class="row-label">公式サイト</td>{products.map(p => <td><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="compare-btn">公式へ →</a></td>)}</tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section section-bg" id="reviews-detail">
      <div class="container">
        <h2 class="section-title">TOP3 各ブランドの詳細レビュー</h2>
        {products.map(p => (
          <div class="review-detail-card" id={p.anchor}>
            <div class="rd-header"><span class={`rd-rank rd-rank-${p.rank}`}>第{p.rank}位</span><h3 class="rd-name">{p.name}</h3><div class="rd-score-block"><span class="rd-score-num">{p.score.toFixed(1)}</span><span class="rd-score-max">/ 30点</span></div></div>
            <img src={`/images/${p.img}`} alt={p.name} class="rd-hero-img" loading="lazy" />
            <div class="rd-extra-block rd-extra-block-first">
              <h4 class="rd-extra-title">こんな人におすすめ／向かない人</h4>
              <div class="rd-fit-grid">
                <div class="rd-fit-good"><p class="rd-fit-title">✓ おすすめの人</p><ul>{p.good.map(x => <li>{x}</li>)}</ul></div>
                <div class="rd-fit-bad"><p class="rd-fit-title">✗ 向かない人</p><ul>{p.bad.map(x => <li>{x}</li>)}</ul></div>
              </div>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">{p.shortName}の3つの特徴</h4>
              <div class="rd-feature-list">
                {p.features.map((f, i) => (
                  <div class="rd-feature-item"><span class="rd-feature-num">{i + 1}</span><div><p class="rd-feature-name">{f[0]}</p><p class="rd-feature-desc">{f[1]}</p></div></div>
                ))}
              </div>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">価格・購入について</h4>
              <p class="rd-warranty-text">価格は<strong>{p.price}</strong>。素材：{p.material}／タイプ：{p.type}。</p>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">よくある質問</h4>
              <dl class="rd-mini-faq">{p.miniFaq.map(q => (<><dt>Q. {q[0]}</dt><dd>{q[1]}</dd></>))}</dl>
            </div>
            <div class="rd-cta-row"><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="rd-cta">{p.shortName}公式サイトを見る →</a></div>
          </div>
        ))}
      </div>
    </section>

    <section class="section section-bg">
      <div class="container" style="max-width: 780px;">
        <h2 class="section-title">よくある質問</h2>
        <div class="faq-list">
          {faqs.map((faq, i) => (
            <div class="faq-item" id={`faq-${i}`}>
              <button class="faq-question" aria-expanded="false" data-faq={i}><span class="faq-q-icon">Q</span><span>{faq.q}</span><span class="faq-toggle" aria-hidden="true"></span></button>
              <div class="faq-answer" hidden><span class="faq-a-icon">A</span><p>{faq.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section"><div class="container" style="max-width: var(--content-width);"><a href="/goods/" class="back-link">← 睡眠グッズ記事一覧に戻る</a></div></section>
  </main>
  <Footer />
</Layout>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answer = btn.nextElementSibling as HTMLElement;
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.classList.toggle('open', !expanded);
      answer.hidden = expanded;
    });
  });
</script>
