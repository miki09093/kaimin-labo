---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import '../../../styles/goods-detail.css';

const products = [
  {
    rank: 1, name: 'エアウィーヴ スマート01', shortName: 'エアウィーヴ スマート01', score: 26.0,
    img: 'topper-airweave-card.png', anchor: 'airweave-review',
    itemScores: { feel: 4.5, support: 4.5, breath: 5.0, care: 5.0, durability: 4.5, cost: 2.5 },
    itemTexts: { feel: '高反発で寝返りラク', support: 'エアファイバーで体圧分散', breath: '空気が通り通気性抜群', care: '中材まで水洗いOK', durability: '30日間お試し可能', cost: '38,500円〜（やや高め）' },
    price: '38,500円〜（公式・シングル）', material: 'エアファイバー（高反発）', thickness: '約4cm（エアファイバー約3cm）', care: 'カバー・中材ともに洗える', warranty: '30日間お試し可能',
    tags: ['高反発', '本体水洗いOK', '30日お試し'],
    summary: '今あるマットレスや敷布団に重ねるだけで寝心地を格上げできる高反発トッパー。エアファイバーで通気性抜群＋カバー・中材ともに洗えて清潔。薄型で折りたためる収納性と30日間お試しの安心感も魅力の人気No.1モデルです。',
    affiliateHref: 'https://sleep.airweave.jp/products/mattresspad-smart01',
    features: [
      ['独自素材エアファイバーで高反発＋通気性', '90%以上が空気でできたエアファイバーを使用。寝返りが打ちやすい高反発で、通気性も抜群。湿気がこもりにくくカビ・ダニの心配が少ない素材です。'],
      ['中材まで水洗いできる衛生設計', 'カバーはもちろん、エアファイバーの中材まで水洗い可能。汗をかきやすい方や衛生面を重視する方でも、いつでも清潔に保てます。'],
      ['重ねるだけで寝心地を格上げ＋30日お試し', '今使っている敷布団やマットレスの上に重ねるだけで、底つき感や硬さを改善。厚さ約4cmで薄型のため折りたたみ・収納もしやすく、30日間のお試し期間付きで安心して導入できます。'],
    ],
    good: ['今の寝具の寝心地を手軽に改善したい方', '高反発で寝返りをラクにしたい方', 'カビ・ダニが心配な方', '本体まで丸洗いしたい衛生重視の方'],
    bad: ['予算を抑えたい方', '低反発の包まれる寝心地が好みの方'],
    miniFaq: [['今のマットレスに重ねて使えますか？', 'はい。敷布団・マットレスの上に重ねて使うトッパーです。底つき感や硬さの改善に効果的です。'], ['洗えますか？', 'エアファイバーの中材まで水洗いできます。速乾性も高い設計です。'], ['厚みはどのくらい？', 'スマートシリーズは約4cm前後。重ねて使うのに適した厚みです。']],
  },
  {
    rank: 2, name: 'トゥルースリーパー プレミアケア', shortName: 'トゥルースリーパー プレミアケア', score: 24.0,
    img: 'topper-truesleeper-card.png', anchor: 'truesleeper-review',
    itemScores: { feel: 4.0, support: 4.0, breath: 3.0, care: 3.0, durability: 4.0, cost: 4.0 },
    itemTexts: { feel: '低反発で体に沿う', support: '体圧分散でフィット', breath: '低反発のため通気は標準', care: 'カバー洗濯OK', durability: '抗菌・防カビ・防ダニ', cost: '27,280円（公式・S）' },
    price: '27,280円（公式・シングル）', material: '低反発ウレタン', thickness: '約5cm', care: 'カバー洗濯OK／本体は陰干し', warranty: '抗菌・防カビ・防ダニ仕様',
    tags: ['低反発', '抗菌防カビ防ダニ', '大ヒット商品'],
    summary: 'TVショッピングでおなじみの大ヒット低反発トッパー。厚さ約5cmの低反発ウレタンが体の凹凸に沿ってフィットし、肩・腰の負担をやわらげます。抗菌・防カビ・防ダニ仕様で衛生面にも配慮。低反発の包まれる寝心地が好きな方に。',
    affiliateHref: 'https://www.shopjapan.co.jp/products/TRCS-00000/',
    features: [
      ['厚さ約5cmの低反発ウレタンで体にフィット', '体の凹凸に沿ってゆっくり沈み込む低反発ウレタンを採用。肩や腰など一点に集中しがちな体圧を分散し、負担をやわらげます。'],
      ['抗菌・防カビ・防ダニ仕様で衛生的', '従来の「プレミアム」に抗菌・防カビ・防ダニ機能を加えたモデル。清潔に快適に使えるよう配慮されています。'],
      ['硬いマットレスの上に重ねて寝心地改善', '硬すぎる寝具の上に重ねることで、やわらかな寝心地に。シングル27,280円と本格トッパーでは手の届きやすい価格です。'],
    ],
    good: ['低反発の包まれる寝心地が好きな方', '今の寝具が硬すぎると感じる方', '抗菌・防カビ・防ダニを重視する方', '手頃な価格で試したい方'],
    bad: ['高反発で寝返りをラクにしたい方', '本体を丸洗いしたい方', '通気性を最重視する方'],
    miniFaq: [['厚みとサイズは？', 'シングルは厚さ約5cm×幅97×長さ195cm。S/SD/D/Qの4サイズ展開です。'], ['本体は洗えますか？', '本体は洗濯不可で、カバーのみ洗濯できます。本体は陰干しでケアします。'], ['価格は？', 'シングル27,280円（公式）です。']],
  },
  {
    rank: 3, name: 'ニトリ マットレストッパー', shortName: 'ニトリ トッパー', score: 20.0,
    img: 'topper-nitori-card.png', anchor: 'nitori-review',
    itemScores: { feel: 3.5, support: 3.5, breath: 3.5, care: 3.5, durability: 3.0, cost: 5.0 },
    itemTexts: { feel: '高反発・低反発から選べる', support: '標準的な体圧分散', breath: 'タイプにより異なる', care: 'カバー洗濯OK', durability: '価格相応', cost: '7,990円〜の最安クラス' },
    price: '7,990円〜（高反発・シングル）', material: 'ウレタンフォーム（高反発／低反発）', thickness: '約2.5〜6cm（タイプによる）', care: 'カバー洗濯OK', warranty: '—',
    tags: ['全国の店舗で買える', 'コスパ◎', 'タイプ豊富'],
    summary: '全国のニトリ店舗で手軽に買える低価格トッパー。高反発・低反発などタイプが豊富で、予算を抑えて寝心地を改善したい方に最適。実物を店舗で確認してから買えるのも安心。「まずは手軽に試したい」方の入門用に。',
    affiliateHref: 'https://www.nitori-net.jp/',
    features: [
      ['手頃な価格でタイプが豊富', '高反発・低反発・三つ折りなど多彩なラインナップ。予算と好みに合わせて選べ、価格も手頃です。'],
      ['全国の店舗で実物を確認できる', '全国のニトリ店舗で実物の硬さ・厚みを確認してから購入可能。通販で失敗したくない方にも安心です。'],
      ['まず手軽に試したい方の入門用', '本格的な専門トッパーの前に「まず試してみたい」という方にぴったり。気軽に買い替えできる価格帯です。'],
    ],
    good: ['予算を抑えてトッパーを試したい方', '全国の店舗で実物を見て買いたい方', '高反発・低反発を選びたい方', '一人暮らし・来客用に'],
    bad: ['専門ブランドの高機能を求める方', '長期耐久性を最重視する方'],
    miniFaq: [['どんなタイプがありますか？', '高反発・低反発・三つ折りなど複数のタイプがあります。店舗・公式サイトでご確認ください。'], ['洗えますか？', 'カバーは洗濯できます。本体はタイプにより異なります。'], ['価格は？', 'サイズ・タイプにより異なります。手頃な価格帯が中心です。']],
  },
];

const guide = [
  ['①', '寝心地（硬さ・反発力）', '高反発は寝返りがラクで腰痛対策向き、低反発は体に沿う包まれる寝心地。今の寝具の不満に合わせて選びます。', ['硬すぎる寝具には低反発トッパー', 'やわらかすぎる寝具には高反発トッパー', '体重・寝姿勢に合った硬さを']],
  ['②', '体圧分散性', '肩・腰の沈み込みを防ぎ自然な寝姿勢を保つ力。エアファイバーや高反発ウレタンが体圧を分散します。', ['一点に圧が集中しないか', '構造・素材で体圧分散性を確認', '寝返りのしやすさもチェック']],
  ['③', '通気性・蒸れにくさ', '寝床にこもる湿気を逃がす力。エアファイバー系は通気性◎、低反発ウレタンはやや劣ります。', ['エアファイバー＝通気性◎', '低反発ウレタンは通気△', '夏場の蒸れが気になる人は重視']],
  ['④', 'お手入れ（洗える）', '毎日使うものなので衛生面も重要。本体まで洗えるタイプなら清潔に保てます。', ['本体丸洗いOK（エアファイバー系）', 'カバーが取り外して洗える', '速乾性のある素材か']],
  ['⑤', '厚み', '重ねて使うトッパーは3〜5cmが目安。底つき感を改善したいなら厚めを選びます。', ['底つき感改善なら5cm前後', '薄手は寝心地の微調整向き', '今の寝具との合計の高さも考慮']],
  ['⑥', '価格・コスパ', '数千円〜3万円台と幅広い価格帯。マットレス買い替えより安く寝心地を改善できるのが魅力です。', ['本体買い替えより低コスト', '機能と価格のバランスで判断', '使用年数で割って考える']],
];

const faqs = [
  { q: 'マットレストッパーとは何ですか？', a: '今使っているマットレスや敷布団の上に重ねて使う、厚さ3〜5cm程度の薄い寝具です。底つき感の改善・硬さの調整・寝心地の格上げを、本体を買い替えずに手軽に実現できます。' },
  { q: '高反発と低反発、どちらを選べばいい？', a: '寝返りのしやすさ・腰痛対策を重視するなら高反発、体に沿う包まれる寝心地が好きなら低反発がおすすめです。今の寝具が「硬すぎる」なら低反発、「やわらかすぎる・沈む」なら高反発で改善できます。' },
  { q: 'トッパーだけで床に直接敷けますか？', a: 'トッパーは薄いため、床や畳に直接敷くと底つき感が出ます。必ずマットレスや敷布団の上に重ねて使ってください。' },
  { q: 'トッパーの寿命はどれくらい？', a: 'ウレタン系で3〜5年、エアファイバー系で長めが目安です。へたりが出て寝心地が変わってきたら買い替えのサインです。' },
  { q: 'お手入れ方法は？', a: 'エアファイバー系は本体を水洗いできます。ウレタン系は本体は陰干しし、カバーを洗濯します。定期的に立てかけて湿気を逃がすと長持ちします。' },
];
---
<Layout
  title="マットレストッパーおすすめランキング2026｜重ねるだけで寝心地改善"
  description="マットレストッパーの人気3商品を徹底比較。エアウィーヴ・トゥルースリーパー・ニトリを、寝心地・体圧分散・通気性・お手入れ・厚み・価格の6軸で30点満点採点しました。"
>
  <Header />
  <main>
    <div class="page-header"><div class="container"><Breadcrumb items={[{ label: '睡眠グッズ', href: '/goods/' }, { label: 'マットレストッパー' }]} /></div></div>

    <section class="hero-section"><a href="#top3"><img src="/images/topper-hero.png" alt="マットレストッパーを徹底比較" class="hero-img" loading="eager" fetchpriority="high" /></a></section>

    <section class="section" id="top3">
      <div class="container">
        <h2 class="section-title">重ねるだけで寝心地改善 トッパーTOP3</h2>
        <p style="margin-bottom: 1.5rem;">「今のマットレスが合わない」「買い替えはお金がかかる」――そんな悩みを手軽に解決する3枚を、編集部が厳選しました。</p>
        <div class="top3-list">
          {products.map(p => (
            <div class="top3-card">
              <div class="top3-header"><span class={`rank-circle rank-circle-${p.rank}`}>{p.rank}</span><p class="top3-name">{p.name}</p></div>
              <img src={`/images/${p.img}`} alt={p.name} class="top3-img" loading="lazy" />
              <div class="top3-score-row"><span class="top3-score">{p.score.toFixed(1)}</span><span class="top3-score-max">/ 30点</span></div>
              <p class="top3-price">{p.price}</p>
              <ul class="top3-tags">{p.tags.map(t => <li>#{t}</li>)}</ul>
              <p class="top3-summary">{p.summary}</p>
              <div class="top3-cta-row"><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="top3-cta-btn">公式サイトを見る →</a></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section guide-section">
      <div class="container">
        <h2 class="section-title">トッパー選びで失敗しない6つのポイント</h2>
        <p class="guide-lead">当サイトはこの6項目を5点満点・合計30点で採点しています。</p>
        <div class="guide-grid">
          {guide.map(g => (
            <div class="guide-card">
              <p class="guide-num">{g[0]}</p>
              <h3 class="guide-title">{g[1]}</h3>
              <p class="guide-text">{g[2]}</p>
              <div class="guide-check"><p class="guide-check-title">見極め方</p><ul>{(g[3] as string[]).map(c => <li>{c}</li>)}</ul></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="compare">
      <div class="container">
        <h2 class="section-title">人気トッパー 3商品 徹底比較表</h2>
        <p style="margin-bottom: 1.5rem;">当サイトの採点6項目を軸に、人気トッパー3商品を一覧で比較できます。</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <colgroup><col class="col-label" />{products.map(() => <col class="col-product" />)}</colgroup>
            <thead><tr><th class="row-label">項目</th>{products.map(p => <th>{p.shortName}</th>)}</tr></thead>
            <tbody>
              <tr><td class="row-label">総合スコア</td>{products.map(p => <td><strong class="score-total">{p.score.toFixed(1)}</strong><span class="score-max">/30点</span></td>)}</tr>
              <tr><td class="row-label">①寝心地</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.feel)}`}>{p.itemTexts.feel}</td>)}</tr>
              <tr><td class="row-label">②体圧分散</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.support)}`}>{p.itemTexts.support}</td>)}</tr>
              <tr><td class="row-label">③通気性</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.breath)}`}>{p.itemTexts.breath}</td>)}</tr>
              <tr><td class="row-label">④お手入れ</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.care)}`}>{p.itemTexts.care}</td>)}</tr>
              <tr><td class="row-label">⑤耐久性</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.durability)}`}>{p.itemTexts.durability}</td>)}</tr>
              <tr><td class="row-label">⑥価格・コスパ</td>{products.map(p => <td class={`score-cell-bg score-bg-${Math.round(p.itemScores.cost)}`}>{p.itemTexts.cost}</td>)}</tr>
              <tr><td class="row-label">価格</td>{products.map(p => <td class="compare-info">{p.price}</td>)}</tr>
              <tr><td class="row-label">素材</td>{products.map(p => <td class="compare-info">{p.material}</td>)}</tr>
              <tr><td class="row-label">厚み</td>{products.map(p => <td class="compare-info">{p.thickness}</td>)}</tr>
              <tr><td class="row-label">公式サイト</td>{products.map(p => <td><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="compare-btn">公式へ →</a></td>)}</tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section section-bg" id="reviews-detail">
      <div class="container">
        <h2 class="section-title">TOP3 各商品の詳細レビュー</h2>
        {products.map(p => (
          <div class="review-detail-card" id={p.anchor}>
            <div class="rd-header"><span class={`rd-rank rd-rank-${p.rank}`}>第{p.rank}位</span><h3 class="rd-name">{p.name}</h3><div class="rd-score-block"><span class="rd-score-num">{p.score.toFixed(1)}</span><span class="rd-score-max">/ 30点</span></div></div>
            <img src={`/images/${p.img}`} alt={p.name} class="rd-hero-img" loading="lazy" />
            <div class="rd-extra-block rd-extra-block-first">
              <h4 class="rd-extra-title">こんな人におすすめ／向かない人</h4>
              <div class="rd-fit-grid">
                <div class="rd-fit-good"><p class="rd-fit-title">✓ おすすめの人</p><ul>{p.good.map(x => <li>{x}</li>)}</ul></div>
                <div class="rd-fit-bad"><p class="rd-fit-title">✗ 向かない人</p><ul>{p.bad.map(x => <li>{x}</li>)}</ul></div>
              </div>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">{p.shortName}の3つの特徴</h4>
              <div class="rd-feature-list">
                {p.features.map((f, i) => (
                  <div class="rd-feature-item"><span class="rd-feature-num">{i + 1}</span><div><p class="rd-feature-name">{f[0]}</p><p class="rd-feature-desc">{f[1]}</p></div></div>
                ))}
              </div>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">価格・購入について</h4>
              <p class="rd-warranty-text">価格は<strong>{p.price}</strong>。素材：{p.material}／厚み：{p.thickness}。{p.warranty && `（${p.warranty}）`}</p>
            </div>
            <div class="rd-extra-block">
              <h4 class="rd-extra-title">よくある質問</h4>
              <dl class="rd-mini-faq">{p.miniFaq.map(q => (<><dt>Q. {q[0]}</dt><dd>{q[1]}</dd></>))}</dl>
            </div>
            <div class="rd-cta-row"><a href={p.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="rd-cta">{p.shortName}公式サイトを見る →</a></div>
          </div>
        ))}
      </div>
    </section>

    <section class="section section-bg">
      <div class="container" style="max-width: 780px;">
        <h2 class="section-title">よくある質問</h2>
        <div class="faq-list">
          {faqs.map((faq, i) => (
            <div class="faq-item" id={`faq-${i}`}>
              <button class="faq-question" aria-expanded="false" data-faq={i}><span class="faq-q-icon">Q</span><span>{faq.q}</span><span class="faq-toggle" aria-hidden="true"></span></button>
              <div class="faq-answer" hidden><span class="faq-a-icon">A</span><p>{faq.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section"><div class="container" style="max-width: var(--content-width);"><a href="/goods/" class="back-link">← 睡眠グッズ記事一覧に戻る</a></div></section>
  </main>
  <Footer />
</Layout>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answer = btn.nextElementSibling as HTMLElement;
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.classList.toggle('open', !expanded);
      answer.hidden = expanded;
    });
  });
</script>
