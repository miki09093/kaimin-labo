---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const clinics = [
  {
    rank: 1,
    name: 'ディオクリニック',
    catchphrase: 'ダイエット人生を、終わらせよう。',
    score: 4.9,
    star: '★★★★★',
    tags: ['累計外来80万件', '通院者の99%が成果実感', '12ヶ月分0円キャンペーン'],
    points: [
      '脂肪冷却・医療EMS・医療ハイフ・GLP-1注射など豊富な施術メニュー',
      '医師＋管理栄養士監修のオーダーメイドプラン',
      '初回9,800円〜・12ヶ月分0円のキャンペーン実施中',
    ],
    price: '初回 9,800円〜',
    counsel: '無料カウンセリング受付中',
    feature: '医療痩身フルラインナップ',
    color: '#FFD700',
    affiliateHref: 'https://dioclinic.jp/lp2-s/',
    osusume: ['本気で結果を出したい方', '医療痩身を幅広く試したい方', '医師の専門的サポートを受けたい方'],
  },
  {
    rank: 2,
    name: 'リエートクリニック',
    catchphrase: '繰り返すリバウンドと、お別れ。',
    score: 4.7,
    star: '★★★★★',
    tags: ['横浜・名古屋・池袋3院', '体質改善アプローチ', '15ヶ月0円キャンペーン'],
    points: [
      '細胞レベルでアプローチし「太りにくい体質」へ',
      '週1回の通院で2週間前後から効果が期待できる設計',
      '無料カウンセリング＋15ヶ月0円キャンペーンで始めやすい',
    ],
    price: 'カウンセリング無料',
    counsel: '無料カウンセリング受付中',
    feature: 'リバウンド対策に特化',
    color: '#C0C0C0',
    affiliateHref: 'https://lietoclinic.com/lpbot/lpbot07b18',
    osusume: ['リバウンドを繰り返してきた方', '体質から変えたい方', '横浜・名古屋・池袋エリアの方'],
  },
  {
    rank: 3,
    name: 'ファイヤークリニック',
    catchphrase: '我慢しないダイエット、はじめる。',
    score: 4.6,
    star: '★★★★★',
    tags: ['新宿・渋谷・銀座・名古屋4院', '2ヶ月平均-8kg', 'リバウンド率の低さに自信'],
    points: [
      'GLP-1注射・カベリン・医療EMS・薬・食事の5本柱「FIREメソッド」',
      '医師＋管理栄養士によるオーダーメイド施術＆処方',
      '月額4,200円〜の手の届きやすい料金プラン',
    ],
    price: '月額 4,200円〜',
    counsel: '無料カウンセリング受付中',
    feature: '5本柱の独自メソッド',
    color: '#CD7F32',
    affiliateHref: 'https://fire-method.com/lp/af_a8/',
    osusume: ['部分痩せもしたい方', '食事制限のストレスを避けたい方', '都心エリア（新宿・渋谷・銀座）の方'],
  },
];

const dioReviews = [
  '予算の関係で3ヶ月（私は約100万でしたが条件やコースによって色々変動するようです）と短いコースではありましたが、ストレスなく8キロ痩せることができました！みなさん親切で丁寧なスタッフさんで、女性の方は患者と同じ薬を服用している、あるいは服用した経験のある方が多いようで、みなさんお綺麗でした。説明を聞きにいった初回の対応をしてくださった方と、栄養士さんが特に女性から好かれる人柄でした。院内もとても綺麗でした。広告で謳われているほどの破格の値段ではありませんが、ほぼ努力や我慢もなくこの金額でこの成果なら妥当な金額だと思います。金銭的に余裕ができたらまた通いたいです。',
  'ネットのモニター広告を見て、試しに行ってみたところ、親身に相談にのって頂き、施術を受ける事になりました。思いの外順調に体重が落ちていて、初めて良かったと思っています。このまま、理想の体重を目指したいと思います。',
  '施術や食事指導など説明が分かりやすく、分からなくても最後に質問を聞いてくれる。小さいことでも真剣に聞いてくれるから相談しやすかった。施術も体の負担に寄り添いながら実施して頂けたので不安は無かった。計画以上の減量が出来て、とても満足。今までギリギリで着用していたパンツにゆとりが出来て減量の実感があった。',
  'スタッフの方が皆さん優しかったです。医療ダイエットは色々と不安な面も多かったのですが、色々とお声かけいただいて、安心して施術を受けることができました。目標体重をかなり大きく設定したので、目標達成とまではいきませんでしたが、標準体型までは戻せたのと、かなり見た目に変化があった（めっちゃ痩せたね！と言われる）ので概ね満足です。スケジュールの変動がかなりある職種のため、予約の変更が簡単に行えたのもよかったです。',
  '20代の体型が復活しました！！！自分に自信を取り戻せました。今まで色々なダイエットに失敗してはお金を無駄にしてきましたが、このクリニックに通う決断をした自分を褒めてあげたいです。4ヶ月のコースを終え、期待以上の結果に「満足×100」の気持ちです！以前は体型のせいで昔の友人に会うのが嫌で避けていましたが、今は自信を持って会えるようになりました。履けなくなったパンツがまた履けるようになり、20代の頃の体型に戻れたことが本当に嬉しいです。自炊をしない私に、管理栄養士さんが無理なく続けられる情報をたくさんくださったおかげで、一度も挫折することなく、一生モノの知識も身につきました。最初は半信半疑でしたが、あの時思い切って一歩踏み出して本当に良かったです。',
  '健康診断で脂質異常が出たことと、写真で見る自分の姿に落胆して、ダイエット目的で通いました。リベルサスによる食欲抑制・減退がかなりメンタル的につらかったですが、おかげさまで数値も見た目も劇的に変化しました。何よりスタッフの皆さまが本当にお綺麗で優しくて、毎回通院が楽しみでした😊 当初は少しでも痩せられたらという気持ちでしたが、大きな変化を与えてもらえたので満足しております。スタッフの皆さまにも大変感謝しています。どうもありがとうございました✨💫',
  '駅近で通いやすく、クリニック内もとても綺麗です。スタッフの皆さんとてもフレンドリーで相談もしやすく楽しく通えました。自分の食欲を抑える薬とカロリー計算のアプリには助けられて薬をなくしてもアプリのおかげで普通の日はそれなりにコントロールできてると思っています。あまり我慢が効かない私なので健康的に苦労せずにコンスタントに痩せるには良かったと思う。',
];

const faqs = [
  { q: '医療ダイエットとはどんな治療ですか？', a: '医療機関で行うダイエット治療です。脂肪冷却・医療EMS・GLP-1受容体作動薬・脂肪溶解注射など、医師の管理のもとで行う痩身アプローチを指します。自己流の食事制限・運動と異なり、医学的根拠と医師のサポートが受けられるのが特徴です。' },
  { q: '本当に痩せますか？効果は人によって違いますか？', a: '効果には個人差があります。医療ダイエットは医学的なアプローチでサポートしますが、生活習慣や体質、目標により結果は異なります。各クリニックでは無料カウンセリングを実施しているので、まずは現状の体型・目標に合わせた治療プランを相談することをおすすめします。' },
  { q: 'カウンセリングは無料ですか？無理な勧誘はありませんか？', a: '本ページで紹介する3クリニックはいずれも無料カウンセリングを実施しています。カウンセリングは現状の体型・目標・予算などを医師と相談する場で、その場で契約する義務はありません。納得してから治療を開始できます。' },
  { q: '料金はどのくらいかかりますか？', a: 'クリニック・施術内容・期間により異なります。ディオクリニックは初回9,800円〜、ファイヤークリニックは月額4,200円〜の料金プランを提供。詳しい総額は無料カウンセリングで施術プランを相談してから決まります。各社で「○ヶ月0円」などのキャンペーンも実施中です。' },
  { q: '副作用やリスクはありますか？', a: '医療行為のため、施術内容によっては副作用が出る可能性があります。医師が事前に詳しく説明したうえで治療を進めるため、不安な点はカウンセリング時に必ず確認しましょう。健康状態によっては施術を受けられない場合もあります。' },
  { q: '通院頻度はどのくらいですか？', a: 'クリニック・施術内容により異なります。一般的に週1回程度の通院が目安ですが、施術メニューによっては月1〜2回の場合もあります。カウンセリング時に通いやすさを確認することが大切です。' },
];
---
<Layout
  title="メディダイエット比較ラボ｜医療ダイエット人気3クリニックを徹底比較"
  description="医療ダイエット人気3クリニック（ディオクリニック・リエートクリニック・ファイヤークリニック）を徹底比較。料金・施術内容・実績で選べる、本気で痩せたい方のための比較サイトです。"
>
  <Header />
  <main>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <a href="#ranking" class="hero-img-link" aria-label="人気クリニックランキングへ">
        <img src="/images/hero-mv.png" alt="医療の力で本気で痩せる 医療ダイエット人気3クリニック徹底比較" class="hero-img" loading="eager" fetchpriority="high" />
      </a>
    </section>

    <!-- ===== 当サイトおすすめクリニック ===== -->
    <section class="osusume-section">
      <div class="container container-sm">
        <p class="osusume-heading">
          <span class="osusume-heading-deco">/</span>
          当サイトおすすめクリニック
          <span class="osusume-heading-deco">\</span>
        </p>
        <div class="osusume-card">
          <div class="osusume-top">
            <div class="osusume-logo-wrap">
              <img src="/images/dio-logo.jpg" alt="ディオクリニック ロゴ" class="osusume-logo" loading="lazy" />
            </div>
            <div class="osusume-text">
              <h2 class="osusume-name">ディオクリニック</h2>
              <p class="osusume-desc">
                <strong>外来実績80万件以上<span class="ref">※</span>。</strong><br />
                LINEであなただけのプラン・料金がわかる
              </p>
            </div>
          </div>
          <p class="osusume-cta-sub">＼ LINEで簡単30秒・完全無料 ／</p>
          <a href="#" class="osusume-cta" aria-label="ディオクリニック 無料プラン診断へ">
            <span class="osusume-cta-text">無料プラン診断へ</span>
            <span class="osusume-cta-arrow">→</span>
          </a>
        </div>
        <p class="osusume-note">※ 2020年11月〜2026年2月の累計</p>

      </div>
    </section>

    <!-- ===== 選び方ポイント ===== -->
    <section class="section section-bg" id="howto">
      <div class="container">

        <!-- 添付風の見出し -->
        <div class="ad-heading ad-heading-single">
          <p class="ad-heading-main">後悔しない「医療ダイエット」<br />クリニックの選び方</p>
        </div>

        <!-- 見出し直下のアイメージ画像 -->
        <div class="howto-mv">
          <img src="/images/howto-mv.png" alt="クリニック選びのポイント" loading="lazy" onerror="this.style.display='none'" />
        </div>

        <div class="howto-grid">

          <div class="howto-card">
            <div class="howto-num">1</div>
            <h3 class="howto-title">豊富な施術メニューでオーダーメイドプランが組めるか</h3>
            <p class="howto-desc">体質や生活習慣は人によって異なるため、<strong>内服薬から医療機器、食事指導まで「治療の選択肢が豊富」</strong>なクリニックを選びましょう。</p>
            <p class="howto-desc">マニュアル通りの処方ではなく、<strong>遺伝子検査のデータに基づいて「なぜその治療が有効なのか」</strong>を論理的に説明し、オーダーメイドのプランを提案してくれるかが鍵となります。</p>
          </div>

          <div class="howto-card">
            <div class="howto-num">2</div>
            <h3 class="howto-title">料金の総額がわかるか？</h3>
            <p class="howto-desc">広告の「月額〇〇円〜」という安さだけで決めるのではなく、<strong>必ず「総額」を提示してくれるクリニック</strong>を選びましょう。</p>
            <p class="howto-desc">診察料やお薬代だけでなく、<strong>血液検査や注射針などの消耗品代、さらには解約時のルール</strong>まで、事前にしっかり説明してくれるかどうかが信頼の証拠です。</p>
            <div class="howto-tip">
              <p class="howto-tip-title">★ ポイント</p>
              <p>「対面だと無理に勧誘されそうで不安」「店舗に行くのが面倒」という方は、<strong>事前にLINEでプランや費用のシミュレーション</strong>ができるクリニックがおすすめです。</p>
            </div>
          </div>

          <div class="howto-card">
            <div class="howto-num">3</div>
            <h3 class="howto-title">症例や実績が公開されているか</h3>
            <p class="howto-desc">医療ダイエットの結果は<strong>医師の実績に大きく左右されます</strong>。公式サイトやSNSで「実際の症例」が公開されているか確認しましょう。</p>
            <p class="howto-desc">単なる「〇万件の実績」という数字だけでなく、<strong>ビフォーアフターの写真や体重の変化など、具体的な実績</strong>がわかるかが重要です。</p>
          </div>

        </div>

      </div>
    </section>

    <!-- ===== ビジュアル比較表 ===== -->
    <section class="section vcompare-section">
      <div class="container">

        <!-- 統一した広告風見出し -->
        <div class="ad-heading ad-heading-single">
          <p class="ad-heading-main">人気クリニック3選 徹底比較</p>
        </div>

        <p class="vcompare-scroll-hint">← 横にスクロールできます →</p>
        <div class="vcompare-wrap">
          <table class="vcompare-tbl">
            <thead>
              <tr>
                <th class="vc-label">クリニック</th>
                <th class="vc-col vc-col-top">
                  <div class="vc-photo"><img src="/images/dio-logo.jpg" alt="ディオクリニック" /></div>
                  <div class="vc-cname">ディオクリニック</div>
                </th>
                <th class="vc-col">
                  <div class="vc-photo"><img src="/images/lieto-logo.jpg" alt="リエートクリニック" onerror="this.style.display='none'" /></div>
                  <div class="vc-cname">リエートクリニック</div>
                </th>
                <th class="vc-col">
                  <div class="vc-photo"><img src="/images/fire-logo.jpg" alt="ファイヤークリニック" onerror="this.style.display='none'" /></div>
                  <div class="vc-cname">ファイヤークリニック</div>
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th class="vc-label">総合評価</th>
                <td class="vc-col-top"><p class="vc-rate vc-rate-top">4.9<span class="vc-rate-unit">/5.0</span></p><p class="vc-stars">★★★★★</p></td>
                <td><p class="vc-rate">4.7<span class="vc-rate-unit">/5.0</span></p><p class="vc-stars">★★★★★</p></td>
                <td><p class="vc-rate">4.6<span class="vc-rate-unit">/5.0</span></p><p class="vc-stars">★★★★★</p></td>
              </tr>
              <tr>
                <th class="vc-label">実績</th>
                <td class="vc-col-top"><p class="vc-strong vc-strong-top">外来実績<br />80万件以上<span class="ref">※</span></p></td>
                <td><p class="vc-strong">外来実績<br />3万件</p></td>
                <td><p class="vc-dash">—</p></td>
              </tr>
              <tr>
                <th class="vc-label">推し<br />ポイント</th>
                <td class="vc-col-top"><p class="vc-osusume">遺伝子検査による<br />オーダーメイドプラン</p></td>
                <td><p class="vc-osusume">ムダのない<br />あなただけのプラン</p></td>
                <td><p class="vc-osusume">雑誌掲載・YouTube</p></td>
              </tr>
              <tr>
                <th class="vc-label">機械の<br />種類</th>
                <td class="vc-col-top">
                  <p class="vc-count vc-count-best">7種類</p>
                  <p class="vc-sub">脂肪冷却・ハイフ<br />EMSなど</p>
                </td>
                <td>
                  <p class="vc-count">3種類</p>
                  <p class="vc-sub">脂肪冷却・ハイフ<br />電磁場</p>
                </td>
                <td>
                  <p class="vc-count">1種類</p>
                  <p class="vc-sub">EMS</p>
                </td>
              </tr>
              <tr>
                <th class="vc-label">その他<br />メニュー</th>
                <td class="vc-col-top"><p class="vc-sub">ダイエット注射<br />ダイエット薬<br />食事指導</p></td>
                <td><p class="vc-sub">ダイエット注射<br />ダイエット薬<br />食事指導</p></td>
                <td><p class="vc-sub">ダイエット注射<br />ダイエット薬<br />食事指導</p></td>
              </tr>
              <tr>
                <th class="vc-label">費用</th>
                <td class="vc-col-top">
                  <p class="vc-price-highlight">月額 4,900円〜</p>
                </td>
                <td>
                  <p class="vc-price-highlight">¥868,000</p>
                  <p class="vc-price-sub">美容痩身メディカル<br />コース（2ヶ月）</p>
                </td>
                <td>
                  <p class="vc-price-highlight">月額 6,800円〜</p>
                </td>
              </tr>
              <tr>
                <th class="vc-label">キャンペーン</th>
                <td class="vc-col-top"><p class="vc-strong vc-strong-top">12ヶ月分<br />0円キャンペーン</p></td>
                <td><p class="vc-strong">オープン記念<br />最大半額</p></td>
                <td><p class="vc-dash">—</p></td>
              </tr>
              <tr>
                <th class="vc-label">LINE相談</th>
                <td class="vc-col-top"><p class="vc-circle-good">◎ あり</p></td>
                <td><p class="vc-dash">—</p></td>
                <td><p class="vc-dash">—</p></td>
              </tr>
              <tr>
                <th class="vc-label">公式</th>
                <td class="vc-col-top"><a href="https://dioclinic.jp/lp2-s/" target="_blank" rel="noopener noreferrer nofollow" class="vc-btn vc-btn-top">公式へ →</a></td>
                <td><a href="https://lietoclinic.com/lpbot/lpbot07b18" target="_blank" rel="noopener noreferrer nofollow" class="vc-btn">公式へ →</a></td>
                <td><a href="https://fire-method.com/lp/af_a8/" target="_blank" rel="noopener noreferrer nofollow" class="vc-btn">公式へ →</a></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="vcompare-note">※ ディオクリニック累計外来件数は2020年11月〜2026年2月の累計。</p>
      </div>
    </section>

    <!-- ===== ランキング ===== -->
    <section class="section" id="ranking">
      <div class="container">

        <!-- 統一した広告風見出し -->
        <div class="ad-heading ad-heading-single">
          <p class="ad-heading-main">おすすめ人気クリニックTOP3</p>
        </div>

        <div class="ranking-list">
          {clinics.map(c => (
            <article class="ranking-card">
              <header class="ranking-card-head" style={`--rank-color: ${c.color}`}>
                <div class="ranking-card-rank">
                  <span class="ranking-card-rank-label">第</span>
                  <span class="ranking-card-rank-num">{c.rank}</span>
                  <span class="ranking-card-rank-label">位</span>
                </div>
                <div class="ranking-card-namebox">
                  <h3 class="ranking-card-name">{c.name}</h3>
                  <div class="ranking-card-score-inline">
                    <span class="ranking-card-stars">{c.star}</span>
                    <span class="ranking-card-score-num">{c.score.toFixed(1)}</span>
                    <span class="ranking-card-score-max">/ 5.0</span>
                  </div>
                </div>
              </header>
