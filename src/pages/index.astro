<script>
  document.querySelectorAll('[data-reviews-carousel]').forEach(carousel => {
    const carouselEl = carousel as HTMLElement;
    const track = carousel.querySelector('.reviews-track') as HTMLElement;
    const slides = Array.from(carousel.querySelectorAll('.reviews-slide')) as HTMLElement[];
    const counter = carousel.querySelector('.reviews-counter') as HTMLElement;
    const prevBtn = carousel.querySelector('.reviews-prev') as HTMLButtonElement;
    const nextBtn = carousel.querySelector('.reviews-next') as HTMLButtonElement;
    const dotsContainer = carousel.querySelector('.reviews-dots') as HTMLElement;
    let current = 0;
    const total = slides.length;
    if (!track || total === 0) return;

    function setWidth() {
      const w = carouselEl.offsetWidth;
      slides.forEach(s => { s.style.width = w + 'px'; });
    }
    setWidth();
    window.addEventListener('resize', () => { setWidth(); goTo(current); });

    slides.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'reviews-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', `${i + 1}番目の口コミ`);
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    });

    function goTo(n: number) {
      current = (n + total) % total;
      const w = carouselEl.offsetWidth;
      track.style.transform = `translateX(-${current * w}px)`;
      if (counter) counter.textContent = `${current + 1} / ${total}`;
      carousel.querySelectorAll('.reviews-dot').forEach((d, i) => {
        d.classList.toggle('active', i === current);
      });
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));

    let touchStartX = 0;
    track.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    track.addEventListener('touchend', (e: TouchEvent) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
    }, { passive: true });
  });
</script>

