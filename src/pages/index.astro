---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const clinics = [
  {
    rank: 1,
    name: 'ディオクリニック',
    catchphrase: 'ダイエット人生を、終わらせよう。',
    score: 4.9,
    star: '★★★★★',
    tags: ['累計外来80万件', '通院者の99%が成果実感', '12ヶ月分0円キャンペーン'],
    points: [
      '脂肪冷却・医療EMS・医療ハイフ・GLP-1注射など豊富な施術メニュー',
      '医師＋管理栄養士監修のオーダーメイドプラン',
      '初回9,800円〜・12ヶ月分0円のキャンペーン実施中',
    ],
    price: '初回 9,800円〜',
    counsel: '無料カウンセリング受付中',
    feature: '医療痩身フルラインナップ',
    color: '#FFD700',
    affiliateHref: 'https://dioclinic.jp/lp2-s/',
    osusume: ['本気で結果を出したい方', '医療痩身を幅広く試したい方', '医師の専門的サポートを受けたい方'],
  },
  {
    rank: 2,
    name: 'リエートクリニック',
    catchphrase: '繰り返すリバウンドと、お別れ。',
    score: 4.7,
    star: '★★★★★',
    tags: ['横浜・名古屋・池袋3院', '体質改善アプローチ', '15ヶ月0円キャンペーン'],
    points: [
      '細胞レベルでアプローチし「太りにくい体質」へ',
      '週1回の通院で2週間前後から効果が期待できる設計',
      '無料カウンセリング＋15ヶ月0円キャンペーンで始めやすい',
    ],
    price: 'カウンセリング無料',
    counsel: '無料カウンセリング受付中',
    feature: 'リバウンド対策に特化',
    color: '#C0C0C0',
    affiliateHref: 'https://lietoclinic.com/lpbot/lpbot07b18',
    osusume: ['リバウンドを繰り返してきた方', '体質から変えたい方', '横浜・名古屋・池袋エリアの方'],
  },
  {
    rank: 3,
    name: 'ファイヤークリニック',
    catchphrase: '我慢しないダイエット、はじめる。',
    score: 4.6,
    star: '★★★★★',
    tags: ['新宿・渋谷・銀座・名古屋4院', '2ヶ月平均-8kg', 'リバウンド率の低さに自信'],
    points: [
      'GLP-1注射・カベリン・医療EMS・薬・食事の5本柱「FIREメソッド」',
      '医師＋管理栄養士によるオーダーメイド施術＆処方',
      '月額4,200円〜の手の届きやすい料金プラン',
    ],
    price: '月額 4,200円〜',
    counsel: '無料カウンセリング受付中',
    feature: '5本柱の独自メソッド',
    color: '#CD7F32',
    affiliateHref: 'https://fire-method.com/lp/af_a8/',
    osusume: ['部分痩せもしたい方', '食事制限のストレスを避けたい方', '都心エリア（新宿・渋谷・銀座）の方'],
  },
];

const faqs = [
  { q: '医療ダイエットとはどんな治療ですか？', a: '医療機関で行うダイエット治療です。脂肪冷却・医療EMS・GLP-1受容体作動薬・脂肪溶解注射など、医師の管理のもとで行う痩身アプローチを指します。自己流の食事制限・運動と異なり、医学的根拠と医師のサポートが受けられるのが特徴です。' },
  { q: '本当に痩せますか？効果は人によって違いますか？', a: '効果には個人差があります。医療ダイエットは医学的なアプローチでサポートしますが、生活習慣や体質、目標により結果は異なります。各クリニックでは無料カウンセリングを実施しているので、まずは現状の体型・目標に合わせた治療プランを相談することをおすすめします。' },
  { q: 'カウンセリングは無料ですか？無理な勧誘はありませんか？', a: '本ページで紹介する3クリニックはいずれも無料カウンセリングを実施しています。カウンセリングは現状の体型・目標・予算などを医師と相談する場で、その場で契約する義務はありません。納得してから治療を開始できます。' },
  { q: '料金はどのくらいかかりますか？', a: 'クリニック・施術内容・期間により異なります。ディオクリニックは初回9,800円〜、ファイヤークリニックは月額4,200円〜の料金プランを提供。詳しい総額は無料カウンセリングで施術プランを相談してから決まります。各社で「○ヶ月0円」などのキャンペーンも実施中です。' },
  { q: '副作用やリスクはありますか？', a: '医療行為のため、施術内容によっては副作用が出る可能性があります。医師が事前に詳しく説明したうえで治療を進めるため、不安な点はカウンセリング時に必ず確認しましょう。健康状態によっては施術を受けられない場合もあります。' },
  { q: '通院頻度はどのくらいですか？', a: 'クリニック・施術内容により異なります。一般的に週1回程度の通院が目安ですが、施術メニューによっては月1〜2回の場合もあります。カウンセリング時に通いやすさを確認することが大切です。' },
];
---
<Layout
  title="メディダイエット比較ラボ｜医療ダイエット人気3クリニックを徹底比較"
  description="医療ダイエット人気3クリニック（ディオクリニック・リエートクリニック・ファイヤークリニック）を徹底比較。料金・施術内容・実績で選べる、本気で痩せたい方のための比較サイトです。"
>
  <Header />
  <main>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <a href="#ranking" class="hero-img-link" aria-label="人気クリニックランキングへ">
        <img src="/images/hero-mv.png" alt="医療の力で本気で痩せる 医療ダイエット人気3クリニック徹底比較" class="hero-img" loading="eager" fetchpriority="high" />
      </a>
    </section>

    <!-- ===== 当サイトおすすめクリニック ===== -->
    <section class="osusume-section">
      <div class="container container-sm">
        <p class="osusume-heading">
          <span class="osusume-heading-deco">/</span>
          当サイトおすすめクリニック
          <span class="osusume-heading-deco">\</span>
        </p>
        <div class="osusume-card">
          <div class="osusume-logo-wrap">
            <img src="/images/dio-logo.png" alt="ディオクリニック ロゴ" class="osusume-logo" loading="lazy" />
          </div>
          <h2 class="osusume-name">ディオクリニック</h2>
          <p class="osusume-desc">
            <strong>外来実績80万件以上。</strong><br />
            LINEであなただけのプラン・料金がわかる
          </p>
          <a href="#" class="osusume-cta" aria-label="ディオクリニック 無料カウンセリングへ">
            <span class="osusume-cta-text">無料カウンセリングへ</span>
            <span class="osusume-cta-arrow">→</span>
          </a>
          <p class="osusume-cta-sub">＼ LINEで簡単30秒・完全無料 ／</p>
        </div>
      </div>
    </section>

    <!-- ===== 悩み訴求 ===== -->
    <section class="section section-bg" id="problems">
      <div class="container">
        <h2 class="section-title">こんなお悩みありませんか？</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <div class="problem-icon">😩</div>
            <p class="problem-text">食事制限してもすぐ <strong>リバウンド</strong> してしまう</p>
          </div>
          <div class="problem-card">
            <div class="problem-icon">😢</div>
            <p class="problem-text">部分痩せしたいのに <strong>そこだけ落ちない</strong></p>
          </div>
          <div class="problem-card">
            <div class="problem-icon">😫</div>
            <p class="problem-text">運動が続かない・<strong>ジムに通う時間がない</strong></p>
          </div>
          <div class="problem-card">
            <div class="problem-icon">🥺</div>
            <p class="problem-text">何をやっても <strong>痩せない・効果がでない</strong></p>
          </div>
          <div class="problem-card">
            <div class="problem-icon">😓</div>
            <p class="problem-text">年齢とともに <strong>代謝が落ちた</strong> 気がする</p>
          </div>
          <div class="problem-card">
            <div class="problem-icon">😔</div>
            <p class="problem-text">自己流ダイエットに <strong>もう疲れた</strong></p>
          </div>
        </div>
        <div class="problem-conclusion">
          <p>そのお悩み、<strong>医療ダイエット</strong>で解決できる可能性があります。</p>
        </div>
      </div>
    </section>

    <!-- ===== 医療ダイエットとは ===== -->
    <section class="section" id="about-medical">
      <div class="container container-sm">
        <h2 class="section-title">医療ダイエットとは？</h2>
        <p class="lead-text">医師の管理のもと、医療機関だけで使える機器・薬剤を用いて行うダイエット治療です。自己流の食事制限や運動と違い、<strong>医学的根拠に基づいたアプローチで、リバウンドしにくい体づくり</strong>を目指せます。</p>
        <div class="method-list">
          <div class="method-item">
            <div class="method-icon">❄</div>
            <div>
              <h3 class="method-title">脂肪冷却</h3>
              <p class="method-desc">脂肪細胞を冷却して破壊・排出を促す医療機器。部分痩せに人気。</p>
            </div>
          </div>
          <div class="method-item">
            <div class="method-icon">⚡</div>
            <div>
              <h3 class="method-title">医療EMS</h3>
              <p class="method-desc">家庭用とは桁違いの出力で、深部の筋肉と脂肪にアプローチ。</p>
            </div>
          </div>
          <div class="method-item">
            <div class="method-icon">💉</div>
            <div>
              <h3 class="method-title">GLP-1受容体作動薬</h3>
              <p class="method-desc">食欲を抑える医薬品。自然と食事量を減らせるサポートに。</p>
            </div>
          </div>
          <div class="method-item">
            <div class="method-icon">💊</div>
            <div>
              <h3 class="method-title">脂肪溶解注射</h3>
              <p class="method-desc">気になる部位に直接アプローチして脂肪を減少させる注射治療。</p>
            </div>
          </div>
        </div>
        <p class="note-text">※ 効果には個人差があります。施術内容は医師との相談で決まります。</p>
      </div>
    </section>

    <!-- ===== 選び方ポイント ===== -->
    <section class="section section-bg" id="howto">
      <div class="container">
        <h2 class="section-title">失敗しないクリニックの選び方<br /><span class="section-title-sub">この3つでチェック！</span></h2>
        <div class="howto-grid">
          <div class="howto-card">
            <div class="howto-num">1</div>
            <h3 class="howto-title">施術メニューの豊富さ</h3>
            <p class="howto-desc">脂肪冷却・EMS・注射・薬・食事指導など、複数のアプローチを組み合わせられるクリニックほど、体質や悩みに合わせた治療がしやすくなります。</p>
          </div>
          <div class="howto-card">
            <div class="howto-num">2</div>
            <h3 class="howto-title">料金の明朗さ・お試しやすさ</h3>
            <p class="howto-desc">無料カウンセリング・初回限定価格・キャンペーンの有無を必ずチェック。納得して始められるかが重要です。</p>
          </div>
          <div class="howto-card">
            <div class="howto-num">3</div>
            <h3 class="howto-title">医師・管理栄養士のサポート体制</h3>
            <p class="howto-desc">医師＋管理栄養士の両輪でサポートしてくれるクリニックを選ぶと、施術と並行して食事面・生活面まで指導が受けられます。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ランキング ===== -->
    <section class="section" id="ranking">
      <div class="container">
        <h2 class="section-title">医療ダイエット<br />おすすめ人気クリニックTOP3</h2>
        <p class="ranking-lead">編集部が「施術内容」「料金」「サポート体制」で厳選した3クリニックを発表！</p>

        <div class="ranking-list">
          {clinics.map(c => (
            <article class="ranking-card">
              <header class="ranking-card-head" style={`--rank-color: ${c.color}`}>
                <div class="ranking-card-rank">
                  <span class="ranking-card-rank-label">第</span>
                  <span class="ranking-card-rank-num">{c.rank}</span>
                  <span class="ranking-card-rank-label">位</span>
                </div>
                <div>
                  <p class="ranking-card-tagline">{c.feature}</p>
                  <h3 class="ranking-card-name">{c.name}</h3>
                  <p class="ranking-card-catch">「{c.catchphrase}」</p>
                </div>
              </header>
              <div class="ranking-card-body">
                <div class="ranking-card-score">
                  <span class="ranking-card-stars">{c.star}</span>
                  <span class="ranking-card-score-num">{c.score.toFixed(1)}</span>
                  <span class="ranking-card-score-max">/ 5.0</span>
                </div>
                <ul class="ranking-card-tags">
                  {c.tags.map(t => <li><span class="ranking-tag-check">✓</span>{t}</li>)}
                </ul>
                <div class="ranking-card-spec">
                  <div><dt>料金</dt><dd>{c.price}</dd></div>
                  <div><dt>カウンセリング</dt><dd>{c.counsel}</dd></div>
                </div>
                <div class="ranking-card-points">
                  <h4 class="ranking-card-points-title">▼ おすすめポイント</h4>
                  <ul>
                    {c.points.map(p => <li>{p}</li>)}
                  </ul>
                </div>
                <div class="ranking-card-osusume">
                  <h4 class="ranking-card-osusume-title">こんな方におすすめ</h4>
                  <ul>
                    {c.osusume.map(o => <li><span class="check-tick">●</span>{o}</li>)}
                  </ul>
                </div>
                <div class="ranking-card-cta">
                  <a href={c.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="cta-main">
                    <span class="cta-main-label">{c.name}の<br /><strong>無料カウンセリング</strong>はこちら</span>
                    <span class="cta-main-arrow">→</span>
                  </a>
                  <p class="cta-sub">＼ 公式サイトへ移動します ／</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== 比較表 ===== -->
    <section class="section section-bg" id="compare">
      <div class="container">
        <h2 class="section-title">3クリニック かんたん比較表</h2>
        <p class="ranking-lead">気になるクリニックを横並びでチェック！</p>
        <div class="compare-wrap">
          <table class="compare-tbl">
            <thead>
              <tr>
                <th></th>
                {clinics.map(c => <th>
                  <div class="compare-th-rank" style={`background: ${c.color}`}>第{c.rank}位</div>
                  <div class="compare-th-name">{c.name}</div>
                </th>)}
              </tr>
            </thead>
            <tbody>
              <tr><th>総合評価</th>{clinics.map(c => <td><span class="compare-stars">{c.star}</span><br /><strong>{c.score.toFixed(1)}</strong> / 5.0</td>)}</tr>
              <tr><th>特徴</th>{clinics.map(c => <td>{c.feature}</td>)}</tr>
              <tr><th>料金</th>{clinics.map(c => <td><strong>{c.price}</strong></td>)}</tr>
              <tr><th>カウンセリング</th>{clinics.map(_ => <td>無料</td>)}</tr>
              <tr><th>公式サイト</th>{clinics.map(c => <td><a href={c.affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="compare-btn">無料相談 →</a></td>)}</tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===== 利用の流れ ===== -->
    <section class="section" id="flow">
      <div class="container container-sm">
        <h2 class="section-title">無料カウンセリングまでの流れ</h2>
        <div class="flow-list">
          <div class="flow-item"><div class="flow-num">1</div><div><h3 class="flow-title">公式サイトから予約</h3><p class="flow-desc">気になるクリニックの公式サイトで、希望の日時と来院希望院を選んで予約します。</p></div></div>
          <div class="flow-item"><div class="flow-num">2</div><div><h3 class="flow-title">クリニックへ来院</h3><p class="flow-desc">予約日にクリニックを訪問。受付で問診票を記入します。</p></div></div>
          <div class="flow-item"><div class="flow-num">3</div><div><h3 class="flow-title">医師による無料カウンセリング</h3><p class="flow-desc">体型・目標・予算をヒアリング。最適な施術プランを提案してもらえます。</p></div></div>
          <div class="flow-item"><div class="flow-num">4</div><div><h3 class="flow-title">納得したら治療スタート</h3><p class="flow-desc">プラン・料金に納得したら治療を開始。もちろん契約しない選択もOKです。</p></div></div>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="section section-bg" id="faq">
      <div class="container container-sm">
        <h2 class="section-title">よくある質問</h2>
        <div class="faq-list">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary><span class="faq-q">Q</span>{faq.q}</summary>
              <div class="faq-a-wrap"><span class="faq-a">A</span><p>{faq.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== フッターCTA ===== -->
    <section class="section final-cta">
      <div class="container container-sm text-center">
        <p class="final-cta-lead">理想の体型を、医療の力で。</p>
        <h2 class="final-cta-title">まずは無料カウンセリングから始めよう</h2>
        <p class="final-cta-desc">本気で痩せたい方に選ばれる<br />医療ダイエット人気No.1クリニックは…</p>
        <a href={clinics[0].affiliateHref} target="_blank" rel="noopener noreferrer nofollow" class="final-cta-btn">
          <span class="final-cta-btn-num">第1位</span>
          <span class="final-cta-btn-name">{clinics[0].name}<br />無料カウンセリングへ</span>
          <span class="final-cta-btn-arrow">→</span>
        </a>
        <p class="final-cta-note">※ 効果には個人差があります。無料カウンセリングで詳細をご確認ください。</p>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ===== 当サイトおすすめクリニック ===== */
  .osusume-section {
    padding: 2.5rem 1rem 2rem;
    background: linear-gradient(180deg, #fff 0%, var(--color-bg-gray) 100%);
  }
  .osusume-heading {
    text-align: center;
    font-size: clamp(1rem, 3.2vw, 1.2rem);
    font-weight: 800;
    color: var(--color-primary);
    margin: 0 0 1.25rem;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .osusume-heading-deco {
    color: var(--color-accent);
    font-weight: 700;
    font-size: 1.2em;
    display: inline-block;
    transform: scale(1.2, 1.6);
    opacity: 0.85;
  }
  .osusume-card {
    background: #fff;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-xl);
    padding: 1.75rem 1.5rem 1.5rem;
    text-align: center;
    box-shadow: 0 10px 30px rgba(19, 62, 107, 0.1);
    position: relative;
    overflow: hidden;
  }
  .osusume-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 5px;
    background: linear-gradient(90deg, var(--color-accent) 0%, var(--color-cta) 100%);
  }
  .osusume-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 280px;
    height: 120px;
    margin: 0 auto 1rem;
    padding: 0.75rem;
    background: var(--color-bg-gray);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
  }
  .osusume-logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    width: auto;
    height: auto;
  }
  .osusume-name {
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    font-weight: 900;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .osusume-desc {
    font-size: 0.98rem;
    line-height: 1.85;
    color: #333;
    margin: 0 0 1.5rem;
  }
