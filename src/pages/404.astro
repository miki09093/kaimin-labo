---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="ページが見つかりません（404）">
  <Header />
  <main>
    <div class="container" style="padding: 4rem 1rem 5rem; max-width: 720px; text-align: center;">
      <p style="font-size: 5rem; font-weight: 900; color: var(--color-accent); margin: 0; line-height: 1;">404</p>
      <h1 style="margin: 0.5rem 0 1rem; color: var(--color-primary);">お探しのページが見つかりません</h1>
      <p style="color: #555; margin-bottom: 2rem;">URLが間違っているか、ページが移動・削除された可能性があります。</p>
      <a href="/" style="display: inline-block; padding: 0.9rem 2rem; background: linear-gradient(135deg, var(--color-cta) 0%, var(--color-cta-dark) 100%); color: #fff; border-radius: 99px; text-decoration: none; font-weight: 800; box-shadow: 0 6px 18px rgba(255,107,107,0.3);">トップページに戻る →</a>
    </div>
  </main>
  <Footer />
</Layout>
