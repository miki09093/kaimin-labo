<script>
  document.querySelectorAll('[data-review-carousel]').forEach(carousel => {
    const carouselEl = carousel as HTMLElement;
    const track = carousel.querySelector('.review-carousel-track') as HTMLElement;
    const slides = Array.from(carousel.querySelectorAll('.review-carousel-slide')) as HTMLElement[];
    const counter = carousel.querySelector('.review-carousel-counter') as HTMLElement;
    const prevBtn = carousel.querySelector('.review-carousel-prev') as HTMLButtonElement;
    const nextBtn = carousel.querySelector('.review-carousel-next') as HTMLButtonElement;
    let current = 0;
    const total = slides.length;

    function initSlides() {
      const w = carouselEl.offsetWidth;
      slides.forEach(s => { s.style.width = w + 'px'; });
    }
    initSlides();
    window.addEventListener('resize', () => { initSlides(); goTo(current); });

    function goTo(n: number) {
      current = (n + total) % total;
      const w = carouselEl.offsetWidth;
      track.style.transform = `translateX(-${current * w}px)`;
      if (counter) counter.textContent = `${current + 1} / ${total}`;
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));

    let touchStartX = 0;
    track.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    track.addEventListener('touchend', (e: TouchEvent) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
    }, { passive: true });
  });

  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answer = btn.nextElementSibling as HTMLElement;
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.classList.toggle('open', !expanded);
      if (expanded) { answer.hidden = true; }
      else { answer.hidden = false; }
    });
  });
</script>

