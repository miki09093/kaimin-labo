---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

// TODO: アフィリエイトリンク取得後に差し替え
const affiliateHref = '#';

const scores = [
  { label: '①フィット感', val: 4.5 },
  { label: '②高さ調整', val: 3.5 },
  { label: '③通気性', val: 3.5 },
  { label: '④素材・耐久性', val: 4.0 },
  { label: '⑤お手入れ', val: 3.0 },
  { label: '⑥価格（コスパ）', val: 4.0 },
];
const total = scores.reduce((a, b) => a + b.val, 0);

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "王様の夢枕2",
  "image": new URL('/images/yume-makura-hero.png', Astro.site).toString(),
  "description": "王様シリーズの第2世代モデル。従来比1.5倍のワイドサイズ（幅62×奥行40cm）で寝返り時もフィット。超極小ビーズ95%＋ポリエステルわた5%の「かなり硬め」な寝心地。日本製・1年品質保証付き。",
  "brand": { "@type": "Brand", "name": "王様の夢枕" },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "JPY",
    "price": "8800",
    "availability": "https://schema.org/InStock"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.3",
    "bestRating": "5",
    "reviewCount": "20"
  }
};

const goodReviews = [
  { text: '寝返りで頭が外れがちな私には、1.5倍ワイドサイズが本当に快適。これは買って正解でした。', who: '30代女性／会社員' },
  { text: '前モデルの夢枕を持っていますが、2はサイズ感が一回り大きくて寝返りしやすさが段違いです。', who: '40代男性／会社員' },
  { text: 'TBSサタデープラスで紹介されているのを見て購入。「ひたすら試して3位」というお墨付きに納得の寝心地。', who: '50代女性／パート' },
  { text: '父の日に父にプレゼント。「ワイドサイズで寝返りが楽」と毎日使ってくれていて購入してよかった。', who: '30代女性／会社員' },
  { text: '価格と寝心地のバランスが秀逸。8,800円で日本製＋1年品質保証は高コスパ。', who: '20代男性／一人暮らし' },
  { text: '日本製というのが安心ポイント。100万人以上の安眠実績があるブランドの2作目という安心感も大きい。', who: '40代女性／自営業' },
  { text: '横向き寝・仰向け寝のどちらでも頭がしっかり収まるサイズ感。寝相が悪い私にもありがたい。', who: '30代男性／SE' },
  { text: 'かなり硬めの寝心地は最初少し戸惑いましたが、慣れると朝の首こりが激減。私には合っていたようです。', who: '50代男性／会社員' },
  { text: '一人暮らしを始めた娘にプレゼント。「ワイドで寝返りしやすい」と気に入ってくれました。', who: '50代女性／主婦' },
  { text: 'カバーがテンセル混でなめらかな肌当たり。汗っかきの私にもうれしい。', who: '20代女性／看護師' },
  { text: 'BS12のドランクドラゴンの番組で「バカ売れ認定」されているのを見て購入。話題どおりの実力でした。', who: '30代男性／公務員' },
  { text: '低反発の沈み込みが苦手で、ストレートネック気味の私にはこの硬めの寝心地が合っていました。', who: '40代女性／パート' },
  { text: '標準バリエーションを選びましたが、低めも気になるので2個目を購入しようか検討中。', who: '30代女性／会社員' },
  { text: '梱包もきれいで、ギフトでもらって嫌な気持ちにならない品質。プレゼントに最適。', who: '40代男性／自営業' },
  { text: 'TBS Nスタで紹介された時に気になっていて、その後購入。期待通りの寝心地でした。', who: '50代男性／会社員' },
  { text: '8,800円という価格は1万円以下で本格枕を試したい人の最初の1台にぴったり。', who: '20代男性／会社員' },
  { text: '体格の良い夫にもワイドサイズの62×40cmは余裕。「これくらいないと頭が落ちる」と話していました。', who: '40代女性／主婦' },
  { text: '夫婦で2つ購入。違うブランドより安定感があって、家計にも優しい。', who: '40代女性／主婦' },
  { text: 'まくら難民を10年やっていた私が、ようやく辿り着いた1台。ワイドサイズと硬めの寝心地が決め手でした。', who: '50代男性／自営業' },
  { text: '頸椎の形にビーズがフィットしてくれる感覚。「ムニュッ」とした硬さがちょうど良い。', who: '40代女性／会社員' },
];

const badReviews = [
  { text: '本体は洗濯できないのが残念。汗っかきの私にはカバーだけ洗えても衛生的に不安。', who: '30代男性／会社員' },
  { text: '高さ調整は「標準」「低め」の2種類から選ぶ形式で、細かい微調整はできません。注意ポイント。', who: '40代女性／会社員' },
  { text: '極小ビーズなので使い込むと中身が偏ることがあります。たまにほぐして整える必要があり。', who: '50代女性／パート' },
  { text: 'かなり硬めの寝心地が苦手な人には合わないかも。ふんわり柔らか派には向きません。', who: '30代男性／自営業' },
  { text: 'ブレインスリープと比較すると、通気性は劣ります。夏場は若干蒸れ感あり。', who: '40代男性／管理職' },
  { text: '従来比1.5倍のワイドサイズは魅力ですが、寝室の枕カバーが合わなくて買い替えが必要でした。', who: '30代女性／看護師' },
  { text: 'ビーズの「シャカシャカ」音が静かな部屋では少し気になります。慣れれば気にならないですが。', who: '20代女性／会社員' },
  { text: 'ヘタリは比較的早めかも。1〜2年でだいぶ高さが落ち着いてきました。買い替えサイクルは早め想定。', who: '40代男性／会社員' },
  { text: 'デザインが地味で、インテリア重視の人には物足りないかも。機能優先で割り切れる人向け。', who: '30代男性／SE' },
  { text: 'カバーの素材が好みが分かれます。テンセル混は私には少しサラッとしすぎに感じました。', who: '50代女性／主婦' },
  { text: '返金保証ではなく1年品質保証なので、「合わなかったから返したい」には対応できません。', who: '40代女性／パート' },
  { text: 'サイズが大きいので、収納時にスペースを取ります。ベッドが小さい人には注意。', who: '20代男性／会社員' },
  { text: '柔らかい枕に慣れている人には、最初「かなり硬め」のフィット感が違和感あるかもしれません。', who: '50代男性／自営業' },
  { text: '送料は別途かかる場合があります。購入時の合計金額を要確認。', who: '30代女性／会社員' },
  { text: '1年品質保証はあるが、長期使用の交換保証ではないので、ヘタリ自体は保証対象外です。', who: '40代男性／会社員' },
  { text: '極小ビーズが万が一こぼれると掃除が大変。子供やペットがいる家庭は要注意。', who: '30代女性／主婦' },
  { text: 'カラー展開が少なめ。寝室のインテリアに合わせて選びたい人には物足りない。', who: '40代女性／会社員' },
  { text: '小柄な方には62cm幅は大きすぎるかも。シングルベッドだと枕で半分以上埋まる感覚。', who: '50代男性／建設業' },
  { text: '8,800円で「夢の枕」と呼べるかは個人差。3万円超の高級枕に比べると寝心地の天井は感じます。', who: '30代男性／会社員' },
  { text: '取り扱い店舗が限定的で、実店舗で試してから買いたい派の私には敷居が高めでした。', who: '40代男性／自営業' },
];

const faqs = [
  { q: '本体は洗濯できますか？', a: '本体は洗濯できません。カバーは取り外して洗濯可能（パイピング仕様）です。お手入れの際は、月に一度カバーを洗濯することをおすすめします。' },
  { q: '高さ調整はどうやって行いますか？', a: '王様の夢枕2は「標準バリエーション」「低めバリエーション」の2種類から選ぶ形式です。購入後の中材調整はできません。' },
  { q: 'ヘタリ・寿命の目安は？', a: '通常使用で2〜3年程度が買い替えの目安です。1年品質保証が付いているので、初期不良については保証対象です。' },
  { q: '返金保証はありますか？', a: '公式は1年品質保証付きですが、返金保証ではありません。販売店によって対応は異なります。' },
  { q: '横向き寝でも使えますか？', a: '従来比1.5倍のワイドサイズ（幅62×奥行40cm）で寝返り時にも頭が外れにくく、横向き寝でも使いやすい設計です。' },
  { q: 'サイズはどのくらい？', a: '幅62×奥行40cm（中央部34cm）×高さ約8cm（最大12cm）の従来比1.5倍ワイドサイズです。重量は約800g。' },
  { q: '中材は何でできていますか？', a: 'ポリエステル100%（超極小ビーズ95%＋ポリエステルわた5%）です。「かなり硬め」のしっかりした寝心地が特徴です。' },
  { q: '配送はどれくらいで届きますか？', a: '注文から3〜5日程度で配送されるのが目安です。地域や在庫状況により変動します。' },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Layout
  title="王様の夢枕2を徹底レビュー｜従来比1.5倍ワイドサイズの実力は？"
  description="ランキング2位の王様の夢枕2を徹底レビュー。従来比1.5倍ワイド＋超極小ビーズ＋日本製＋1年品質保証の実力を、当サイト独自の30点満点で採点しました。"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Header />
  <main>
    <div class="page-header">
      <div class="container">
        <Breadcrumb items={[{ label: 'レビュー', href: '/review/' }, { label: '王様の夢枕2' }]} />
        <h1>王様の夢枕2を徹底レビュー｜従来比1.5倍ワイドサイズの実力は？</h1>
        <p style="margin-top: 0.5rem; color: var(--color-text-muted);">公開日：2026.05.16 ／ カテゴリ：レビュー</p>
      </div>
    </div>

    <div class="container article-body" style="max-width: var(--content-width); padding: 2rem 1rem 4rem;">

      <img src="/images/yume-makura-hero.png" alt="王様の夢枕2" class="article-hero-img" loading="eager" />

      <p><span class="marker-yellow">「寝返りで頭が枕から外れがち」「ワイドな枕でゆったり眠りたい」</span>――そんな方におすすめなのが <strong class="text-navy">王様の夢枕2</strong>。100万人以上の安眠を支えてきた王様シリーズの第2世代モデルで、当サイトの枕ランキングでは <span class="badge-gold">2位（30点満点中22.0点）</span> にランクイン。</p>
      <p>この記事では、王様の夢枕2最大の特徴である「従来比1.5倍ワイドサイズ」「超極小ビーズの硬めの寝心地」「日本製＋1年品質保証」を、ポイント別評価・口コミ・FAQまで掘り下げて検証します。</p>

      <h2>結論：「ワイドサイズで硬めの寝心地」を求める方に最適な1台</h2>
      <div class="conclusion-box">
        <p><span class="marker-yellow"><strong>「寝返りで頭が枕からズレる」「ふんわり柔らかい枕は苦手」</strong></span>という方の<span class="text-emphasis">「ワイドで硬めの本格枕」</span>として本気でおすすめできます。理由は次の3点。</p>
        <ul class="conclusion-list">
          <li><span class="check-icon">✓</span><span class="text-navy-bold">従来比1.5倍ワイドサイズ（62×40cm）</span>で寝返り時も頭が外れにくい</li>
          <li><span class="check-icon">✓</span><span class="text-navy-bold">超極小ビーズ95%＋ポリエステルわた5%</span>でかなり硬めのしっかり寝心地</li>
          <li><span class="check-icon">✓</span><span class="text-navy-bold">8,800円・日本製＋1年品質保証</span>で手の届きやすい安心設計</li>
        </ul>
        <p>3万円超の高級枕（ブレインスリープ等）と比べると機能はシンプルですが、その分<span class="text-emphasis">「日本製ブランドの安心感と手の届く価格」</span>が王様の夢枕2の隠れた魅力です。</p>
      </div>

      <div class="score-box">
        <p class="score-box-title">当サイト独自スコア</p>
        <p class="score-box-total"><span class="score-box-num">{total.toFixed(1)}</span><span class="score-box-max">/ 30点</span></p>
        <ul class="score-box-list">
          {scores.map(s => (
            <li><span>{s.label}</span><strong>{s.val.toFixed(1)}</strong></li>
          ))}
        </ul>
      </div>

      <h2>商品ダイジェスト</h2>
      <table>
        <thead>
          <tr><th>項目</th><th>内容</th></tr>
        </thead>
        <tbody>
          <tr><th>価格（税込）</th><td>8,800円（公式）</td></tr>
          <tr><th>サイズ</th><td>幅62×奥行40cm（中央34cm）×高さ約8cm（最大12cm）</td></tr>
          <tr><th>重量</th><td>約800g</td></tr>
          <tr><th>中材</th><td>ポリエステル100%（超極小ビーズ95%＋ポリエステルわた5%）</td></tr>
          <tr><th>カバー</th><td>ポリエステル60%＋テンセル™40%</td></tr>
          <tr><th>バリエーション</th><td>標準／低めの2種</td></tr>
          <tr><th>お手入れ</th><td>本体不可／カバーのみ洗濯可</td></tr>
          <tr><th>製造</th><td>日本製</td></tr>
          <tr><th>保証</th><td>1年品質保証</td></tr>
        </tbody>
      </table>

      <h2>ポイント別に実際どうなの？を本音で評価</h2>

      <h3>① 従来比1.5倍ワイドサイズ：寝返り時も頭が外れにくい</h3>
      <p>王様の夢枕2の最大の特徴は、<span class="text-navy-bold">旧モデル比1.5倍のワイドサイズ（幅62×奥行40cm）</span>。<span class="marker-yellow">寝返りを打っても頭が枕から外れにくく、ゆったり快適に眠れる</span>設計です。</p>
      <p>標準的な枕（40×60cm程度）で「寝返りで頭が落ちる」「夜中に枕の位置を直す」経験のある方には、まさに待望のサイズ感です。</p>
      <div class="info-card">
        <p class="info-card-title">こんな方におすすめ</p>
        <ul class="info-card-list">
          <li><span class="check-mini">◎</span>寝返りが多くて頭が枕から外れがち</li>
          <li><span class="check-mini">◎</span>ワイドサイズの枕でゆったり眠りたい</li>
          <li><span class="check-mini">◎</span>横向き寝でも頭をしっかり支えてほしい</li>
        </ul>
      </div>

      <h3>② 超極小ビーズ95%＋ポリエステルわた5%：かなり硬めのしっかり寝心地</h3>
      <p>中材は <span class="text-navy-bold">超極小ビーズ95%＋ポリエステルわた5%</span> の独自配合。<span class="marker-yellow">「かなり硬め」のしっかりした寝心地</span>で、頸椎の形状にフィットして安定したサポート感を実現します。</p>
      <p>低反発ウレタンや柔らかい羽根枕とは異なる、しっかりした支えを求める方に好相性です。</p>

      <h3>③ 100万人以上の安眠実績＋メディア露出</h3>
      <p>王様シリーズは <span class="text-navy-bold">100万人以上の安眠を支えてきたロングセラーブランド</span>。<span class="marker-yellow">TV番組やメディアでも度々紹介されており、知名度・信頼性ともに業界トップクラス</span>です。</p>
      <div class="info-card">
        <p class="info-card-title">最新メディア掲載実績</p>
        <ul class="info-card-list">
          <li><span class="check-mini">◎</span>BS12「ドランクドラゴンのバカ売れ研究所！」でバカ売れ認定（6/24）</li>
          <li><span class="check-mini">◎</span>TBS「Nスタ」で紹介（6/11）</li>
          <li><span class="check-mini">◎</span>MBS/TBS「サタデープラス」ひたすら試してランキング3位（2023.6/25）</li>
        </ul>
      </div>

      <h3>④ 日本製＋1年品質保証：手の届く価格で安心</h3>
      <p>本体・カバーともに <span class="text-navy-bold">日本製</span>。<span class="marker-yellow">8,800円という手の届く価格＋1年品質保証</span>で、ロングセラーブランドならではの安心感があります。標準／低めの2バリエーションから選べる設計です。</p>

      <h2>あなたに向いてる？タイプ別チェック</h2>

      <div class="fit-block fit-good">
        <p class="fit-title"><span class="fit-icon-good">✓</span>王様の夢枕2が<span class="text-navy-bold">向いてる人</span></p>
        <ul class="fit-list">
          <li>
            <p class="fit-target">寝返りで頭が枕から外れがち</p>
            <p class="fit-reason"><span class="reason-label">理由</span><span class="marker-yellow">従来比1.5倍ワイドサイズ</span>で寝返り時もフィット</p>
          </li>
          <li>
            <p class="fit-target">硬めのしっかりした寝心地が好み</p>
            <p class="fit-reason"><span class="reason-label">理由</span><span class="marker-yellow">超極小ビーズ95%＋わた5%</span>で「かなり硬め」設計</p>
          </li>
          <li>
            <p class="fit-target">日本製にこだわりたい</p>
            <p class="fit-reason"><span class="reason-label">理由</span>本体・カバーとも<span class="marker-yellow">日本製</span>＋1年品質保証</p>
          </li>
          <li>
            <p class="fit-target">手の届く価格で本格枕を試したい</p>
            <p class="fit-reason"><span class="reason-label">理由</span><span class="marker-yellow">8,800円</span>で1万円以下の価格設定</p>
          </li>
        </ul>
      </div>

      <div class="fit-block fit-bad">
        <p class="fit-title"><span class="fit-icon-bad">✗</span>王様の夢枕2が<span class="text-navy-bold">向かない人</span></p>
        <ul class="fit-list">
          <li>
            <p class="fit-target">通気性・蒸れにくさを最重視したい</p>
            <p class="fit-reason"><span class="reason-label warn">理由</span>ブレインスリープのような90%空気でできた素材には及ばない</p>
          </li>
          <li>
            <p class="fit-target">本体を丸洗いして清潔に保ちたい</p>
            <p class="fit-reason"><span class="reason-label warn">理由</span>本体は洗濯不可（カバーのみ洗濯可能）</p>
          </li>
          <li>
            <p class="fit-target">細かい高さ調整がしたい</p>
            <p class="fit-reason"><span class="reason-label warn">理由</span>標準／低めの2バリエーションから選ぶ形式</p>
          </li>
          <li>
            <p class="fit-target">ふんわり柔らかい寝心地が好み</p>
            <p class="fit-reason"><span class="reason-label warn">理由</span>「かなり硬め」の設計のため</p>
          </li>
        </ul>
      </div>

