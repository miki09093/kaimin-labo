---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const affiliateHref = 'https://px.a8.net/svt/ejp?a8mat=4B3N6X+EIQLWY+4TX4+ZQ80I';

const scores = [
  { label: '①硬さ・反発力', val: 4.0 },
  { label: '②ゾーン設計', val: 4.0 },
  { label: '③リカバリー機能', val: 5.0 },
  { label: '④使いやすさ', val: 4.0 },
  { label: '⑤保証・認証', val: 3.5 },
  { label: '⑥価格（コスパ）', val: 3.5 },
];
const total = scores.reduce((a, b) => a + b.val, 0);

const goodReviews = [
  { text: '整体に月2回通っていた腰のコリが、3週間使ってみたら明らかに軽くなりました。磁気の力って正直半信半疑でしたが、結果が出てるので文句なしです。', who: '40代男性／会社員' },
  { text: '今までいろいろなマットレス試しましたが、これは別格。医療機器認証もついてて安心感が違います。シングルしかないのが残念なくらい。', who: '50代女性／自営業' },
  { text: 'デスクワークで肩から首にかけてガチガチだったのが、リヴェリアに変えてから朝のだるさがほぼなくなりました。コリ持ちにはマジでおすすめ。', who: '30代男性／SE' },
  { text: '今までの敷布団の上に重ねるだけでよかったので導入のハードルが低かった。10cmという厚みも絶妙で、敷布団の良さも残しつつしっかりサポートしてくれます。', who: '40代女性／看護師' },
  { text: '楽天で評価が高かったので半信半疑で購入。1ヶ月使った今、リピーターになりそうです。整体代と比べたら絶対こっちの方がコスパいい。', who: '30代女性／パート' },
  { text: '日本製・医療機器認証・1年保証。この3点が揃ってるマットレスは他になかなかないです。値段はしますが安心して使えます。', who: '60代男性／定年退職' },
  { text: '朝起きたときの「体が軽い」感覚が他のマットレスと違います。磁気と高反発のダブル効果なんでしょうか、毎日寝るのが楽しみになりました。', who: '40代男性／管理職' },
  { text: '腰のヘルニア持ちの夫にプレゼント。整形外科の先生も「磁気は血行改善に効くからいいよ」と言ってくれて、安心して使えてます。', who: '50代女性／主婦' },
  { text: 'マットレスを買い替えるほどではないけど、今の寝具に何か足したいと思って購入。これが大正解でした。コリの軽減を実感してます。', who: '30代女性／Web編集' },
  { text: '一人暮らしのワンルームで使ってます。10cmと薄めなので部屋が圧迫されず、機能性とのバランスが絶妙。シングル一人用なら最適解です。', who: '20代女性／会社員' },
  { text: '40肩で寝るときに肩が痛かったのですが、6ゾーンの設計のおかげか肩への圧迫が減って楽になりました。買ってよかった。', who: '50代男性／会社員' },
  { text: 'ネオジム磁石48個って数字を見て笑ってしまったけど、使ってみたら本当に違う。プラセボでもいいから「効いてる」と思えるのは大事。', who: '40代女性／会社員' },
  { text: '看護師で立ち仕事＋夜勤あり。仮眠時にもリヴェリアに寝るようにしたら、短時間でも疲れの取れ方が違うように感じます。', who: '30代女性／看護師' },
  { text: '配送が早くて助かりました。コンパクト梱包で玄関先まで運んでもらえて、開封もスムーズ。引っ越し直後でも安心でした。', who: '20代男性／一人暮らし' },
  { text: 'カバーが外せて洗えるのは衛生的にありがたい。汗っかきなので、これは地味だけど大事なポイントでした。', who: '30代男性／会社員' },
  { text: '寝具にここまで投資する価値があるのか半年迷いましたが、結局買って正解。整体に行く回数が月2→月1に減って、年で考えれば余裕でペイ。', who: '40代女性／自営業' },
  { text: '夫の腰痛改善目当てで購入。寝室を別にしてるので、私の寝具とは別管理できるのもよかった。夫は朝の機嫌が変わりました（笑）', who: '50代女性／パート' },
  { text: '8万円超のメイン単体マットレスと迷いましたが、今の寝具を捨てなくていいリヴェリアにして正解。トッパータイプならではの良さがあります。', who: '40代男性／会社員' },
  { text: '長年悩んでいた首コリ・肩コリが、毎晩寝るたびに少しずつ和らいでいく感覚があります。「積み重ね」の効果を実感中。', who: '50代女性／自営業' },
  { text: '通販でマットレスを買うのは抵抗ありましたが、医療機器認証がある＋楽天レビュー高評価という安心材料が決め手でした。届いた今、満足してます。', who: '30代女性／会社員' },
];

const badReviews = [
  { text: 'シングルサイズしかないのが残念。夫婦で同じマットレスにしたいので、セミダブル・ダブル展開も期待したいところです。', who: '40代女性／主婦' },
  { text: '効果を実感するまで2〜3週間かかった印象。即効性を期待してると「あれ？」となるかも。じわじわ効くタイプです。', who: '30代男性／会社員' },
  { text: '5万円台と決して安くはないので、磁気の効果に半信半疑な人だと「高い」と感じるかも。私は結果的に満足してますが。', who: '40代男性／公務員' },
  { text: '100日返金保証がない（1年品質保証はある）ので、「合わなかったら返せる」前提で買うのは難しい。慎重に検討してから購入推奨。', who: '50代女性／会社員' },
  { text: 'トッパータイプなので、これ単体では使えません。「マットレス1枚で完結したい」派の人には合わないですね。', who: '30代男性／一人暮らし' },
  { text: '私はペースメーカーを使ってる父にプレゼントしようとしたら、磁気のため使えないとのこと。ペースメーカー利用者は事前確認必須です。', who: '50代女性／パート' },
  { text: '思ったより薄い10cm。極厚マットレスをイメージしてた人にはギャップがあるかも。トッパーと割り切れば問題なし。', who: '30代女性／会社員' },
  { text: '梱包から開封したときに、ウレタン特有の匂いが少し気になりました。2〜3日で消えるとはいえ、敏感な人は注意。', who: '20代女性／会社員' },
  { text: '磁気の効果は個人差があるので、人によっては「あんまり変わらない」と感じることもあるかも。私の場合は効きました。', who: '40代男性／会社員' },
  { text: '値段の割に保証期間が1年と短め。10年保証つきの他社製品と比べると、長期使用の安心感は劣ります。', who: '50代男性／自営業' },
  { text: '体重が軽い小柄な体型だと、中央240Nが少し硬く感じるかも。私はやや浮く感覚がありました。慣れたので今は問題なし。', who: '20代女性／学生' },
  { text: '注文してから配送まで5日かかりました。すぐ使いたかったので、もうちょっと早いといいなと思いました。', who: '30代男性／会社員' },
  { text: '医療機器認証＝病気が治るわけではないので、過度な期待は禁物。あくまで「血行ケア」目的のマットレスです。', who: '40代女性／会社員' },
  { text: 'カバー洗濯ネット推奨ですが、シングルサイズでも家庭用洗濯機にギリギリ。乾燥時間もそれなりにかかります。', who: '30代女性／パート' },
  { text: 'ペット（猫）に磁気の影響があるか心配して問い合わせたら「人体用なので動物には推奨しない」と回答。多頭飼いには不向きかも。', who: '40代女性／自営業' },
  { text: '楽天レビューと比べると、若干値段の波があるので、購入のタイミングは見極めたほうがいいかも。セール時を狙うのも手。', who: '30代男性／会社員' },
  { text: '商品自体は満足ですが、トッパー前提なので「敷布団＋リヴェリア」となり、お手入れの手間が単体マットレスより増えます。', who: '50代女性／主婦' },
  { text: '腰のヘルニアが酷い時期に試したけど、急性期の痛みには磁気は厳しめ。慢性期のコリには良い、というのが私の感想です。', who: '40代男性／自営業' },
  { text: '裏面にも磁石が入ってる仕様で、引っ越し時にうっかり磁気カードを近くに置いて使えなくなりました。要注意。', who: '20代男性／会社員' },
  { text: '6.4kgとシングルマットレスとしては軽めなんですが、それでも一人で立てかけて干すと、磁石分の重みを感じる気がします。', who: '30代女性／会社員' },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "REVERIA（リヴェリア）",
  "image": new URL('/images/reveria-hero.png', Astro.site).toString(),
  "description": "日本初・唯一の医療機器認証マットレス。ネオジム磁石48個を搭載した磁気リカバリー機能で、腰・肩の血行ケアをサポート。",
  "brand": { "@type": "Brand", "name": "REVERIA" },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "JPY",
    "price": "59800",
    "availability": "https://schema.org/InStock",
    "url": "https://px.a8.net/svt/ejp?a8mat=4B3N6X+EIQLWY+4TX4+ZQ80I"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "bestRating": "5",
    "reviewCount": "20"
  }
};

const faqs = [
  { q: '医療機器認証とは、具体的にどんな効果があるんですか？', a: '「家庭用永久磁石磁気治療器」として承認されており、磁気の力で血行改善・コリの緩和をサポートします。病気を治す医薬品とは異なり、あくまで血行ケアを目的とした認証です。' },
  { q: 'ペースメーカー使用者でも使えますか？', a: '強い磁気を使用しているため、ペースメーカー・体内埋め込み型医療機器をご使用の方は使用できません。ご家族にペースメーカー使用者がいる場合も、ご利用前に医師にご相談ください。' },
  { q: '妊娠中でも使えますか？', a: '妊娠中の方の使用は、念のためかかりつけの医師にご相談のうえご判断ください。' },
  { q: '今の敷布団・マットレスの上に重ねて使えますか？', a: '厚さ10cmのトッパータイプなので、今お使いの敷布団・マットレスの上に重ねて使用できます。買い替え不要で、磁気＋高反発の機能をプラスできます。' },
  { q: 'セミダブル・ダブルの展開はありますか？', a: '現在はシングルサイズ（厚さ10cm × 幅97cm × 長さ198cm）のみの展開となります。' },
  { q: '1年間品質保証の内容を教えてください', a: '通常使用において品質に問題が生じた場合、ご購入から1年以内であれば交換・修理の対象となります。詳細な条件は公式サイトの保証規定をご確認ください。' },
  { q: '何年くらい使えますか？耐久性は？', a: '耐久試験で8万回の圧縮後も復元率97.3%という結果が出ています。一般的な使用方法であれば長期的にお使いいただける設計です。' },
  { q: '配送はどれくらいで届きますか？', a: 'コンパクト梱包で宅配便にて配送されます。送料無料・時間指定可。地域により2〜5日程度が目安です。' },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Layout
  title="REVERIA（リヴェリア）徹底レビュー｜医療機器認証＋磁気リカバリーマットレスの実力は？"
  description="ランキング2位のREVERIA（リヴェリア）を徹底レビュー。日本初・唯一の医療機器認証マットレス、ネオジム磁石48個の磁気リカバリー機能を、当サイト独自の評価で検証しました。"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Header />
  <main>
    <div class="page-header">
      <div class="container">
        <Breadcrumb items={[{ label: 'レビュー', href: '/review/' }, { label: 'REVERIA（リヴェリア）' }]} />
        <h1>REVERIA（リヴェリア）徹底レビュー｜医療機器認証＋磁気リカバリーマットレスの実力は？</h1>
        <p style="margin-top: 0.5rem; color: var(--color-text-muted);">公開日：2026.05.15 ／ カテゴリ：レビュー</p>
      </div>
    </div>

    <div class="container article-body" style="max-width: var(--content-width); padding: 2rem 1rem 4rem;">

      <img src="/images/reveria-hero.png" alt="REVERIA（リヴェリア）リカバリーマットレス" class="article-hero-img" loading="eager" />

      <p><span class="marker-yellow">「整体に通っても腰や肩のコリがなかなか取れない」</span>――そんな慢性のコリ・血行不良に悩む方の選択肢として注目されているのが <strong class="text-navy">REVERIA（リヴェリア）</strong> です。日本初・唯一の<span class="text-navy-bold">医療機器認証マットレス</span>として、当サイトランキングでも <span class="badge-gold">2位（30点満点中24.0点）</span> にランクイン。</p>
      <p>この記事では、リヴェリア最大の特徴である「磁気リカバリー機能」と「医療機器認証」の実際の中身を、ポイント別評価・口コミ・FAQまで掘り下げて検証します。</p>

      <h2>結論：慢性的なコリ・血行不良に悩むならコレ</h2>
      <div class="conclusion-box">
        <p><span class="marker-yellow"><strong>「整体や鍼灸に通うほどのコリが、なかなか改善しない」</strong></span>という方の<span class="text-emphasis">「毎晩のセルフケア環境」</span>として本気でおすすめできます。理由は次の3点。</p>
        <ul class="conclusion-list">
          <li><span class="check-icon">✓</span><span class="text-navy-bold">日本初・唯一の医療機器認証</span>（308AGBZX00014000）取得</li>
          <li><span class="check-icon">✓</span><span class="text-navy-bold">ネオジム磁石48個</span>が腰・肩の血行ケアをサポート</li>
          <li><span class="check-icon">✓</span><span class="text-navy-bold">厚さ10cm・トッパータイプ</span>で今の寝具にプラスで使える</li>
        </ul>
        <p>「マットレスを買い替えるほどでもないが、今より体のケアを意識したい」――そんな方に最適な、<span class="text-emphasis">機能性プラスαの1台</span>です。</p>
      </div>

      <div class="score-box">
        <p class="score-box-title">当サイト独自スコア</p>
        <p class="score-box-total"><span class="score-box-num">{total.toFixed(1)}</span><span class="score-box-max">/ 30点</span></p>
        <ul class="score-box-list">
          {scores.map(s => (
            <li><span>{s.label}</span><strong>{s.val.toFixed(1)}</strong></li>
          ))}
        </ul>
      </div>

      <h2>商品ダイジェスト</h2>
      <table>
        <thead>
          <tr><th>項目</th><th>内容</th></tr>
        </thead>
        <tbody>
          <tr><th>価格（税込）</th><td>59,800円（シングルのみ・送料無料）</td></tr>
          <tr><th>サイズ展開</th><td>シングル（97×198cm／厚さ10cm）</td></tr>
          <tr><th>硬さ</th><td>硬め・高反発（上下150N／中央240N）</td></tr>
          <tr><th>主な特徴</th><td>医療機器認証＋ネオジム磁石48個搭載</td></tr>
          <tr><th>保証</th><td>1年間品質保証</td></tr>
        </tbody>
      </table>

      <h2>ポイント別に実際どうなの？を本音で評価</h2>

      <h3>① 医療機器認証：日本初・唯一の「磁気治療器」認証マットレス</h3>
      <img src="/images/reveria-feature-1.png" alt="日本初・唯一の医療機器認証マットレス" class="article-inline-img" loading="lazy" />
      <p>REVERIA最大の特徴がこれ。<span class="text-navy-bold">医療機器認証番号「308AGBZX00014000」</span>を取得した<span class="marker-yellow">「家庭用永久磁石磁気治療器」</span>として承認されているマットレスです。</p>
      <p>「マットレス」というカテゴリで医療機器認証を取得している商品は <span class="text-navy-bold">日本国内でリヴェリアのみ</span>。一般的な高反発マットレスは「寝具」止まりで、機能訴求も「寝心地」が中心ですが、リヴェリアは<span class="marker-yellow">「磁気による血行ケア」</span>という効果が認証によって裏付けられています。</p>
      <div class="tip-box">
        <p class="tip-box-title"><span class="tip-icon">🏥</span>「医療機器認証」の意味</p>
        <p>「医薬品医療機器等法（薬機法）」に基づき、厚生労働省の認証機関による審査をクリアした証明。<span class="marker-yellow">家庭用医療機器として効果が認められている</span>ため、一般の寝具にはない訴求が可能です。</p>
      </div>

      <h3>② 磁気リカバリー機能：ネオジム磁石48個が血行ケアをサポート</h3>
      <img src="/images/reveria-feature-2.png" alt="ネオジム磁石48個が腰回りの血行を改善" class="article-inline-img" loading="lazy" />
      <p>マットレス内部に <span class="text-navy-bold">最大磁束密度200mT（ミリテスラ）のネオジム磁石を48個</span> 配置。一般的な家庭用磁気治療器は10〜30個程度なので、<span class="marker-yellow">数も磁束密度もトップクラス</span>です。</p>
      <p>磁石は <span class="text-navy-bold">6ゾーン体圧分散</span> の設計に基づき、肩・腰・脚など「コリやすい部位」に集中配置。寝ている間に磁気の力で血流をサポートし、<span class="marker-yellow">慢性的なコリの軽減にアプローチ</span>します。</p>
      <div class="info-card">
        <p class="info-card-title">こんな悩みに磁気アプローチ</p>
        <ul class="info-card-list">
          <li><span class="check-mini">◎</span>慢性的な腰回りのコリ・重だるさ</li>
          <li><span class="check-mini">◎</span>デスクワークによる肩・首のコリ</li>
          <li><span class="check-mini">◎</span>整体・鍼灸に通っても改善しない血行不良</li>
        </ul>
      </div>

      <h3>③ 7層構造×高反発設計：腰部240Nで「沈ませない」サポート</h3>
      <img src="/images/reveria-7layer.png" alt="REVERIAの7層構造断面図" class="article-inline-img" loading="lazy" />
      <p>磁気だけでなく、マットレスとしての基本性能も妥協なし。<span class="text-navy-bold">高反発ウレタン3層（上層150N／中央240N／下層150N）</span>に生地・中綿を加えた <span class="marker-yellow">7層構造</span> で、寝姿勢をしっかりサポートします。</p>

      <p class="layer-intro"><strong>7層の構造内訳：</strong></p>
      <div class="layer-list">
