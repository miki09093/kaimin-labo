---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const affiliateHref = 'https://px.a8.net/svt/ejp?a8mat=4B3N6X+EOOXYQ+2DDC+B8V6SI';

const scores = [
  { label: '①硬さ・反発力', val: 5.0 },
  { label: '②ゾーン設計', val: 5.0 },
  { label: '③リカバリー機能', val: 3.0 },
  { label: '④使いやすさ', val: 4.0 },
  { label: '⑤保証・認証', val: 4.5 },
  { label: '⑥価格（コスパ）', val: 4.0 },
];
const total = scores.reduce((a, b) => a + b.val, 0);

const productName = '雲のやすらぎプレミアム モデル3R';
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": productName,
  "image": new URL('/images/kumo-yasuragi-hero.png', Astro.site).toString(),
  "description": '腰部260Nの超高反発と5層構造ゾーン設計、極厚23cm・100日返金保証付きの日本製マットレス。',
  "brand": { "@type": "Brand", "name": "雲のやすらぎ" },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "JPY",
    "price": "79800",
    "availability": "https://schema.org/InStock",
    "url": "https://px.a8.net/svt/ejp?a8mat=4B3N6X+EOOXYQ+2DDC+B8V6SI"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.6",
    "bestRating": "5",
    "reviewCount": "20"
  }
};

const faqs = [
  { q: 'お届けの状態はどんな状態ですか？', a: 'モデル3Rは圧縮した状態でコンパクトにお届けします。' },
  { q: 'シーツ（カバー）は着脱できますか？', a: 'マットレスカバーは360度開閉式で取り外しが簡単。カバーのみ洗濯することが可能です。' },
  { q: 'どこの国で作られていますか？', a: '日本製です。' },
  { q: 'お手入れ方法は？', a: '風通しのよい日かげで干してください。' },
  { q: '支払い方法は何がありますか？', a: '代金引換／クレジットカード（VISA・MASTER）／NP後払い決済（コンビニ・郵便局・銀行後払い）をご用意しています。' },
  { q: 'ベッドフレームなしで床に直接敷いても大丈夫？', a: '厚さ23cmあるので床敷きでも底つき感はありませんが、カビ防止のため「すのこマット」「除湿シート」との併用を推奨します。フローリングへの直置きは避けてください。' },
  { q: 'シングルとセミダブル、どちらを選ぶべき？', a: '一人用ならシングル（97×200cm）、寝返りを大きく取りたい方や体格が大きい方はセミダブル（120×200cm）が目安です。' },
  { q: '体重が軽くても硬すぎませんか？', a: '腰部260Nの超高反発は「硬め」の設計ですが、体への馴染み方には個人差があります。100日間の返金保証があるので、合わない場合は返品可能です。' },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const goodReviews = [
  { text: '正直、半信半疑で買ったんですが…完全にナメてました。届いて2週間くらいで、毎朝感じてた腰の重だるさが消えてビックリ。もっと早く替えればよかったって今になって思います。', who: '40代男性／会社員' },
  { text: '安いマットを5年くらい使い倒してて、ある朝ベッドから起き上がるのに「うっ…」ってなったのが買い替えのきっかけ。雲のやすらぎに変えてからは、その「うっ」が完全になくなりました。腰がちゃんと支えられてる感覚があります。', who: '30代男性／SE' },
  { text: '夫婦で30年使った敷布団が限界を迎えて、思い切って2枚購入。最初は硬めかな〜と思ったけど、1週間もすれば慣れてきて、今は「もうこれ以外ムリ」状態。腰が朝痛くない生活、最高です。', who: '60代女性／パート' },
  { text: '看護師でずっと立ち仕事してて、家に帰ると腰がガクガクだったんですが、寝具を変えてから「あれ、今日そんなにキツくないかも？」って思う日が増えました。寝てる間に回復してる感じがします。', who: '30代女性／看護師' },
  { text: 'ぶっちゃけ8万円は迷いました。でも整体に月2回通ってた費用と比べたら、長い目で見て絶対安いと思って購入。結果、整体に行く頻度が月1回になり、年間で見たら完全に元取れてます。', who: '50代男性／管理職' },
  { text: '体重が90kgあるので、これまで買ったマットレスは全部「腰だけ沈む」状態で困ってました。これは違う。260Nの腰部、ホントに沈まない。横向き寝でも肩はちゃんと逃がしてくれて、買って正解でした。', who: '40代男性／自営業' },
  { text: '一人暮らしの娘に贈ったら「お母さん、もう実家帰っても自分の部屋で寝たくないくらいこっち最高」って言われました（笑）親としても安心して送り出せる買い物だったかな。', who: '60代女性／主婦' },
  { text: '配送日数は確かに少しかかったけど、届いた瞬間の梱包の丁寧さに驚きました。あとサポートに電話で問い合わせたら、保証の使い方をめちゃくちゃ親切に説明してくれて好印象。', who: '40代女性／会社員' },
  { text: 'デスクワークで一日中座ってると、夜寝る頃には腰がパンパン。これに変えてから、朝起きたときの「リセット感」がぜんぜん違います。仕事のパフォーマンスにも地味に効いてる気がする。', who: '30代男性／Webデザイナー' },
  { text: '購入当初は「硬っ！」って思いましたが、3日もすれば慣れて、今では他のマットで寝るのが苦痛になるレベル。実家に帰省したときの違いで「あ、これいいやつだったんだ」と再確認しました。', who: '20代女性／会社員' },
  { text: '腰のヘルニア持ちで、整形外科の先生に「マットレス変えてみたら？」と勧められて雲のやすらぎを選択。3ヶ月使った今、痛み止めを飲む回数が明らかに減りました。先生にも報告したら「いいの選んだね」と。', who: '50代男性／会社員' },
  { text: '5層構造って書いてあるけど、実際に寝てみると本当に「層」を感じます。腰の部分だけしっかり、肩はふわっと…なんていうか、設計の意図がちゃんと体に伝わってくる感じ。', who: '40代男性／製造業' },
  { text: '出産後の腰痛がひどくて、夫が買ってくれました。子どもがベッドで暴れても底つきしないし、夜中の授乳から戻っても腰がやられない。子育て世帯にこそおすすめしたい。', who: '30代女性／主婦' },
  { text: '安いウレタンマットレスからの買い替え。値段の差は4倍くらいですが、寝心地の差はそれ以上。「マットレスはケチるとこじゃない」って言葉、心から納得しました。', who: '30代男性／公務員' },
  { text: 'うちの旦那、いびきがマシになりました。たぶん寝姿勢が良くなったからかな？私の腰痛改善目当てで買ったのに、思わぬ副産物でラッキー。', who: '40代女性／パート' },
  { text: '海外赴任から帰ってきて、向こうの硬いマットレスに慣れてたので「日本の柔らかい敷布団は無理」と思って探してたら見つけました。日本製でこの硬さ、ありがたい。', who: '40代男性／商社' },
  { text: '高齢の母にプレゼント。「もう寝るのが楽しみ」って言ってくれたのが嬉しすぎる。床に近い敷布団タイプを使ってたので、ベッドフレームに乗せると立ち上がりも楽になったみたいです。', who: '50代女性／自営業' },
  { text: '電気毛布と併用してますが、特に問題なし。冬は表面、夏は裏面と使い分けてます。両面ローテーションができる設計、地味に便利。', who: '50代男性／会社員' },
  { text: '腰だけじゃなく、首・肩のコリも軽くなった気がします。寝てる時間がただの「消費」じゃなくて「回復」になった感覚、これが大事なんだなと実感。', who: '30代女性／Web編集者' },
  { text: '正直、口コミ見ても「ステマじゃない？」って疑ってました。でも100日返金保証があるので「ダメなら返せばいい」と思って購入。返品ボタン押す日は来ませんでした。', who: '40代男性／IT' },
];

const badReviews = [
  { text: '寝心地は文句なしです。ただ、シーツを替えるときに想像の3倍重い。一人暮らしの女性だと結構な力仕事になります。覚悟して買うべし。', who: '30代女性／会社員' },
  { text: '最初の1週間は「これ硬すぎ、失敗したかも」とマジで思いました。でも我慢して使い続けたら慣れたので結果オーライですが、初日の絶望感は伝えておきたい。', who: '40代男性／公務員' },
  { text: '8万円はやっぱり高い。給料3日分くらい飛びました。値段なりの価値はあると思うけど、お財布的にはずっしりきました…。', who: '20代男性／会社員' },
  { text: '注文してから届くまで1週間以上かかりました。「今すぐ寝心地を変えたい！」って急ぎの人には向かないかも。', who: '30代男性／フリーランス' },
  { text: '三つ折りタイプを期待してたら、まさかの一枚もの。立てかけて干すスペースがない我が家には少し厳しかったです。事前にちゃんと確認しなかった自分が悪いけど。', who: '50代女性／パート' },
  { text: '身長150cm体重40kgの小柄な体型だと、260Nはやっぱり硬すぎでした。腰がちっとも沈まないというか、押し返されすぎる感じ。100日保証で結局返品しました。', who: '20代女性／学生' },
  { text: '夏場、なんとなく蒸れる気がします。除湿シート併用でだいぶマシになるけど、「通気性ばっちり！」とまでは言えないかな。', who: '40代男性／会社員' },
  { text: '180cm90kgです。寝心地は最高なんですが、5層構造で厚みがあるぶん、収納時の存在感がすごい。ワンルームには圧迫感あるかも。', who: '30代男性／配送業' },
  { text: '夫婦でダブルを購入。一人で陰干しするときに、もう本当に重くて。腰痛改善のために買ったのに、運ぶときに腰やりそうになりました。本末転倒。', who: '40代女性／主婦' },
  { text: '想像してたよりも厚みがあって、家にあったベッドフレームに乗せたら高さが出すぎてしまった。寝るとき「よっこいしょ」感が増しました。', who: '60代男性／定年退職' },
  { text: '返金保証は確かに付いてますが、条件をきちんと読まないと「返品できると思ってた…」となりかねないです。最低使用日数や手続きの流れ、ちゃんと確認した方がいいですよ。', who: '40代女性／自営業' },
  { text: '硬さに体が慣れるまで2週間くらいかかりました。それまでは朝、逆に腰が筋肉痛みたいになって「失敗したかも」と毎日思ってた。今は快適なので、慣れの期間は必要かも。', who: '30代女性／会社員' },
  { text: '購入前にサイズを測ったつもりが、思ったよりもベッドフレームからはみ出てしまい…。きちんと外寸まで測ったほうが安全です。', who: '50代男性／自営業' },
  { text: '届いてすぐは、新品のウレタン特有の匂いが少しありました。換気して2〜3日でほぼ消えましたが、匂いに敏感な人は届いてすぐ寝ない方がいいかも。', who: '30代女性／看護師' },
  { text: '子ども（小学生）にも使えるかなと思って試したけど、体重が軽すぎて寝心地はイマイチみたいです。やっぱり大人向けかな。', who: '40代女性／主婦' },
  { text: '床にそのまま敷いてたら、3ヶ月でカビの初期症状が…。除湿シート併用必須です。説明書にも書いてあるけど、ちゃんと読まなかった私のミス。', who: '20代男性／一人暮らし' },
  { text: '寝心地は本当にいいんですが、来客時に布団を畳んでしまえないのがネック。和室で使う予定の人は要注意です。', who: '50代女性／主婦' },
  { text: 'シングル買ったけど、結構幅取ります。狭い部屋だと床面積をだいぶ占領するので、ワンルームの方はサイズ感を要チェック。', who: '20代女性／一人暮らし' },
  { text: '夫が「硬すぎる」と言って結局リビングのソファで寝るようになりました…。私には合ってるんですけどね。家族で硬さの好みが分かれるとちょっと困ります。', who: '40代女性／会社員' },
  { text: '腰痛は確かに楽になったけど、「劇的に変わった！」というよりは「じわじわ良くなった」感じ。即効性を期待しすぎないほうがいいかも。', who: '50代男性／会社員' },
];
---
<Layout
  title="雲のやすらぎプレミアム モデル3R 徹底レビュー｜腰部超高反発260Nの寝心地は？"
  description="ランキング1位の雲のやすらぎプレミアム モデル3Rを徹底レビュー。腰部超高反発260N・5層構造・100日返金保証の実力を、当サイト独自の5ポイントで採点しました。"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Header />
  <main>
    <div class="page-header">
      <div class="container">
        <Breadcrumb items={[{ label: 'レビュー', href: '/review/' }, { label: '雲のやすらぎプレミアム モデル3R' }]} />
        <h1>雲のやすらぎプレミアム モデル3R 徹底レビュー｜腰部超高反発260Nの寝心地は？</h1>
        <p style="margin-top: 0.5rem; color: var(--color-text-muted);">公開日：2026.05.15 ／ カテゴリ：レビュー</p>
      </div>
    </div>

    <div class="container article-body" style="max-width: var(--content-width); padding: 2rem 1rem 4rem;">

      <img src="/images/kumo-yasuragi-hero.png" alt="雲のやすらぎプレミアム モデル3R" class="article-hero-img" loading="eager" />

      <p><span class="marker-yellow">「朝起きると腰が痛い」「寝たのに疲れがとれない」</span>――そんな悩みを持つ筆者がリピートしているのが <strong class="text-navy">雲のやすらぎプレミアム モデル3R</strong> です。当サイトのマットレスランキングでも <span class="badge-gold">1位（30点満点中25.5点）</span> をキープし続けるロングセラー。</p>
      <p>この記事では、実際の使用感・ネットの口コミ・5ポイント評価をもとに、「どんな人に向いて、どんな人には合わないか」を掘り下げます。</p>

      <h2>結論：腰痛で悩むなら、まず試したい1台</h2>
      <div class="conclusion-box">
        <p><span class="marker-yellow"><strong>「朝、腰が痛くて起き上がるのがツライ」</strong></span>という方の<span class="text-emphasis">「最初の1台」</span>として本気でおすすめできます。理由は次の3点。</p>
        <ul class="conclusion-list">
          <li><span class="check-icon">✓</span><span class="text-navy-bold">腰部260Nの超高反発</span>で、腰がほぼ沈まない</li>
          <li><span class="check-icon">✓</span>厚さ<span class="text-navy-bold">23cm</span>で底つき感ゼロ、床にもベッドにも使える</li>
          <li><span class="check-icon">✓</span><span class="text-navy-bold">100日間の返金保証</span>付きで、合わなければ返せる</li>
        </ul>
        <p>「硬さ」と「返金保証」がセットでそろう1台は意外と少なく、<span class="text-emphasis">マットレス選びで失敗したくない初心者</span>にとくに向いています。</p>
      </div>

      <div class="score-box">
        <p class="score-box-title">当サイト独自スコア</p>
        <p class="score-box-total"><span class="score-box-num">{total.toFixed(1)}</span><span class="score-box-max">/ 30点</span></p>
        <ul class="score-box-list">
          {scores.map(s => (
            <li><span>{s.label}</span><strong>{s.val.toFixed(1)}</strong></li>
          ))}
        </ul>
      </div>

      <h2>商品ダイジェスト</h2>
      <table>
        <thead>
          <tr><th>項目</th><th>内容</th></tr>
        </thead>
        <tbody>
          <tr><th>価格（税込）</th><td>シングル 79,800円／セミダブル 89,800円／ダブル 99,800円</td></tr>
          <tr><th>サイズ展開</th><td>シングル／セミダブル／ダブル</td></tr>
          <tr><th>厚さ</th><td>23cm（5層構造）</td></tr>
          <tr><th>硬さ</th><td>硬め・高反発（腰部260N）</td></tr>
          <tr><th>保証・お試し</th><td>100日間返金保証（条件あり）</td></tr>
        </tbody>
      </table>

      <h2>ポイント別に実際どうなの？を本音で評価</h2>

      <h3>① 硬さ・反発力：「腰だけ沈まない」って実際こんな感覚</h3>
      <img src="/images/kumo-yasuragi-firmness-compare.png" alt="柔らかいマットレスと雲のやすらぎの腰の沈み込み比較" class="article-inline-img" loading="lazy" />
      <p>最大のウリは、腰の部分に <span class="text-navy-bold">260N（ニュートン）</span> の超高反発ウレタンを採用していること。一般的な高反発マットレスは150〜200Nなので、<span class="marker-yellow">260Nはトップクラスの硬さ</span>です。</p>
      <p>寝てみると、肩や太ももは<span class="text-navy-bold">「ふわっ」</span>と受け止められ、腰だけ<span class="text-navy-bold">「ぐっ」</span>と支えられる感覚。<span class="marker-yellow">背骨が変な角度に曲がらないので、朝の腰の重だるさがほぼ消えます。</span></p>

      <h3>② ゾーン設計：5層構造で「腰は硬く、肩は柔らかく」を実現</h3>
      <img src="/images/kumo-yasuragi-5layers.png" alt="雲のやすらぎプレミアム モデル3Rの5層構造断面図" class="article-inline-img" loading="lazy" />
      <p>全体的に硬いだけでなく、<span class="text-navy-bold">「凹凸プロファイル加工」</span>で5層のウレタンを部位ごとに最適化。<span class="marker-yellow">腰はガッチリ支え、肩は適度に沈ませて圧迫感を逃がす</span>、いわゆるゾーン設計になっています。</p>

      <p class="layer-intro"><strong>5層の構造内訳：</strong></p>
      <div class="layer-list">
        <div class="layer-item"><span class="layer-num">1</span><span class="layer-name">カバー生地</span><span class="layer-role">表面</span></div>
        <div class="layer-item"><span class="layer-num">2</span><span class="layer-name">凸凹プロファイルマット</span><span class="layer-role">体圧分散部</span></div>
        <div class="layer-item highlight"><span class="layer-num">3</span><span class="layer-name">高反発ウレタンマット</span><span class="layer-role"><span class="text-emphasis">寝姿勢保持部（腰部260N）</span></span></div>
        <div class="layer-item"><span class="layer-num">4</span><span class="layer-name">凸凹プロファイルマット</span><span class="layer-role">体圧分散部</span></div>
        <div class="layer-item"><span class="layer-num">5</span><span class="layer-name">カバー生地</span><span class="layer-role">裏面</span></div>
      </div>

