---
import Layout from '../../layouts/Layout.astro';

const questions = [
  {
    q: 'ダイエットで一番ツラいことは？',
    choices: [
      { emoji: '🍰', text: '食欲や甘いものがどうしても我慢できない', type: 'A' },
      { emoji: '⚡', text: 'ストレスがたまるとドカ食いしてしまう', type: 'A' },
      { emoji: '📉', text: '食事を減らしているのに、なぜか体重が落ちない', type: 'B' },
      { emoji: '🏃', text: '運動する時間がない、または運動がとにかく苦手', type: 'C' },
    ],
  },
  {
    q: 'これまでダイエットで挫折した原因に一番近いものは？',
    choices: [
      { emoji: '🍚', text: '食事制限の反動でリバウンドした', type: 'A' },
      { emoji: '🛑', text: '空腹のストレスに耐えられなくなった', type: 'A' },
      { emoji: '🔄', text: '体重が落ちない「停滞期」でモチベーションが切れた', type: 'B' },
      { emoji: '🙅‍♀️', text: 'そもそもキツい努力が苦手で続かなかった', type: 'C' },
    ],
  },
  {
    q: '普段の体質で、一番近いものは？',
    choices: [
      { emoji: '🍕', text: '常に満腹感が得られにくい', type: 'A' },
      { emoji: '⚡', text: 'メンタルが体型に出やすい', type: 'A' },
      { emoji: '❄️', text: 'むくみやすく代謝が悪い', type: 'B' },
      { emoji: '📉', text: '年々締まりがなくなってきた', type: 'C' },
    ],
  },
  {
    q: 'これから痩せるなら、どんな方法が理想？',
    choices: [
      { emoji: '💊', text: '根性に頼らず、食欲を抑えたい', type: 'A' },
      { emoji: '🍗', text: '大好きな食事を我慢したくない', type: 'A' },
      { emoji: '🔬', text: '辛い運動なしで効率よく変えたい', type: 'B' },
      { emoji: '🥗', text: '自炊と運動でコツコツ頑張りたい', type: 'C' },
    ],
  },
];

const results = {
  A: {
    label: 'TYPE A',
    emblem: 'A',
    title: '「食欲コントロール暴走型」タイプ',
    lead: '食欲中枢の乱れが原因かも',
    descHtml: '<p>「お昼はちゃんと我慢できたのに、夜になると何か食べたくなる」<br />「ストレスが溜まった日ほど、気づいたらお菓子の袋が空いてる」<br />そんな心当たり、ありませんか？</p><p>それを今まで意志が弱いせいだと思ってきたなら、たぶん違います。あなたの場合、我慢やストレスの反動で食欲のブレーキが一時的に効かなくなっているだけ。しかもこの食欲は、気合いで抑え込もうとするほど反動が強くなることが分かっています。</p><p>頑張るほど食べたくなる仕組みを相手に、ずっと素手で戦ってきたようなものです。負けて当然だったんです。</p>',
    bridgeHtml: '<p>ここでひとつ、大事な話を。この診断は4つの質問から傾向を見た、いわば仮の答えです。ただ、食欲の強さや満腹感の感じやすさに生まれつきの差があるのは本当で、遺伝子レベルの体質が関係していると言われています。</p><p>もし本当に「食べたくなりやすい体質」なら、我慢を頑張るより先に、やるべきことが変わってきます。逆に体質のせいじゃなかったなら、それはそれでひとつ安心ですよね。どちらにしても、知っておいて損はない話です。</p><p>ディオクリニックのLINEでは、遺伝子検査を含む体質分析について気軽に相談できます。今夜もまた食欲と戦いはじめる前に、答え合わせのつもりで覗いてみてください。</p>',
  },
  B: {
    label: 'TYPE B',
    emblem: 'B',
    title: '「代謝低下型」タイプ',
    lead: 'エネルギー消費の効率がカギ',
    descHtml: '<p>「食べる量は明らかに減らしてるのに、体重が動かない」<br />「同じものを食べてる友達は太らないのに、なぜか自分だけ」<br />そんな心当たり、ありませんか？</p><p>それをまだ努力が足りないせいだと思ってきたなら、たぶん逆です。食事を減らすと、体は飢餓が来たと判断して消費を抑える省エネモードに入ります。しかもこのモードはダイエットを繰り返すほど強化されていくので、真面目に頑張ってきた人ほど陥りやすい状態なんです。</p><p>燃費が良くなりすぎた体で、さらにガソリンだけ絞ってきたようなもの。体重が動かなくて当然だったんです。</p>',
    bridgeHtml: '<p>そしてもうひとつ、知っておいてほしいことがあります。同じ「痩せにくい」でも、糖質で太りやすい人と脂質で太りやすい人がいると言われています。これは生まれつきの体質、遺伝子レベルの話です。</p><p>これを知らずに自己流の食事制限を続けるのは、地図を持たずに山を登るようなもの。糖質制限を頑張ってきたのに実は脂質タイプだった、なんてことになったら、今までの頑張りがもったいなさすぎます。</p><p>ディオクリニックのLINEでは、遺伝子検査を含む体質分析について気軽に相談できます。次のダイエットを始める前に、まず自分の地図を手に入れる。それだけで、同じ遠回りを繰り返さずに済むかもしれません。</p>',
  },
  C: {
    label: 'TYPE C',
    emblem: 'C',
    title: '「自力改善型（高ポテンシャル）」タイプ',
    lead: 'あと一歩で結果が出せる',
    descHtml: '<p>「月曜から本気出す」と決めた週の金曜、もう忘れてる。<br />ジムは契約した。行ってないだけ。<br />耳が痛かったらごめんなさい。でも、安心してください。それだけなんです。</p><p>あなたの体は、食欲が暴走しているわけでも代謝が落ちきっているわけでもなく、正しく続けさえすればちゃんと結果が出る状態です。そして続かないのは飽き性だからではなく、成果が見えるまでが長いやり方を選びがちだから。人は、効いてる実感のないことを続けられるようにはできていません。</p><p>足りないのは根性ではなく、「これなら続く」と思える自分に合ったやり方のほうだったんです。</p>',
    bridgeHtml: '<p>だからこそ大事なのが、最短ルートで頑張ることです。糖質を控えるべき体質なのか、脂質なのか、どんな運動が効きやすいのか。これが最初から分かっていれば、限られたやる気を無駄打ちせずに済みます。いわば自分の説明書を先に手に入れるイメージです。</p><p>実はこうした体質は遺伝子である程度決まっていると言われていて、調べることもできます。ディオクリニックのLINEでは遺伝子検査を含む体質分析について気軽に相談できるので、本気を出す前の下調べとして、先に登録だけしておくのもアリです。</p><p>次の「月曜から本気出す」を、今度こそ最後にするために。準備だけでも、今日から始めてみませんか？</p>',
  },
};

const resultsJson = JSON.stringify(results);
---
<Layout
  title="60秒でわかる｜痩せられない原因タイプ診断"
  description="たった4つの質問であなたが痩せられない本当の原因を診断。食欲暴走型・代謝低下型・自力改善型の3タイプから、あなたに合った痩せ方がわかります。"
>
  <main class="shindan">
    <div class="sh-bg" aria-hidden="true">
      <span class="sh-glow sh-glow-1"></span>
      <span class="sh-glow sh-glow-2"></span>
      <span class="sh-glow sh-glow-3"></span>
    </div>

    <!-- ===== 質問画面 ===== -->
    <section class="sh-screen sh-quiz" data-screen="quiz">
      <div class="sh-inner">
        <div class="sh-topbanner">
          <img src="/images/shindan-hero.png" alt="痩せられない原因タイプ診断" loading="eager" onerror="this.parentElement.style.display='none'" />
        </div>
        <div class="sh-progress">
          <div class="sh-progress-info">
            <span class="sh-progress-current" data-progress-current>1</span>
            <span class="sh-progress-total">/ {questions.length}</span>
          </div>
          <div class="sh-progress-bar">
            <div class="sh-progress-fill" data-progress-fill></div>
          </div>
        </div>

        {questions.map((question, qi) => (
          <div class="sh-question" data-question={qi} hidden={qi !== 0}>
            <p class="sh-q-num">Question {String(qi + 1).padStart(2, '0')}</p>
            <h2 class="sh-q-text">{question.q}</h2>
            <div class="sh-choices">
              {question.choices.map((choice, ci) => (
                <button class="sh-choice" data-type={choice.type} data-qi={qi}>
                  <span class="sh-choice-num">{String(ci + 1).padStart(2, '0')}</span>
                  <span class="sh-choice-text">{choice.text}</span>
                  <span class="sh-choice-check" aria-hidden="true">✓</span>
                </button>
              ))}
            </div>
          </div>
        ))}

        <button class="sh-back" data-back hidden>‹ 前の質問にもどる</button>

        <p class="sh-quiz-pr">※ 本ページはプロモーションを含みます。</p>
      </div>
    </section>

    <!-- ===== 結果画面 ===== -->
    <section class="sh-screen sh-result" data-screen="result" hidden>
      <div class="sh-inner">
        <div class="sh-result-content" data-result-content>
          <p class="sh-result-tag">診断結果</p>

          <div class="sh-result-emblem" data-result-emblem></div>

          <p class="sh-result-label" data-result-label></p>
          <h2 class="sh-result-title" data-result-title></h2>
          <p class="sh-result-lead" data-result-lead></p>

          <div class="sh-result-desc" data-result-desc></div>

          <div class="sh-result-bridge" data-result-bridge></div>

          <div class="sh-result-cta-box">
            <p class="sh-line-cta-sub">＼ 見るだけ・聞くだけでもOK ／</p>
            <a class="sh-line-cta" data-line-cta role="button">
              <span class="sh-line-cta-main">とりあえずLINEで見てみる</span>
              <span class="sh-line-cta-arrow">→</span>
            </a>
            <p class="sh-cta-note">合わなければブロックでOK</p>
          </div>

          <button class="sh-retry" data-retry>もう一度診断する</button>

          <div class="sh-result-notes">
            <p>※ 本診断は一般的な傾向に基づく簡易チェックであり、医学的診断ではありません。</p>
            <p>※ 効果には個人差があります。</p>
            <p>※ 本ページはプロモーションを含みます。</p>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script define:vars={{ resultsJson }}>
  const results = JSON.parse(resultsJson);
  const screens = {
    quiz: document.querySelector('[data-screen="quiz"]'),
    result: document.querySelector('[data-screen="result"]'),
  };
  const questions = Array.from(document.querySelectorAll('.sh-question'));
  const total = questions.length;
  const progressCurrent = document.querySelector('[data-progress-current]');
  const progressFill = document.querySelector('[data-progress-fill]');
  const backBtn = document.querySelector('[data-back]');
  const resultContent = document.querySelector('[data-result-content]');

  let current = 0;
  let locked = false;
  const answers = [];

  function reflowAnim(el, cls) {
    if (!el) return;
    el.classList.remove(cls);
    void el.offsetWidth;
    el.classList.add(cls);
  }

  function showScreen(name) {
    Object.entries(screens).forEach(([key, el]) => {
      if (el) el.hidden = key !== name;
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showQuestion(index) {
    questions.forEach((q, i) => {
      q.hidden = i !== index;
      // 選択状態をリセット
      q.querySelectorAll('.sh-choice').forEach(c => c.classList.remove('is-selected'));
    });
    if (progressCurrent) progressCurrent.textContent = String(index + 1);
    if (progressFill) progressFill.style.width = (index / total * 100) + '%';
    if (backBtn) backBtn.hidden = index === 0;
    reflowAnim(questions[index], 'is-anim');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // 初期表示
  showQuestion(0);
  reflowAnim(questions[0], 'is-anim');

  // 選択肢クリック（✓表示 → 少しためて次へ）
  document.querySelectorAll('.sh-choice').forEach(btn => {
    btn.addEventListener('click', () => {
      if (locked) return;
      locked = true;
      const qi = Number(btn.getAttribute('data-qi'));
      answers[qi] = btn.getAttribute('data-type');
      btn.classList.add('is-selected');

      setTimeout(() => {
        locked = false;
        if (current < total - 1) {
          current++;
          showQuestion(current);
        } else {
          if (progressFill) progressFill.style.width = '100%';
          finish();
        }
      }, 340);
    });
  });

  // 戻る
  backBtn?.addEventListener('click', () => {
    if (locked) return;
    if (current > 0) {
      current--;
      showQuestion(current);
    }
  });

  // 判定（同点時は A > B > C の優先順位）
  function judge() {
    const score = { A: 0, B: 0, C: 0 };
    answers.forEach(t => { if (t) score[t]++; });
    const max = Math.max(score.A, score.B, score.C);
    if (score.A === max) return 'A';
    if (score.B === max) return 'B';
    return 'C';
  }

  function finish() {
    const type = judge();
    const r = results[type];
    if (resultContent) resultContent.setAttribute('data-type', type);
    document.querySelector('[data-result-emblem]').textContent = r.emblem;
    document.querySelector('[data-result-label]').textContent = r.label;
    document.querySelector('[data-result-title]').textContent = r.title;
    document.querySelector('[data-result-lead]').textContent = r.lead;
    document.querySelector('[data-result-desc]').innerHTML = r.descHtml;
    document.querySelector('[data-result-bridge]').innerHTML = r.bridgeHtml;

    showScreen('result');
    reflowAnim(resultContent, 'is-reveal');
  }

  // もう一度
  document.querySelector('[data-retry]')?.addEventListener('click', () => {
    current = 0;
    locked = false;
    answers.length = 0;
    showScreen('quiz');
    showQuestion(0);
  });
</script>

<style>
  .shindan {
    position: relative;
    min-height: 100vh;
    background: linear-gradient(175deg, #FBF3F0 0%, #FDF9F6 45%, #F8ECE7 100%);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #4D403C;
  }

  /* ===== 背景の浮遊グロー ===== */
  .sh-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .sh-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.5;
    animation: sh-float 16s ease-in-out infinite;
  }
  .sh-glow-1 {
    top: -80px; right: -60px;
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(224,150,138,0.5) 0%, transparent 70%);
  }
  .sh-glow-2 {
    top: 42%; left: -100px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(197,168,201,0.4) 0%, transparent 70%);
    animation-delay: -6s;
  }
  .sh-glow-3 {
    bottom: -80px; right: 8%;
    width: 260px; height: 260px;
    background: radial-gradient(circle, rgba(240,196,170,0.5) 0%, transparent 70%);
    animation-delay: -11s;
  }
  @keyframes sh-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(18px, -22px) scale(1.08); }
    66% { transform: translate(-16px, 14px) scale(0.95); }
  }

  .sh-screen {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 2rem 1.15rem 3rem;
  }
  .sh-screen[hidden] { display: none; }
  .sh-inner {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  /* ===== アニメーション ===== */
  @keyframes sh-fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes sh-reveal {
    0% { opacity: 0; transform: translateY(24px) scale(0.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes sh-pop {
    0% { transform: scale(0); }
    70% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }
  .sh-question.is-anim { animation: sh-fade-up 0.42s cubic-bezier(0.22,0.61,0.36,1); }
  .sh-result-content.is-reveal { animation: sh-reveal 0.55s cubic-bezier(0.22,0.61,0.36,1); }

  /* ===== 上部バナー（設問中は常時表示） ===== */
  .sh-topbanner {
    margin: 0 0 1.5rem;
    border-radius: 18px;
    overflow: hidden;
    line-height: 0;
    box-shadow: 0 14px 34px -18px rgba(150, 95, 85, 0.4);
  }
  .sh-topbanner img { width: 100%; height: auto; display: block; }

  /* ===== プログレス ===== */
  .sh-progress { margin-bottom: 2rem; }
  .sh-progress-info {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 0.7rem;
  }
  .sh-progress-current {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 1.6rem;
    font-weight: 700;
    color: #C9766B;
    line-height: 1;
  }
  .sh-progress-total {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 0.95rem;
    color: #B39C95;
  }
  .sh-progress-bar {
    position: relative;
    height: 6px;
    background: #F0DFD9;
    border-radius: 999px;
    overflow: hidden;
  }
  .sh-progress-fill {
    position: relative;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #D8897E 0%, #EDB39D 100%);
    border-radius: 999px;
    transition: width 0.45s cubic-bezier(0.22,0.61,0.36,1);
    overflow: hidden;
  }
  .sh-progress-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 20%, rgba(255,255,255,0.6) 50%, transparent 80%);
    transform: translateX(-100%);
    animation: sh-shine 2.4s ease-in-out infinite;
  }
  @keyframes sh-shine {
    to { transform: translateX(200%); }
  }

  /* ===== 質問 ===== */
  .sh-q-num {
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 0.82rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #C9766B;
    margin: 0 0 0.6rem;
  }
  .sh-q-text {
    text-align: center;
    font-size: clamp(1.15rem, 4.6vw, 1.45rem);
    font-weight: 700;
    color: #4D403C;
    line-height: 1.6;
    letter-spacing: 0.01em;
    margin: 0 0 1.75rem;
  }
  .sh-choices { display: grid; gap: 0.8rem; }
  .sh-choice {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.05rem 1.15rem;
    background: #fff;
    border: 1.5px solid #F0E1DB;
    border-radius: 16px;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 8px 20px -14px rgba(150, 95, 85, 0.35);
    transition: border-color 0.18s ease, transform 0.12s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .sh-choice:hover {
    border-color: #DFA095;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -14px rgba(200, 118, 107, 0.45);
  }
  .sh-choice:active { transform: translateY(0); }
  .sh-choice-num {
    flex-shrink: 0;
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    border: 1.5px solid #E8C8C0;
    border-radius: 50%;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 0.88rem;
    color: #C9766B;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .sh-choice-text {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 600;
    color: #4D403C;
    line-height: 1.55;
  }
  .sh-choice-check {
    flex-shrink: 0;
    width: 24px; height: 24px;
    display: flex; align-items: center; justify-content: center;
    background: #C9766B;
    color: #fff;
    border-radius: 50%;
    font-size: 0.78rem;
    font-weight: 700;
    opacity: 0;
    transform: scale(0);
    transition: opacity 0.15s ease;
  }
  /* 選択時フィードバック */
  .sh-choice.is-selected {
    border-color: #C9766B;
    background: #FBF0ED;
    box-shadow: 0 14px 28px -12px rgba(201, 118, 107, 0.5);
  }
  .sh-choice.is-selected .sh-choice-num {
    background: #C9766B;
    border-color: #C9766B;
    color: #fff;
  }
  .sh-choice.is-selected .sh-choice-check {
    opacity: 1;
    animation: sh-pop 0.3s ease forwards;
