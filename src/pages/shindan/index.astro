---
import Layout from '../../layouts/Layout.astro';

const questions = [
  {
    q: 'ダイエットで一番ツラいことは？',
    choices: [
      { emoji: '🍰', text: '食欲や甘いものがどうしても我慢できない', type: 'A' },
      { emoji: '⚡', text: 'ストレスがたまるとドカ食いしてしまう', type: 'A' },
      { emoji: '📉', text: '食事を減らしているのに、なぜか体重が落ちない', type: 'B' },
      { emoji: '🏃', text: '運動する時間がない、または運動がとにかく苦手', type: 'C' },
    ],
  },
  {
    q: 'これまでダイエットで挫折した原因に一番近いものは？',
    choices: [
      { emoji: '🍚', text: '食事制限の反動でリバウンドした', type: 'A' },
      { emoji: '🛑', text: '空腹のストレスに耐えられなくなった', type: 'A' },
      { emoji: '🔄', text: '体重が落ちない「停滞期」でモチベーションが切れた', type: 'B' },
      { emoji: '🙅‍♀️', text: 'そもそもキツい努力が苦手で続かなかった', type: 'C' },
    ],
  },
  {
    q: '普段の体質で、一番近いものは？',
    choices: [
      { emoji: '🍕', text: '常に満腹感が得られにくい', type: 'A' },
      { emoji: '⚡', text: 'メンタルが体型に出やすい', type: 'A' },
      { emoji: '❄️', text: 'むくみやすく代謝が悪い', type: 'B' },
      { emoji: '📉', text: '年々締まりがなくなってきた', type: 'C' },
    ],
  },
  {
    q: 'これから痩せるなら、どんな方法が理想？',
    choices: [
      { emoji: '💊', text: '根性に頼らず、食欲を抑えたい', type: 'A' },
      { emoji: '🍗', text: '大好きな食事を我慢したくない', type: 'A' },
      { emoji: '🔬', text: '辛い運動なしで効率よく変えたい', type: 'B' },
      { emoji: '🥗', text: '自炊と運動でコツコツ頑張りたい', type: 'C' },
    ],
  },
];

const results = {
  A: {
    label: 'TYPE A',
    title: '「食欲コントロール暴走型」タイプ',
    lead: '食欲中枢の乱れが原因かも',
    desc: 'あなたは代謝が極端に悪いわけではなく、ストレスや我慢の反動による「食欲中枢の乱れ（過食・ドカ食い）」が一番の大きな原因となっています。根性や意志の力だけでこの食欲を抑え続けるのは、科学的にも非常に困難です。',
    cta: 'そんなあなたには、無理な我慢をせず、医学の力で自然に食欲をコントロールするアプローチが最も効果的です。今なら公式LINE登録限定で、あなたの暴走する食欲をピタッと止める「医療ダイエットの具体策」を無料公開中！まずは下のボタンから登録して、楽に痩せる第一歩を踏み出しましょう！',
    img: '/images/shindan-result-a.png',
  },
  B: {
    label: 'TYPE B',
    title: '「代謝低下型」タイプ',
    lead: 'エネルギー消費の効率がカギ',
    desc: 'あなたは食べる量を減らしているのにもかかわらず、長年の運動不足や過去のリバウンド経験、あるいは冷え・むくみによって「エネルギー消費の効率（代謝）」が著しく落ちてしまっています。この状態のまま無理な食事制限を重ねても、体が飢餓状態になり、さらに痩せにくくなる悪循環に陥ります。',
    cta: 'そんなあなたに必要なのは、ツラい運動ではなく、科学の力で細胞や体質そのものにアプローチし、代謝を底上げすることです。公式LINEでは、医療機器（脂肪冷却など）を用いた「寝ているだけで代謝を上げる最新ノウハウ」を配信中！今すぐ登録して、痩せ体質への切符を手に入れてください！',
    img: '/images/shindan-result-b.png',
  },
  C: {
    label: 'TYPE C',
    title: '「自力改善型（高ポテンシャル）」タイプ',
    lead: 'あと一歩で結果が出せる',
    desc: 'あなたの体は、食欲が異常にバグっているわけでも、代謝がフリーズしているわけでもありません。ただ「自炊や運動を毎日コツコツ継続すること」へのハードルの高さや、仕事・生活の忙しさが原因で、あと一歩が踏み出せていない状態です。',
    cta: '本来なら、正しい食事と適度な運動を行えば、自分の力で十分に結果を出せる高いポテンシャルを持っています！公式LINEでは、忙しいあなたでも今日からできる「最短効率の自力ダイエットマニュアル」を無料プレゼント中。万が一、どうしてもサボりたくなった時の『裏ワザとしての医療ダイエット活用法』も紹介しているので、まずは情報収集としてお気軽にLINE登録しておいてください！',
    img: '/images/shindan-result-c.png',
  },
};

const resultsJson = JSON.stringify(results);
---
<Layout
  title="60秒でわかる｜痩せられない原因タイプ診断"
  description="たった4つの質問であなたが痩せられない本当の原因を診断。食欲暴走型・代謝低下型・自力改善型の3タイプから、あなたに合った痩せ方がわかります。"
>
  <main class="shindan">

    <!-- ===== 質問画面 ===== -->
    <section class="sh-screen sh-quiz" data-screen="quiz">
      <div class="sh-inner">
        <div class="sh-progress">
          <div class="sh-progress-info">
            <span class="sh-progress-current" data-progress-current>1</span>
            <span class="sh-progress-total">/ {questions.length}</span>
          </div>
          <div class="sh-progress-bar">
            <div class="sh-progress-fill" data-progress-fill></div>
          </div>
        </div>

        {questions.map((question, qi) => (
          <div class="sh-question" data-question={qi} hidden={qi !== 0}>
            <p class="sh-q-num">Q{qi + 1}</p>
            <h2 class="sh-q-text">{question.q}</h2>
            <div class="sh-choices">
              {question.choices.map(choice => (
                <button class="sh-choice" data-type={choice.type} data-qi={qi}>
                  <span class="sh-choice-emoji">{choice.emoji}</span>
                  <span class="sh-choice-text">{choice.text}</span>
                </button>
              ))}
            </div>
          </div>
        ))}

        <button class="sh-back" data-back hidden>‹ 前の質問にもどる</button>
      </div>
    </section>

    <!-- ===== 結果画面 ===== -->
    <section class="sh-screen sh-result" data-screen="result" hidden>
      <div class="sh-inner">
        <div class="sh-result-content" data-result-content>
          <p class="sh-result-tag">診断結果</p>
          <p class="sh-result-label" data-result-label></p>
          <h2 class="sh-result-title" data-result-title></h2>
          <p class="sh-result-lead" data-result-lead></p>

          <div class="sh-result-img" data-result-img>
            <img src="" alt="診断結果" data-result-img-el onerror="this.parentElement.style.display='none'" />
          </div>

          <div class="sh-result-desc">
            <p data-result-desc></p>
          </div>

          <div class="sh-result-cta-box">
            <p class="sh-result-cta-text" data-result-cta></p>
            <p class="sh-line-cta-sub">＼ 今だけ無料公開中 ／</p>
            <a class="sh-line-cta" data-line-cta role="button">
              <span class="sh-line-cta-main">公式LINEで無料で受け取る</span>
              <span class="sh-line-cta-arrow">›</span>
            </a>
          </div>

          <button class="sh-retry" data-retry>もう一度診断する</button>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script define:vars={{ resultsJson }}>
  const results = JSON.parse(resultsJson);
  const screens = {
    quiz: document.querySelector('[data-screen="quiz"]'),
    result: document.querySelector('[data-screen="result"]'),
  };
  const questions = Array.from(document.querySelectorAll('.sh-question'));
  const total = questions.length;
  const progressCurrent = document.querySelector('[data-progress-current]');
  const progressFill = document.querySelector('[data-progress-fill]');
  const backBtn = document.querySelector('[data-back]');

  let current = 0;
  const answers = [];

  function showScreen(name) {
    Object.entries(screens).forEach(([key, el]) => {
      if (el) el.hidden = key !== name;
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showQuestion(index) {
    questions.forEach((q, i) => { q.hidden = i !== index; });
    if (progressCurrent) progressCurrent.textContent = String(index + 1);
    if (progressFill) progressFill.style.width = ((index) / total * 100) + '%';
    if (backBtn) backBtn.hidden = index === 0;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // 初期表示
  showQuestion(0);

  // 選択肢クリック
  document.querySelectorAll('.sh-choice').forEach(btn => {
    btn.addEventListener('click', () => {
      const qi = Number(btn.getAttribute('data-qi'));
      answers[qi] = btn.getAttribute('data-type');
      if (current < total - 1) {
        current++;
        showQuestion(current);
      } else {
        if (progressFill) progressFill.style.width = '100%';
        finish();
      }
    });
  });

  // 戻る
  backBtn?.addEventListener('click', () => {
    if (current > 0) {
      current--;
      showQuestion(current);
    }
  });

  // 判定（同点時は A > B > C の優先順位）
  function judge() {
    const score = { A: 0, B: 0, C: 0 };
    answers.forEach(t => { if (t) score[t]++; });
    const max = Math.max(score.A, score.B, score.C);
    if (score.A === max) return 'A';
    if (score.B === max) return 'B';
    return 'C';
  }

  function finish() {
    const type = judge();
    const r = results[type];
    document.querySelector('[data-result-label]').textContent = r.label;
    document.querySelector('[data-result-title]').textContent = r.title;
    document.querySelector('[data-result-lead]').textContent = r.lead;
    document.querySelector('[data-result-desc]').textContent = r.desc;
    document.querySelector('[data-result-cta]').textContent = r.cta;

    const imgWrap = document.querySelector('[data-result-img]');
    const imgEl = document.querySelector('[data-result-img-el]');
    if (imgEl && imgWrap) {
      imgWrap.style.display = '';
      imgEl.setAttribute('src', r.img);
    }

    showScreen('result');
  }

  // もう一度
  document.querySelector('[data-retry]')?.addEventListener('click', () => {
    current = 0;
    answers.length = 0;
    showScreen('quiz');
    showQuestion(0);
  });
</script>

<style>
  .shindan {
    min-height: 100vh;
    background: linear-gradient(180deg, #EAF1F8 0%, #F5F8FC 45%, #FDF0F0 100%);
    display: flex;
    flex-direction: column;
  }
  .sh-screen {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 2rem 1.15rem 3rem;
  }
  .sh-inner {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  /* ===== プログレス ===== */
  .sh-progress { margin-bottom: 2rem; }
  .sh-progress-info {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.3rem;
    margin-bottom: 0.6rem;
  }
  .sh-progress-current {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-accent-dark);
    line-height: 1;
  }
  .sh-progress-total { font-size: 0.95rem; font-weight: 700; color: var(--color-text-muted); }
  .sh-progress-bar {
    height: 8px;
    background: #DCE5EF;
    border-radius: 999px;
    overflow: hidden;
  }
  .sh-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-accent) 100%);
    border-radius: 999px;
    transition: width 0.35s ease;
  }

  /* ===== 質問 ===== */
  .sh-q-num {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--color-accent-dark);
    margin: 0 0 0.5rem;
  }
  .sh-q-text {
    text-align: center;
    font-size: clamp(1.2rem, 4.8vw, 1.5rem);
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1.5;
    margin: 0 0 1.75rem;
  }
  .sh-choices { display: grid; gap: 0.85rem; }
  .sh-choice {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    padding: 1.1rem 1.15rem;
    background: #fff;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 4px 14px -8px rgba(19,62,107,0.25);
    transition: border-color 0.18s ease, transform 0.12s ease, box-shadow 0.18s ease;
  }
  .sh-choice:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 10px 22px -10px rgba(0,196,154,0.5);
  }
  .sh-choice:active { transform: translateY(0); }
  .sh-choice-emoji {
    flex-shrink: 0;
    width: 46px; height: 46px;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-bg-gray);
    border-radius: 50%;
    font-size: 1.4rem;
  }
  .sh-choice-text {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.5;
  }
  .sh-back {
    display: block;
    margin: 1.75rem auto 0;
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.5rem;
  }
  .sh-back:hover { color: var(--color-primary); }

  /* ===== 結果 ===== */
  .sh-result-content { text-align: center; }
  .sh-result-tag {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .sh-result-label {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: var(--color-accent-dark);
    margin: 0 0 0.4rem;
  }
  .sh-result-title {
    font-size: clamp(1.4rem, 5.5vw, 1.9rem);
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1.45;
    margin: 0 0 0.6rem;
  }
  .sh-result-lead {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-cta);
    margin: 0 0 1.5rem;
  }
  .sh-result-img {
    margin: 0 auto 1.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    line-height: 0;
    box-shadow: var(--shadow-md);
  }
  .sh-result-img img { width: 100%; height: auto; }
  .sh-result-desc {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 1.4rem 1.35rem;
    text-align: left;
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.5rem;
  }
  .sh-result-desc p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.95;
    color: #333;
  }

  /* ===== 結果CTA ===== */
  .sh-result-cta-box {
    background: linear-gradient(135deg, rgba(0,196,154,0.08) 0%, rgba(19,62,107,0.06) 100%);
    border: 1px solid rgba(0,196,154,0.22);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.35rem;
    margin-bottom: 1.5rem;
  }
  .sh-result-cta-text {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    line-height: 1.95;
    color: #2a3547;
    text-align: left;
    font-weight: 500;
  }
  .sh-line-cta-sub {
    font-size: 0.9rem;
    font-weight: 800;
    color: #06B94E;
    margin: 0 0 0.5rem;
  }
  .sh-line-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1.15rem 1.4rem;
    background: linear-gradient(135deg, #06C755 0%, #05B14C 100%);
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 10px 24px -8px rgba(6,199,85,0.55);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .sh-line-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -8px rgba(6,199,85,0.6);
    text-decoration: none;
  }
  .sh-line-cta-main {
    color: #fff;
    font-size: 1.1rem;
    font-weight: 900;
  }
  .sh-line-cta-arrow {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
  }
  .sh-retry {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.5rem;
    text-decoration: underline;
  }
  .sh-retry:hover { color: var(--color-primary); }

  @media (max-width: 480px) {
    .sh-screen { padding: 1.5rem 1rem 2.5rem; }
    .sh-choice-text { font-size: 0.92rem; }
    .sh-choice-emoji { width: 42px; height: 42px; font-size: 1.25rem; }
  }
</style>
