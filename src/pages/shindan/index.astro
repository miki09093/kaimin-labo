---
import Layout from '../../layouts/Layout.astro';

const questions = [
  {
    q: 'ダイエットで一番ツラいことは？',
    choices: [
      { emoji: '🍰', text: '食欲や甘いものがどうしても我慢できない', type: 'A' },
      { emoji: '⚡', text: 'ストレスがたまるとドカ食いしてしまう', type: 'A' },
      { emoji: '📉', text: '食事を減らしているのに、なぜか体重が落ちない', type: 'B' },
      { emoji: '🏃', text: '運動する時間がない、または運動がとにかく苦手', type: 'C' },
    ],
  },
  {
    q: 'これまでダイエットで挫折した原因に一番近いものは？',
    choices: [
      { emoji: '🍚', text: '食事制限の反動でリバウンドした', type: 'A' },
      { emoji: '🛑', text: '空腹のストレスに耐えられなくなった', type: 'A' },
      { emoji: '🔄', text: '体重が落ちない「停滞期」でモチベーションが切れた', type: 'B' },
      { emoji: '🙅‍♀️', text: 'そもそもキツい努力が苦手で続かなかった', type: 'C' },
    ],
  },
  {
    q: '普段の体質で、一番近いものは？',
    choices: [
      { emoji: '🍕', text: '常に満腹感が得られにくい', type: 'A' },
      { emoji: '⚡', text: 'メンタルが体型に出やすい', type: 'A' },
      { emoji: '❄️', text: 'むくみやすく代謝が悪い', type: 'B' },
      { emoji: '📉', text: '年々締まりがなくなってきた', type: 'C' },
    ],
  },
  {
    q: 'これから痩せるなら、どんな方法が理想？',
    choices: [
      { emoji: '💊', text: '根性に頼らず、食欲を抑えたい', type: 'A' },
      { emoji: '🍗', text: '大好きな食事を我慢したくない', type: 'A' },
      { emoji: '🔬', text: '辛い運動なしで効率よく変えたい', type: 'B' },
      { emoji: '🥗', text: '自炊と運動でコツコツ頑張りたい', type: 'C' },
    ],
  },
];

const results = {
  A: {
    label: 'TYPE A',
    emblem: '🔥',
    title: '「食欲コントロール暴走型」タイプ',
    lead: '食欲中枢の乱れが原因かも',
    descHtml: '<p>「お昼はちゃんと我慢できたのに、夜になると何か食べたくなる」<br />「ストレスが溜まった日ほど、気づいたらお菓子の袋が空いてる」<br />——心当たり、ありませんか？</p><p>それを今まで<strong>「意志が弱いせい」だと思ってきたなら、たぶん違います</strong>。あなたの場合、我慢やストレスの反動で、食欲のブレーキが一時的に効かなくなっているだけ。しかもこの食欲は、気合いで抑え込もうとするほど反動が強くなることが分かっています。</p><p>つまり、<strong>頑張るほど食べたくなる仕組みを相手に、ずっと素手で戦ってきた</strong>ようなもの。負けて当然だったんです。</p>',
    bridgeHtml: '<p>ここでひとつ、大事な話を。この診断は4つの質問だけの簡易チェックですが、食欲の強さや満腹感の感じやすさには、生まれつきの体質——<strong>遺伝子レベルの差</strong>があると言われています。つまり「食べたくなりやすい体質」は本当に存在するということ。</p><p>自分がそのタイプかどうかは、さすがに4問では分かりません。ディオクリニックのLINEでは、遺伝子検査を含む体質分析について相談できるので、「私の食欲、体質のせいかも」と思った人は一度覗いてみてください。答え合わせ、ちょっと気になりませんか？</p>',
  },
  B: {
    label: 'TYPE B',
    emblem: '❄️',
    title: '「代謝低下型」タイプ',
    lead: 'エネルギー消費の効率がカギ',
    descHtml: '<p>「食べる量は明らかに減らしてるのに、体重が動かない」<br />「同じものを食べてる友達は太らないのに、なぜか自分だけ…」<br />——心当たり、ありませんか？</p><p>それを<strong>「まだ努力が足りないせい」だと思ってきたなら、たぶん逆です</strong>。食事を減らすと、体は「飢餓が来た」と判断して消費を抑える省エネモードに入ります。しかもこのモードは、ダイエットを繰り返すほど強化されていく。つまり、<strong>真面目に頑張ってきた人ほど陥りやすい状態</strong>なんです。</p><p>燃費が良くなりすぎた体で、さらにガソリンだけ絞ってきたようなもの。体重が動かなくて、当然だったんです。</p>',
    bridgeHtml: '<p>そしてもうひとつ、知っておいてほしいことが。同じ「痩せにくい」でも、<strong>糖質で太りやすい人と、脂質で太りやすい人がいる</strong>と言われています。これは生まれつきの体質、つまり遺伝子レベルの話。ここを知らずに「とりあえず糖質制限」を選んで、実は脂質タイプだった——なんてことになると、努力がまるごと空振りします。</p><p>ディオクリニックのLINEでは、遺伝子検査を含む体質分析について相談できます。闇雲に頑張る前に、自分の"燃費のタイプ"を確かめておくと、遠回りせずに済むかもしれません。</p>',
  },
  C: {
    label: 'TYPE C',
    emblem: '🌱',
    title: '「自力改善型（高ポテンシャル）」タイプ',
    lead: 'あと一歩で結果が出せる',
    descHtml: '<p>「月曜から本気出す」と決めた週の金曜、もう忘れてる。<br />ジムは契約した。行ってないだけ。<br />——耳が痛かったらごめんなさい。でも、安心してください。<strong>それだけ</strong>なんです。</p><p>あなたの体は、食欲が暴走しているわけでも、代謝が落ちきっているわけでもなく、正しく続けさえすればちゃんと結果が出る状態。そして「続かない」のは飽き性だからではなく、<strong>成果が見えるまでが長いやり方を選びがちだから</strong>。人は、効いてる実感のないことを続けられるようにはできていません。</p><p>足りないのは根性ではなく、<strong>「これなら続く」と思える、自分に合ったやり方</strong>のほうだったんです。</p>',
    bridgeHtml: '<p>だからこそ大事なのが、最短ルートで頑張ること。糖質を控えるべき体質なのか、脂質なのか、どんな運動が効きやすいのか——これが最初から分かっていれば、限られたやる気を無駄打ちせずに済みます。いわば<strong>"自分の説明書"を先に手に入れる</strong>イメージです。</p><p>ディオクリニックのLINEでは、遺伝子検査を含む体質分析について相談できます。本気を出す前の下調べとして、登録だけしておくのもアリだと思います。</p>',
  },
};

const resultsJson = JSON.stringify(results);
---
<Layout
  title="60秒でわかる｜痩せられない原因タイプ診断"
  description="たった4つの質問であなたが痩せられない本当の原因を診断。食欲暴走型・代謝低下型・自力改善型の3タイプから、あなたに合った痩せ方がわかります。"
>
  <main class="shindan">
    <div class="sh-bg" aria-hidden="true">
      <span class="sh-glow sh-glow-1"></span>
      <span class="sh-glow sh-glow-2"></span>
      <span class="sh-glow sh-glow-3"></span>
    </div>

    <!-- ===== 質問画面 ===== -->
    <section class="sh-screen sh-quiz" data-screen="quiz">
      <div class="sh-inner">
        <div class="sh-topbanner">
          <img src="/images/shindan-hero.png" alt="痩せられない原因タイプ診断" loading="eager" onerror="this.parentElement.style.display='none'" />
        </div>
        <div class="sh-progress">
          <div class="sh-progress-info">
            <span class="sh-progress-current" data-progress-current>1</span>
            <span class="sh-progress-total">/ {questions.length}</span>
          </div>
          <div class="sh-progress-bar">
            <div class="sh-progress-fill" data-progress-fill></div>
          </div>
        </div>

        {questions.map((question, qi) => (
          <div class="sh-question" data-question={qi} hidden={qi !== 0}>
            <p class="sh-q-num">Q{qi + 1}</p>
            <h2 class="sh-q-text">{question.q}</h2>
            <div class="sh-choices">
              {question.choices.map(choice => (
                <button class="sh-choice" data-type={choice.type} data-qi={qi}>
                  <span class="sh-choice-emoji">{choice.emoji}</span>
                  <span class="sh-choice-text">{choice.text}</span>
                  <span class="sh-choice-check" aria-hidden="true">✓</span>
                </button>
              ))}
            </div>
          </div>
        ))}

        <button class="sh-back" data-back hidden>‹ 前の質問にもどる</button>

        <p class="sh-quiz-pr">※ 本ページはプロモーションを含みます。</p>
      </div>
    </section>

    <!-- ===== 結果画面 ===== -->
    <section class="sh-screen sh-result" data-screen="result" hidden>
      <div class="sh-inner">
        <div class="sh-result-content" data-result-content>
          <p class="sh-result-tag">診断結果</p>

          <div class="sh-result-emblem" data-result-emblem></div>

          <p class="sh-result-label" data-result-label></p>
          <h2 class="sh-result-title" data-result-title></h2>
          <p class="sh-result-lead" data-result-lead></p>

          <div class="sh-result-desc" data-result-desc></div>

          <div class="sh-result-bridge" data-result-bridge></div>

          <div class="sh-result-cta-box">
            <p class="sh-line-cta-sub">＼ 見るだけ・聞くだけでもOK ／</p>
            <a class="sh-line-cta" data-line-cta role="button">
              <span class="sh-line-cta-main">とりあえずLINEで見てみる</span>
              <span class="sh-line-cta-arrow">→</span>
            </a>
            <p class="sh-cta-note">合わなければブロックでOK</p>
          </div>

          <button class="sh-retry" data-retry>もう一度診断する</button>

          <div class="sh-result-notes">
            <p>※ 本診断は一般的な傾向に基づく簡易チェックであり、医学的診断ではありません。</p>
            <p>※ 効果には個人差があります。</p>
            <p>※ 本ページはプロモーションを含みます。</p>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script define:vars={{ resultsJson }}>
  const results = JSON.parse(resultsJson);
  const screens = {
    quiz: document.querySelector('[data-screen="quiz"]'),
    result: document.querySelector('[data-screen="result"]'),
  };
  const questions = Array.from(document.querySelectorAll('.sh-question'));
  const total = questions.length;
  const progressCurrent = document.querySelector('[data-progress-current]');
  const progressFill = document.querySelector('[data-progress-fill]');
  const backBtn = document.querySelector('[data-back]');
  const resultContent = document.querySelector('[data-result-content]');

  let current = 0;
  let locked = false;
  const answers = [];

  function reflowAnim(el, cls) {
    if (!el) return;
    el.classList.remove(cls);
    void el.offsetWidth;
    el.classList.add(cls);
  }

  function showScreen(name) {
    Object.entries(screens).forEach(([key, el]) => {
      if (el) el.hidden = key !== name;
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showQuestion(index) {
    questions.forEach((q, i) => {
      q.hidden = i !== index;
      // 選択状態をリセット
      q.querySelectorAll('.sh-choice').forEach(c => c.classList.remove('is-selected'));
    });
    if (progressCurrent) progressCurrent.textContent = String(index + 1);
    if (progressFill) progressFill.style.width = (index / total * 100) + '%';
    if (backBtn) backBtn.hidden = index === 0;
    reflowAnim(questions[index], 'is-anim');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // 初期表示
  showQuestion(0);
  reflowAnim(questions[0], 'is-anim');

  // 選択肢クリック（✓表示 → 少しためて次へ）
  document.querySelectorAll('.sh-choice').forEach(btn => {
    btn.addEventListener('click', () => {
      if (locked) return;
      locked = true;
      const qi = Number(btn.getAttribute('data-qi'));
      answers[qi] = btn.getAttribute('data-type');
      btn.classList.add('is-selected');

      setTimeout(() => {
        locked = false;
        if (current < total - 1) {
          current++;
          showQuestion(current);
        } else {
          if (progressFill) progressFill.style.width = '100%';
          finish();
        }
      }, 340);
    });
  });

  // 戻る
  backBtn?.addEventListener('click', () => {
    if (locked) return;
    if (current > 0) {
      current--;
      showQuestion(current);
    }
  });

  // 判定（同点時は A > B > C の優先順位）
  function judge() {
    const score = { A: 0, B: 0, C: 0 };
    answers.forEach(t => { if (t) score[t]++; });
    const max = Math.max(score.A, score.B, score.C);
    if (score.A === max) return 'A';
    if (score.B === max) return 'B';
    return 'C';
  }

  function finish() {
    const type = judge();
    const r = results[type];
    if (resultContent) resultContent.setAttribute('data-type', type);
    document.querySelector('[data-result-emblem]').textContent = r.emblem;
    document.querySelector('[data-result-label]').textContent = r.label;
    document.querySelector('[data-result-title]').textContent = r.title;
    document.querySelector('[data-result-lead]').textContent = r.lead;
    document.querySelector('[data-result-desc]').innerHTML = r.descHtml;
    document.querySelector('[data-result-bridge]').innerHTML = r.bridgeHtml;

    showScreen('result');
    reflowAnim(resultContent, 'is-reveal');
  }

  // もう一度
  document.querySelector('[data-retry]')?.addEventListener('click', () => {
    current = 0;
    locked = false;
    answers.length = 0;
    showScreen('quiz');
    showQuestion(0);
  });
</script>

<style>
  .shindan {
    position: relative;
    min-height: 100vh;
    background: linear-gradient(180deg, #EAF1F8 0%, #F5F8FC 45%, #FDF0F0 100%);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ===== 背景の浮遊グロー ===== */
  .sh-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .sh-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
    animation: sh-float 14s ease-in-out infinite;
  }
  .sh-glow-1 {
    top: -80px; right: -60px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(0,196,154,0.5) 0%, transparent 70%);
  }
  .sh-glow-2 {
    top: 40%; left: -90px;
    width: 260px; height: 260px;
    background: radial-gradient(circle, rgba(19,62,107,0.35) 0%, transparent 70%);
    animation-delay: -5s;
  }
  .sh-glow-3 {
    bottom: -70px; right: 10%;
    width: 240px; height: 240px;
    background: radial-gradient(circle, rgba(255,107,107,0.4) 0%, transparent 70%);
    animation-delay: -9s;
  }
  @keyframes sh-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(18px, -22px) scale(1.08); }
    66% { transform: translate(-16px, 14px) scale(0.95); }
  }

  .sh-screen {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 2rem 1.15rem 3rem;
  }
  .sh-screen[hidden] { display: none; }
  .sh-inner {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  /* ===== アニメーション ===== */
  @keyframes sh-fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes sh-reveal {
    0% { opacity: 0; transform: translateY(24px) scale(0.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes sh-pop {
    0% { transform: scale(0); }
    70% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }
  .sh-question.is-anim { animation: sh-fade-up 0.42s cubic-bezier(0.22,0.61,0.36,1); }
  .sh-result-content.is-reveal { animation: sh-reveal 0.55s cubic-bezier(0.22,0.61,0.36,1); }

  /* ===== 上部バナー（設問中は常時表示） ===== */
  .sh-topbanner {
    margin: 0 0 1.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    line-height: 0;
    box-shadow: var(--shadow-md);
  }
  .sh-topbanner img { width: 100%; height: auto; display: block; }

  /* ===== プログレス ===== */
  .sh-progress { margin-bottom: 2rem; }
  .sh-progress-info {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.3rem;
    margin-bottom: 0.6rem;
  }
  .sh-progress-current {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-accent-dark);
    line-height: 1;
  }
  .sh-progress-total { font-size: 0.95rem; font-weight: 700; color: var(--color-text-muted); }
  .sh-progress-bar {
    position: relative;
    height: 9px;
    background: #DCE5EF;
    border-radius: 999px;
    overflow: hidden;
  }
  .sh-progress-fill {
    position: relative;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-accent) 100%);
    border-radius: 999px;
    transition: width 0.45s cubic-bezier(0.22,0.61,0.36,1);
    overflow: hidden;
  }
  .sh-progress-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 20%, rgba(255,255,255,0.65) 50%, transparent 80%);
    transform: translateX(-100%);
    animation: sh-shine 2s ease-in-out infinite;
  }
  @keyframes sh-shine {
    to { transform: translateX(200%); }
  }

  /* ===== 質問 ===== */
  .sh-q-num {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--color-accent-dark);
    margin: 0 0 0.5rem;
  }
  .sh-q-text {
    text-align: center;
    font-size: clamp(1.2rem, 4.8vw, 1.5rem);
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1.5;
    margin: 0 0 1.75rem;
  }
  .sh-choices { display: grid; gap: 0.85rem; }
  .sh-choice {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    padding: 1.1rem 1.15rem;
    background: rgba(255,255,255,0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 2px solid rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 6px 18px -10px rgba(19,62,107,0.35);
    transition: border-color 0.18s ease, transform 0.12s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .sh-choice:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -12px rgba(0,196,154,0.55);
    background: rgba(255,255,255,0.92);
  }
  .sh-choice:active { transform: translateY(0); }
  .sh-choice-emoji {
    flex-shrink: 0;
    width: 46px; height: 46px;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-bg-gray);
    border-radius: 50%;
    font-size: 1.4rem;
    transition: transform 0.2s ease;
  }
  .sh-choice-text {
    flex: 1;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.5;
  }
  .sh-choice-check {
    flex-shrink: 0;
    width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-accent);
    color: #fff;
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 900;
    opacity: 0;
    transform: scale(0);
    transition: opacity 0.15s ease;
  }
  /* 選択時フィードバック */
  .sh-choice.is-selected {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    box-shadow: 0 12px 26px -10px rgba(0,196,154,0.6);
  }
  .sh-choice.is-selected .sh-choice-emoji { transform: scale(1.1); }
  .sh-choice.is-selected .sh-choice-check {
    opacity: 1;
    animation: sh-pop 0.3s ease forwards;
  }
  .sh-back {
    display: block;
    margin: 1.75rem auto 0;
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.5rem;
  }
  .sh-back:hover { color: var(--color-primary); }

  /* ===== 結果（タイプ別カラーテーマ） ===== */
  .sh-result-content {
    text-align: center;
    --type-color: var(--color-cta);
    --type-color-dark: var(--color-cta-dark);
    --type-soft: rgba(255,107,107,0.1);
